local STYLES = {
	vert = { { Color3.fromRGB(168, 244, 120), Color3.fromRGB(56, 170, 62) }, { Color3.fromRGB(36, 112, 42), Color3.fromRGB(20, 68, 26) } },
	gris = { { Color3.fromRGB(214, 210, 198), Color3.fromRGB(160, 156, 144) }, { Color3.fromRGB(128, 124, 114), Color3.fromRGB(96, 92, 84) } },
	or_ = { { Color3.fromRGB(255, 232, 120), Color3.fromRGB(240, 160, 30) }, { Color3.fromRGB(170, 100, 12), Color3.fromRGB(110, 62, 6) } },
}
local function peindre(style)
	local s = STYLES[style]
	faceGrad.Color = ColorSequence.new(s[1][1], s[1][2])
	socleGrad.Color = ColorSequence.new(s[2][1], s[2][2])
end
