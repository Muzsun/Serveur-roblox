-- boutons qui grossissent un peu au survol
for _, b in { gauche, droite, boutonX, bouton } do
	local sc = if b == bouton then popBouton else nouveau("UIScale", {}, b:IsA("GuiButton") and b or b)
	if b == boutonX then
		-- boutonX a déjà l'échelle de l'écran : on grossit sa croix à la place
		sc = nil
	end
	if not sc then continue end
	b.MouseEnter:Connect(function() TweenService:Create(sc, TweenInfo.new(0.12), { Scale = 1.06 }):Play() end)
	b.MouseLeave:Connect(function() TweenService:Create(sc, TweenInfo.new(0.12), { Scale = 1 }):Play() face.Position = UDim2.fromOffset(0, 0) end)
end
