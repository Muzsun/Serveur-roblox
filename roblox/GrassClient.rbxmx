	i.Size=UDim2.fromOffset(140,140) i.ImageColor3=color or WHITE i.ImageTransparency=transp or 0 i.Parent=parent
	return i
end
local icon=Instance.new("Frame") icon.Name="Image" icon.AnchorPoint=Vector2.new(.5,0) icon.Position=UDim2.new(.5,0,0,0)
icon.Size=UDim2.fromOffset(140,140) icon.BackgroundTransparency=1 icon.Parent=root
