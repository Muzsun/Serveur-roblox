<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="LocalScript" referent="RBX0"><Properties><string name="Name">GrassClient</string><ProtectedString name="Source"><![CDATA[-- GrassClient (LocalScript dans StarterPlayerScripts)
-- ANTI-LAG : n'affiche que les touffes proches du joueur, construites petit à petit.
if not game:GetService("RunService"):IsClient() then
	warn("[Herbe] GrassClient doit être un LocalScript dans StarterPlayer > StarterPlayerScripts (pas un Script) !")
	return
end
print("[Herbe] GrassClient démarré")
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local CS=game:GetService("CollectionService")
local UIS=game:GetService("UserInputService")
local lp=Players.LocalPlayer
local CFG=require(RS:WaitForChild("GrassConfig"))
local K=require(RS:WaitForChild("GrassKit"))
local remotes=RS:WaitForChild("GrassRemotes")
local cam=workspace.CurrentCamera
local pgui=lp:WaitForChild("PlayerGui")

-- ===== plateformes =====
-- TOUCH = téléphone / tablette (pas de clavier) ; manette = PlayStation / Xbox (ou manette sur PC)
local TOUCH=UIS.TouchEnabled and not UIS.KeyboardEnabled
local PADS={[Enum.UserInputType.Gamepad1]=true,[Enum.UserInputType.Gamepad2]=true,[Enum.UserInputType.Gamepad3]=true,[Enum.UserInputType.Gamepad4]=true}
local function usingGamepad() return PADS[UIS:GetLastInputType()]==true end
local function screenCenter() local v=cam.ViewportSize return Vector2.new(v.X/2,v.Y/2) end
local BB=TOUCH and .7 or 1 -- taille des bulles dans le monde (plus petites sur téléphone)
local function safeInsets(g) pcall(function() g.ScreenInsets=Enum.ScreenInsets.CoreUISafeInsets end) end

local BAG_IMAGE="rbxassetid://124953051791395"
local RENDER=CFG.RENDER_DIST or 120
local WHITE,RED=Color3.new(1,1,1),Color3.fromRGB(255,90,75)
local GREEN,GOLD=Color3.fromRGB(150,245,90),Color3.fromRGB(255,215,70)
local RARITY_TEXT={Or="✨ HERBE EN OR !",Diamant="💎 HERBE DIAMANT !",ArcEnCiel="🌈 HERBE ARC-EN-CIEL !"}
local fx=Instance.new("Folder") fx.Name="GrassFX" fx.Parent=workspace
local vis=Instance.new("Folder") vis.Name="GrassVisuals" vis.Parent=workspace
local hitF=Instance.new("Folder") hitF.Name="GrassHit" hitF.Parent=workspace

-- ===== outils =====
local function tween(d,f)
	local t0=os.clock()
	while true do
		local a=math.min((os.clock()-t0)/d,1)
		f(a)
		if a>=1 then return end
		Run.RenderStepped:Wait()
	end
end
local function outQuad(a) return 1-(1-a)^2 end
local function bez(a,b,c,t) return (1-t)^2*a+2*(1-t)*t*b+t*t*c end
local function stroke(o,th,col,border)
	local s=Instance.new("UIStroke") s.Thickness=th s.Color=col
	if border then s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border end
	s.Parent=o return s
end
local function corner(o,r) local c=Instance.new("UICorner") c.CornerRadius=r or UDim.new(1,0) c.Parent=o end
local function fxPart(cls,shape)
	local p=Instance.new(cls) if shape then p.Shape=shape end
	p.Material=Enum.Material.SmoothPlastic p.Anchored=true
	p.CanCollide=false p.CanQuery=false p.CanTouch=false p.CastShadow=false
	return p
end
local function sound(id,pos,vol)
	if not id or id=="" then return end
	local at=Instance.new("Attachment") at.Parent=workspace.Terrain at.WorldPosition=pos
	local s=Instance.new("Sound") s.SoundId=id s.Volume=vol or .6 s.Parent=at
	s:Play() game:GetService("Debris"):AddItem(at,4)
end
local function fmt(g) if g==math.floor(g) then return tostring(g) end return string.format("%.2f",g) end

-- ===== interface du sac (en bas à gauche, sans animation) =====
local gui=Instance.new("ScreenGui") gui.Name="GrassBagGui" gui.ResetOnSpawn=false safeInsets(gui)
gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling gui.Parent=pgui

local root=Instance.new("Frame") root.Name="Sac" root.AnchorPoint=Vector2.new(0,1)
root.Position=UDim2.new(0,16,1,-16)
root.Size=UDim2.fromOffset(150,172) root.BackgroundTransparency=1 root.Parent=gui
local uiScale=Instance.new("UIScale") uiScale.Parent=root
-- plus petit, et encore réduit sur téléphone / tablette
local function rescale()
	local s=math.clamp(cam.ViewportSize.Y/950,.4,1)
	if TOUCH then s=math.max(s*.8,.45) end
	uiScale.Scale=s
end
rescale() cam:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

local function bagImage(parent,color,transp)
	local i=Instance.new("ImageLabel") i.BackgroundTransparency=1 i.Image=BAG_IMAGE i.ScaleType=Enum.ScaleType.Fit
	i.Size=UDim2.fromOffset(140,140) i.ImageColor3=color or WHITE i.ImageTransparency=transp or 0 i.Parent=parent
	return i
end
local icon=Instance.new("Frame") icon.Name="Image" icon.AnchorPoint=Vector2.new(.5,0) icon.Position=UDim2.new(.5,0,0,0)
icon.Size=UDim2.fromOffset(140,140) icon.BackgroundTransparency=1 icon.Parent=root
local shadow=bagImage(icon,Color3.new(0,0,0),.6) shadow.Position=UDim2.fromOffset(4,6)
bagImage(icon,Color3.fromRGB(110,110,110),0)
local clip=Instance.new("Frame") clip.AnchorPoint=Vector2.new(0,1) clip.Position=UDim2.fromScale(0,1)
clip.Size=UDim2.fromScale(1,0) clip.BackgroundTransparency=1 clip.ClipsDescendants=true clip.Parent=icon
local full=bagImage(clip) full.AnchorPoint=Vector2.new(0,1) full.Position=UDim2.fromScale(0,1)

local count=Instance.new("TextLabel") count.Name="Compteur" count.AnchorPoint=Vector2.new(.5,.5) count.Position=UDim2.new(.5,0,0,92)
count.Size=UDim2.fromOffset(120,44) count.BackgroundTransparency=1 count.Font=Enum.Font.FredokaOne count.TextScaled=true
count.TextColor3=WHITE count.Text="0/"..CFG.BAG_CAPACITY count.ZIndex=3 count.Parent=root
local cs=stroke(count,4,Color3.fromRGB(15,15,15)) cs.LineJoinMode=Enum.LineJoinMode.Round

local toast=Instance.new("TextLabel") toast.AnchorPoint=Vector2.new(.5,1) toast.Position=UDim2.new(.5,0,1,-150)
toast.Size=UDim2.fromOffset(520,46) toast.BackgroundColor3=Color3.fromRGB(44,22,18) toast.BackgroundTransparency=.1
toast.Font=Enum.Font.FredokaOne toast.TextScaled=true toast.TextColor3=WHITE toast.Visible=false toast.Parent=gui
corner(toast,UDim.new(0,14)) stroke(toast,2.5,RED,true)
local pad=Instance.new("UIPadding") pad.PaddingLeft=UDim.new(0,16) pad.PaddingRight=UDim.new(0,16)
pad.PaddingTop=UDim.new(0,7) pad.PaddingBottom=UDim.new(0,7) pad.Parent=toast
local toastId=0
local function showToast(text)
	toastId+=1 local id=toastId
	toast.Text=text toast.Visible=true
	task.delay(2,function() if toastId==id then toast.Visible=false end end)
end

-- ===== texte de mutation (or / diamant / arc-en-ciel) =====
local STY={
	Or={a=Color3.fromRGB(255,248,170),b=Color3.fromRGB(255,165,30),st=Color3.fromRGB(95,50,0)},
	Diamant={a=Color3.fromRGB(240,255,255),b=Color3.fromRGB(80,190,255),st=Color3.fromRGB(10,45,95)},
	ArcEnCiel={st=Color3.fromRGB(45,20,70)},
}
local RAINBOW=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(255,90,90)),ColorSequenceKeypoint.new(.2,Color3.fromRGB(255,190,60)),
	ColorSequenceKeypoint.new(.4,Color3.fromRGB(250,250,90)),ColorSequenceKeypoint.new(.6,Color3.fromRGB(90,240,120)),
	ColorSequenceKeypoint.new(.8,Color3.fromRGB(90,170,255)),ColorSequenceKeypoint.new(1,Color3.fromRGB(210,110,255))})
local banner=Instance.new("Frame") banner.AnchorPoint=Vector2.new(.5,.5) banner.Position=UDim2.new(.5,0,0,120)
banner.Size=UDim2.fromOffset(620,110) banner.BackgroundTransparency=1 banner.Visible=false banner.Parent=gui
local bScale=Instance.new("UIScale") bScale.Parent=banner
local bTitle=Instance.new("TextLabel") bTitle.BackgroundTransparency=1 bTitle.Size=UDim2.fromScale(1,.66)
bTitle.Font=Enum.Font.FredokaOne bTitle.TextScaled=true bTitle.TextColor3=WHITE bTitle.Parent=banner
local bStroke=stroke(bTitle,5,Color3.new(0,0,0)) bStroke.LineJoinMode=Enum.LineJoinMode.Round
local bGrad=Instance.new("UIGradient") bGrad.Rotation=90 bGrad.Parent=bTitle
local bSub=Instance.new("TextLabel") bSub.BackgroundTransparency=1 bSub.Position=UDim2.fromScale(0,.64) bSub.Size=UDim2.fromScale(1,.34)
bSub.Font=Enum.Font.FredokaOne bSub.TextScaled=true bSub.TextColor3=WHITE bSub.Parent=banner
local sStroke=stroke(bSub,3.5,Color3.new(0,0,0)) sStroke.LineJoinMode=Enum.LineJoinMode.Round
local fitScale=1
local function fit() fitScale=math.clamp(cam.ViewportSize.X/1400,.4,1) end
fit() cam:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
do local sc=Instance.new("UIScale") sc.Parent=toast
	local function f2() sc.Scale=math.clamp(cam.ViewportSize.X/1400,.4,1) end f2() cam:GetPropertyChangedSignal("ViewportSize"):Connect(f2) end
local bannerId=0
local function showBanner(rarity,size)
	bannerId+=1 local id=bannerId
	local s=STY[rarity] or STY.Or
	bTitle.Text=RARITY_TEXT[rarity] or rarity
	bSub.Text="+"..size.." 🎒"
	bStroke.Color=s.st sStroke.Color=s.st
	bGrad.Rotation=rarity=="ArcEnCiel" and 0 or 90
	bGrad.Color=rarity=="ArcEnCiel" and RAINBOW or ColorSequence.new(s.a,s.b)
	for _,o in {bTitle,bSub} do o.TextTransparency=0 end bStroke.Transparency=0 sStroke.Transparency=0
	banner.Visible=true
	task.spawn(function()
		-- apparition "pop"
		tween(.28,function(a)
			if bannerId~=id then return end
			local e=a<.6 and (a/.6)*1.18 or 1.18-.18*((a-.6)/.4)
			bScale.Scale=fitScale*e
		end)
		-- l'arc-en-ciel défile, les autres brillent un peu
		local t0=os.clock()
		while bannerId==id and os.clock()-t0<1.5 do
			if rarity=="ArcEnCiel" then bGrad.Offset=Vector2.new(math.sin((os.clock()-t0)*3)*.3,0)
			else bScale.Scale=fitScale*(1+math.sin((os.clock()-t0)*6)*.02) end
			Run.RenderStepped:Wait()
		end
		-- disparition en fondu
		tween(.3,function(a)
			if bannerId~=id then return end
			bTitle.TextTransparency=a bSub.TextTransparency=a bStroke.Transparency=a sStroke.Transparency=a
			bScale.Scale=fitScale*(1-.15*a)
		end)
		if bannerId==id then banner.Visible=false end
	end)
end

local shown,pendingPicks,depositing=0,0,false
local function maxBag() return lp:GetAttribute("BagMax") or CFG.BAG_CAPACITY end
local function realBag() return lp:GetAttribute("Bag") or 0 end
local function refresh()
	local m=maxBag()
	shown=math.clamp(shown,0,m)
	count.Text=shown.."/"..m
	clip.Size=UDim2.fromScale(1,m>0 and shown/m or 0)
	count.TextColor3=shown>=m and RED or WHITE
end
local function sync() if pendingPicks==0 and not depositing then shown=realBag() refresh() end end
lp:GetAttributeChangedSignal("Bag"):Connect(sync)
lp:GetAttributeChangedSignal("BagMax"):Connect(refresh)
shown=realBag() refresh()

-- ===== argent (en bas à droite) =====
local COIN="rbxassetid://103593634628600"
-- (placé juste au-dessus du sac, en bas à gauche)
local mRoot=Instance.new("Frame") mRoot.Name="Argent" mRoot.AnchorPoint=Vector2.new(0,1)
mRoot.Size=UDim2.fromOffset(230,70) mRoot.BackgroundTransparency=1 mRoot.Parent=gui
local mScale=Instance.new("UIScale") mScale.Parent=mRoot
local function mFit()
	local s=math.clamp(cam.ViewportSize.Y/950,.45,1) if TOUCH then s=math.clamp(s,.45,.6) end mScale.Scale=s
	if TOUCH then
		-- téléphone / tablette : en haut à gauche (le joystick est en bas à gauche)
		mRoot.AnchorPoint=Vector2.new(0,0) mRoot.Position=UDim2.fromOffset(10,6)
		root.AnchorPoint=Vector2.new(0,0) root.Position=UDim2.fromOffset(10,6+70*s+2)
	else
		root.AnchorPoint=Vector2.new(0,1) root.Position=UDim2.new(0,16,1,-16)
		mRoot.AnchorPoint=Vector2.new(0,1) mRoot.Position=UDim2.new(0,16,1,-(16+172*uiScale.Scale+4))
	end
end
mFit() cam:GetPropertyChangedSignal("ViewportSize"):Connect(mFit) uiScale:GetPropertyChangedSignal("Scale"):Connect(mFit)
local mIcon=Instance.new("ImageLabel") mIcon.BackgroundTransparency=1 mIcon.Image=COIN mIcon.ScaleType=Enum.ScaleType.Fit
mIcon.AnchorPoint=Vector2.new(0,.5) mIcon.Position=UDim2.fromScale(0,.5) mIcon.Size=UDim2.fromOffset(70,70) mIcon.ZIndex=3 mIcon.Parent=mRoot
local mPop=Instance.new("UIScale") mPop.Parent=mIcon
local mText=Instance.new("TextLabel") mText.BackgroundTransparency=1 mText.AnchorPoint=Vector2.new(0,.5)
mText.Position=UDim2.new(0,76,.5,0) mText.Size=UDim2.fromOffset(160,54) mText.Font=Enum.Font.LuckiestGuy
mText.TextScaled=true mText.TextXAlignment=Enum.TextXAlignment.Left mText.Text="$0.00" mText.TextColor3=WHITE mText.ZIndex=3 mText.Parent=mRoot
local mst=stroke(mText,4,Color3.fromRGB(26,22,28)) mst.LineJoinMode=Enum.LineJoinMode.Round
local mg=Instance.new("UIGradient") mg.Rotation=90 mg.Color=ColorSequence.new(WHITE,Color3.fromRGB(255,228,140)) mg.Parent=mText
local mTextPop=Instance.new("UIScale") mTextPop.Parent=mText
task.spawn(function()
	local ls=lp:WaitForChild("leaderstats",20) if not ls then return end
	local mv
	for _=1,40 do
		if CFG.MONEY_STAT and CFG.MONEY_STAT~="" then mv=ls:FindFirstChild(CFG.MONEY_STAT) end
		if not mv then for _,n in {"Money","Cash","Argent","Coins","Dollars","$"} do mv=ls:FindFirstChild(n) if mv then break end end end
		if mv then break end task.wait(.25)
	end
	if not mv then return end
	local last=tonumber(mv.Value) or 0
	mText.Text=string.format("$%.2f",last)
	mv.Changed:Connect(function()
		local v=tonumber(mv.Value) or 0
		mText.Text=string.format("$%.2f",v)
		if v>last then
			mPop.Scale=1.35 game:GetService("TweenService"):Create(mPop,TweenInfo.new(.35,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Scale=1}):Play()
			mTextPop.Scale=1.2 game:GetService("TweenService"):Create(mTextPop,TweenInfo.new(.3,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Scale=1}):Play()
		end
		last=v
	end)
end)

-- ===== touffes affichées seulement près du joueur =====
local data={}      -- toutes les touffes de la partie (juste des infos)
local visible={}   -- [id] = {bl=modèle, hb=zone de clic, cf=position}
local queued={}
local queue={}
local gone={}      -- touffes déjà ramassées avant d'avoir reçu la liste
local rainbow={}

local function spawnVisual(e)
	local cf=CFrame.new(e.p)*CFrame.Angles(0,e.yaw,0)
	local bl=K.Build(cf,e.s,e.seed,true,e.r)
	bl.Name="Touffe" bl.Parent=vis
	local _,sz=bl:GetBoundingBox()
	local hb=Instance.new("Part") hb.Name="Hit" hb.Size=Vector3.new(sz.X+.4,math.max(sz.Y,1),sz.Z+.4)
	hb.CFrame=cf*CFrame.new(0,hb.Size.Y/2,0) hb.Transparency=1 hb.Anchored=true
	hb.CanCollide=false hb.CanTouch=false hb.CanQuery=true hb.CastShadow=false
	hb:SetAttribute("Id",e.id) hb.Parent=hitF
	local st=K.STYLE[e.r]
	if st and st.spark then
		local pe=Instance.new("ParticleEmitter")
		pe.Color=ColorSequence.new(st.spark)
		pe.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(.2,.35*e.s),NumberSequenceKeypoint.new(1,0)})
		pe.Lifetime=NumberRange.new(.8,1.2) pe.Rate=st.rate pe.Speed=NumberRange.new(.3,1)
		pe.SpreadAngle=Vector2.new(180,180) pe.LightEmission=1 pe.LightInfluence=0 pe.Parent=hb
	end
	if e.r=="ArcEnCiel" then rainbow[bl]=bl end
	visible[e.id]={bl=bl,hb=hb,cf=cf}
end
local function despawnVisual(id)
	local v=visible[id]
	if v then v.bl:Destroy() v.hb:Destroy() visible[id]=nil end
end

-- récupère la liste des touffes au démarrage
task.spawn(function()
	local list=remotes:WaitForChild("GetGrass"):InvokeServer()
	for _,a in list do
		local id=a[1]
		if not gone[id] then
			data[id]={id=id,p=Vector3.new(a[2],a[3],a[4]),yaw=a[5],s=a[6],r=a[7],seed=a[8],size=a[9]}
		end
	end
end)

-- une zone est terminée : l'herbe pousse dans la suivante
task.spawn(function()
	local newGrass=remotes:WaitForChild("NewGrass",60)
	if not newGrass then return end
	newGrass.OnClientEvent:Connect(function(list)
		for _,a in list do
			local id=a[1]
			if not gone[id] then
				data[id]={id=id,p=Vector3.new(a[2],a[3],a[4]),yaw=a[5],s=a[6],r=a[7],seed=a[8],size=a[9]}
			end
		end
		showToast("🌱 Zone terminée ! L'herbe a poussé dans la zone suivante")
	end)
end)

-- TEST (seulement dans Studio) : touche K = finir la zone en cours d'un coup
if Run:IsStudio() then
	UIS.InputBegan:Connect(function(input,gp)
		if gp or input.KeyCode~=Enum.KeyCode.K then return end
		local r=remotes:FindFirstChild("TestFinirZone")
		if r then r:FireServer() showToast("🧪 TEST : zone terminée !") end
	end)
end

-- toutes les 0.3 s : on affiche ce qui est proche, on retire ce qui est loin
task.spawn(function()
	while true do
		local ch=lp.Character
		local hrp=ch and ch:FindFirstChild("HumanoidRootPart")
		local c=hrp and hrp.Position or cam.CFrame.Position
		for id,e in data do
			local d=(e.p-c).Magnitude
			if d<RENDER then
				if not visible[id] and not queued[id] then queued[id]=true table.insert(queue,id) end
			elseif d>RENDER+20 and visible[id] then
				despawnVisual(id)
			end
		end
		task.wait(.3)
	end
end)
-- on construit max 8 touffes par image (pas de freeze)
Run.Heartbeat:Connect(function()
	local n=0
	while #queue>0 and n<8 do
		local id=table.remove(queue)
		queued[id]=nil
		local e=data[id]
		if e and not visible[id] then spawnVisual(e) n+=1 end
	end
end)

-- couleurs arc-en-ciel qui défilent
local acc=0
Run.Heartbeat:Connect(function(dt)
	acc+=dt if acc<1/20 then return end acc=0
	local tt=os.clock()*.25
	for key,bl in rainbow do
		if not key.Parent then rainbow[key]=nil else
			for _,p in bl:GetChildren() do
				local h=p:GetAttribute("Hue")
				if h then p.Color=K.RainbowColor((h+tt)%1,p:GetAttribute("Tone")) end
			end
		end
	end
end)

-- ===== survol + clic (sans ClickDetector) =====
local hl=Instance.new("Highlight")
hl.FillColor=WHITE hl.OutlineColor=WHITE hl.FillTransparency=.88 hl.OutlineTransparency=0
hl.DepthMode=Enum.HighlightDepthMode.Occluded hl.Enabled=false hl.Parent=fx
local hovered
local rp=RaycastParams.new() rp.FilterType=Enum.RaycastFilterType.Exclude
local function idFromRay(ray)
	local ex={fx,vis}
	if lp.Character then table.insert(ex,lp.Character) end
	rp.FilterDescendantsInstances=ex
	local hit=workspace:Raycast(ray.Origin,ray.Direction*250,rp)
	if hit and hit.Instance.Parent==hitF then return hit.Instance:GetAttribute("Id") end
end
-- on ne coupe l'herbe qu'avec les ciseaux en main (et pas pendant que le menu des améliorations est ouvert)
local function holdingScissors()
	if lp:GetAttribute("MenuOuvert") then return false end
	local ch=lp.Character
	local tool=ch and ch:FindFirstChildOfClass("Tool")
	return tool~=nil and (CS:HasTag(tool,"OutilCiseaux") or CS:HasTag(tool,"OutilFaucille") or tool.Name=="Ciseaux" or tool:GetAttribute("CoupeEnPlus")~=nil)
end
-- chaque outil a ses améliorations : ciseaux (Maintenir, Dextérité, Saisir) / faucille (FMaintenir, FRapidite, FCoupe)
local function holdingRealScissors()
	local ch=lp.Character
	local tool=ch and ch:FindFirstChildOfClass("Tool")
	return tool~=nil and (CS:HasTag(tool,"OutilCiseaux") or tool.Name=="Ciseaux")
end
local function holdingSickle()
	local ch=lp.Character
	local tool=ch and ch:FindFirstChildOfClass("Tool")
	return tool~=nil and (CS:HasTag(tool,"OutilFaucille") or tool.Name=="Faucille")
end
local function speedLevel()
	if holdingRealScissors() then return lp:GetAttribute("Upg_Dexterite") or 0 end
	if holdingSickle() then return lp:GetAttribute("Upg_FRapidite") or 0 end
	return 0
end
local function canHold()
	if holdingRealScissors() then return (lp:GetAttribute("Upg_Maintenir") or 0)>=1 end
	if holdingSickle() then return (lp:GetAttribute("Upg_FMaintenir") or 0)>=1 end
	return false
end
local function setHover(id)
	hovered=id
	local v=id and visible[id]
	local e=id and data[id]
	if not (v and e) then hl.Enabled=false hl.Adornee=nil return end
	local col=(realBag()+e.size>maxBag()) and RED or (K.OUTLINE[e.r] or WHITE)
	hl.OutlineColor=col hl.FillColor=col hl.Adornee=v.bl hl.Enabled=true
end
-- ===== curseur en forme de ciseaux (quand on les tient) =====
local curGui=Instance.new("ScreenGui") curGui.Name="CurseurCiseaux" curGui.ResetOnSpawn=false
curGui.IgnoreGuiInset=true curGui.DisplayOrder=100 curGui.Parent=pgui
local cursor=Instance.new("Frame") cursor.Name="Ciseaux" cursor.AnchorPoint=Vector2.new(.5,.5)
cursor.Size=UDim2.fromOffset(44,44) cursor.BackgroundTransparency=1 cursor.Visible=false cursor.Parent=curGui
local TAILLE_CURSEUR=0.7  -- taille du curseur ciseaux (0.8 = plus petit, 1.2 = plus grand)
local cScale=Instance.new("UIScale") cScale.Scale=TAILLE_CURSEUR cScale.Parent=cursor
local OPEN=27           -- ouverture des lames (degrés)
local branches,tinted={},{}
local snipT=-math.huge
local function drawScissors(col,offset,transp)
	local layer=Instance.new("Frame") layer.BackgroundTransparency=1 layer.Size=UDim2.fromScale(1,1)
	layer.Position=UDim2.fromOffset(offset,offset) layer.Parent=cursor
	for _,s in {1,-1} do
		-- une branche = une lame en haut + un anneau en bas, qui tourne autour de la vis
		local h=Instance.new("Frame") h.BackgroundTransparency=1 h.AnchorPoint=Vector2.new(.5,.5)
		h.Position=UDim2.fromScale(.5,.5) h.Size=UDim2.fromOffset(16,50) h.Rotation=s*OPEN h.Parent=layer
		local blade=Instance.new("Frame") blade.BorderSizePixel=0 blade.BackgroundColor3=col blade.BackgroundTransparency=transp
		blade.AnchorPoint=Vector2.new(.5,1) blade.Position=UDim2.new(.5,0,.5,0) blade.Size=UDim2.fromOffset(5,22) blade.Parent=h
		corner(blade)
		local shank=Instance.new("Frame") shank.BorderSizePixel=0 shank.BackgroundColor3=col shank.BackgroundTransparency=transp
		shank.AnchorPoint=Vector2.new(.5,0) shank.Position=UDim2.new(.5,0,.5,-1) shank.Size=UDim2.fromOffset(3,12) shank.Parent=h
		local ring=Instance.new("Frame") ring.BackgroundTransparency=1 ring.AnchorPoint=Vector2.new(.5,1)
		ring.Position=UDim2.fromScale(.5,1) ring.Size=UDim2.fromOffset(12,12) ring.Parent=h
		corner(ring)
		local rs=stroke(ring,3,col) rs.Transparency=transp
		table.insert(branches,{h=h,s=s})
		if offset==0 then table.insert(tinted,blade) table.insert(tinted,shank) table.insert(tinted,rs) end
	end
end
drawScissors(Color3.new(0,0,0),2,.55) -- ombre douce
drawScissors(WHITE,0,0)
local cursorShown,savedMouseIcon=false,true
local function updateCursor(m,pad)
	-- visible seulement quand on vise de l'herbe (et un court instant après la coupe pour le clic-clac)
	local e=hovered and visible[hovered] and data[hovered]
	local show=(UIS.MouseEnabled or pad) and holdingScissors() and (e~=nil or os.clock()-snipT<.2)
	if show~=cursorShown then
		cursorShown=show cursor.Visible=show
		if show then savedMouseIcon=UIS.MouseIconEnabled UIS.MouseIconEnabled=false
		else UIS.MouseIconEnabled=savedMouseIcon end
	end
	if not show then return end
	cursor.Position=UDim2.fromOffset(m.X,m.Y)
	-- toujours blanc (rouge seulement si le sac est trop plein pour cette touffe)
	local col=(e and realBag()+e.size>maxBag()) and RED or WHITE
	for _,o in tinted do if o:IsA("UIStroke") then o.Color=col else o.BackgroundColor3=col end end
	-- clic-clac des lames
	local t=(os.clock()-snipT)/.16
	local ang=(t>=0 and t<1) and OPEN*(1-.85*math.sin(t*math.pi)) or OPEN
	for _,b in branches do b.h.Rotation=b.s*ang end
end
Run.RenderStepped:Connect(function()
	-- manette : on vise au centre de l'écran ; souris : là où est la souris
	local pad=usingGamepad()
	local m=pad and screenCenter() or UIS:GetMouseLocation()
	if UIS.MouseEnabled or pad then
		local id=holdingScissors() and idFromRay(cam:ViewportPointToRay(m.X,m.Y)) or nil
		if id~=hovered then setHover(id) end
	elseif hovered then setHover(nil) end
	updateCursor(m,pad)
end)
-- clic avec les ciseaux = coupe l'herbe visée ; amélioration "Maintenir" = rester appuyé coupe en continu là où tu vises
local holding,holdInput=false,nil
local lastHint=0
local requestCut -- (défini plus bas) : demande la coupe + coupe tout de suite chez nous quand les lames se ferment
local lastCut=-math.huge
UIS.InputBegan:Connect(function(input,gp)
	local t=input.UserInputType
	local pad=input.KeyCode==Enum.KeyCode.ButtonR2 -- gâchette droite (PlayStation R2 / Xbox RT)
	if (gp and not pad) or UIS:GetFocusedTextBox() or lp:GetAttribute("MenuOuvert") then return end
	if t==Enum.UserInputType.MouseButton1 or t==Enum.UserInputType.Touch or pad then
		holding=true holdInput=input
		local ray
		if pad then local c=screenCenter() ray=cam:ViewportPointToRay(c.X,c.Y)
		else ray=cam:ScreenPointToRay(input.Position.X,input.Position.Y) end
		local id=idFromRay(ray)
		if id then
			if holdingScissors() then
				-- pas de spam : on ne peut recouper qu'une fois le délai passé (même délai que le serveur)
				local dex=speedLevel()
				local cd=math.max(.2,(CFG.PICK_COOLDOWN or .9)*(1-(CFG.DEX_PAR_NIVEAU or .08)*dex))
				if os.clock()-lastCut>=cd then lastCut=os.clock() snipT=os.clock() requestCut(id) end
			elseif os.clock()-lastHint>2 then lastHint=os.clock() showToast("✂️ Prends tes ciseaux pour couper l'herbe !") end
		end
	end
end)
UIS.InputEnded:Connect(function(input)
	if input==holdInput or input.UserInputType==Enum.UserInputType.MouseButton1 or input.KeyCode==Enum.KeyCode.ButtonR2 then holding=false holdInput=nil end
end)
task.spawn(function()
	while true do
		local dex=speedLevel()
		local cd=math.max(.2,(CFG.PICK_COOLDOWN or .9)*(1-(CFG.DEX_PAR_NIVEAU or .08)*dex))
		task.wait(cd+.05)
		if holding and canHold() and holdingScissors() then
			local hi,ray=holdInput,nil
			if hi and hi.KeyCode==Enum.KeyCode.ButtonR2 then local c=screenCenter() ray=cam:ViewportPointToRay(c.X,c.Y)
			elseif hi and hi.UserInputType==Enum.UserInputType.Touch then ray=cam:ScreenPointToRay(hi.Position.X,hi.Position.Y)
			else local m=UIS:GetMouseLocation() ray=cam:ViewportPointToRay(m.X,m.Y) end
			local id=idFromRay(ray)
			if id then lastCut=os.clock() requestCut(id) end
		end
	end
end)

-- ===== effets dans le monde =====
local DIRT={Color3.fromRGB(104,74,46),Color3.fromRGB(86,60,36),Color3.fromRGB(122,90,58)}
local function burst(pos,nDirt,nGrass,power,col)
	local bits={}
	for i=1,nDirt+nGrass do
		local g=i>nDirt
		local p=fxPart(g and "WedgePart" or "Part")
		local sz=math.random(10,20)/100
		p.Size=g and Vector3.new(.05,.35,.14) or Vector3.new(sz,sz,sz)
		if g then
			if col=="rainbow" then p.Color=Color3.fromHSV(math.random(),.7,1)
			elseif col then p.Color=col
			else p.Color=Color3.fromRGB(110+math.random(0,40),185+math.random(0,40),45) end
		else p.Color=DIRT[math.random(1,3)] end
		p.CFrame=CFrame.new(pos) p.Parent=fx
		local a=math.random()*math.pi*2
		local s=math.random(20,60)/10*power
		bits[i]={p=p,v=Vector3.new(math.cos(a)*s,math.random(60,110)/10*power,math.sin(a)*s),
			r=Vector3.new(math.random(-15,15),math.random(-15,15),math.random(-15,15)),s=p.Size}
	end
	task.spawn(function()
		tween(.65,function(a)
			local t=a*.65
			for _,b in bits do
				b.p.CFrame=CFrame.new(pos+b.v*t+Vector3.new(0,-26*t*t,0))*CFrame.Angles(b.r.X*t,b.r.Y*t,b.r.Z*t)
				if a>.55 then b.p.Size=b.s*math.max(1-(a-.55)/.45,.01) end
			end
		end)
		for _,b in bits do b.p:Destroy() end
	end)
end

local function puffs(pos)
	for i=1,6 do
		local a=i/6*math.pi*2+math.random()*.5
		local p=fxPart("Part",Enum.PartType.Ball)
		p.Size=Vector3.new(.4,.4,.4) p.Color=Color3.fromRGB(196,170,130) p.Transparency=.3
		p.CFrame=CFrame.new(pos) p.Parent=fx
		local dir=Vector3.new(math.cos(a),.35,math.sin(a))
		task.spawn(function()
			tween(.55,function(t)
				local e=outQuad(t)
				p.CFrame=CFrame.new(pos+dir*1.4*e+Vector3.new(0,.2,0))
				local s=.4+1.1*e p.Size=Vector3.new(s,s,s) p.Transparency=.3+.7*t
			end)
			p:Destroy()
		end)
	end
end

local function popupAt(pos,text,color)
	local at=Instance.new("Attachment") at.Parent=workspace.Terrain at.WorldPosition=pos
	local g=Instance.new("BillboardGui") g.Adornee=at g.Size=UDim2.fromOffset(180*BB,90*BB) g.AlwaysOnTop=true g.LightInfluence=0 g.ResetOnSpawn=false
	local t=Instance.new("TextLabel") t.Size=UDim2.fromScale(1,1) t.BackgroundTransparency=1
	t.Text=text t.Font=Enum.Font.FredokaOne t.TextScaled=true t.TextColor3=color t.Parent=g
	local st=stroke(t,3,Color3.fromRGB(20,40,12))
	g.Parent=pgui
	task.spawn(function()
		tween(1,function(a)
			g.StudsOffset=Vector3.new(0,a*2.4,0)
			local f=math.clamp((a-.55)/.45,0,1) t.TextTransparency=f st.Transparency=f
		end)
		g:Destroy() at:Destroy()
	end)
end

-- ===== bras du joueur (lancer dans le composteur) =====
local armOrig=setmetatable({},{__mode="k"})
local armId=0
local function armAnim(steps)
	local ch=lp.Character if not ch then return end
	local m,r15
	local ua=ch:FindFirstChild("RightUpperArm")
	if ua and ua:FindFirstChild("RightShoulder") then m=ua.RightShoulder r15=true
	elseif ch:FindFirstChild("Torso") and ch.Torso:FindFirstChild("Right Shoulder") then m=ch.Torso["Right Shoulder"] end
	if not m or not m:IsA("Motor6D") then return end
	armOrig[m]=armOrig[m] or m.C0
	local c0=armOrig[m]
	armId+=1 local id=armId
	local cur=0
	local function set(x)
		if armId~=id then return end
		cur=x
		pcall(function() m.C0=c0*(r15 and CFrame.Angles(x,0,0) or CFrame.Angles(0,0,x)) end)
	end
	for _,s in steps do
		local from=cur
		tween(s[1],function(a) set(from+(s[2]-from)*outQuad(a)) end)
	end
	if armId==id then pcall(function() m.C0=c0 end) end
end

-- ===== coupe aux ciseaux : effets =====
local SNIP_SOUND="rbxassetid://135446324303740" -- son de l'herbe coupée (remplacé par PICK_SOUND si tu en mets un)
local function snipSound(pos)
	local id=(CFG.PICK_SOUND and CFG.PICK_SOUND~="") and CFG.PICK_SOUND or SNIP_SOUND
	local at=Instance.new("Attachment") at.Parent=workspace.Terrain at.WorldPosition=pos
	local s=Instance.new("Sound") s.SoundId=id s.Volume=.6 s.PlaybackSpeed=.95+math.random()*.1 s.RollOffMaxDistance=60 s.Parent=at
	s:Play() game:GetService("Debris"):AddItem(at,3)
end
local function leafColor(m)
	for _,p in m:GetDescendants() do if p:IsA("BasePart") then return p.Color end end
	return Color3.fromRGB(110,190,50)
end
-- deux lames blanches qui se referment sur la touffe
local function slash(center,w)
	local right=Vector3.new(cam.CFrame.RightVector.X,0,cam.CFrame.RightVector.Z)
	if right.Magnitude<.01 then right=Vector3.new(1,0,0) end
	right=right.Unit
	local len=math.max(w,.8)*1.25
	local pivot=center-right*len/2
	local look=CFrame.lookAt(pivot,pivot+right)
	local blades={}
	for s=-1,1,2 do
		local b=fxPart("Part") b.Material=Enum.Material.Neon b.Color=Color3.new(1,1,1) b.Transparency=.05
		b.Size=Vector3.new(.06,.06,len) b.Parent=fx
		table.insert(blades,{p=b,s=s})
	end
	task.spawn(function()
		tween(.08,function(a)
			for _,bd in blades do
				bd.p.CFrame=look*CFrame.Angles(bd.s*math.rad(30)*(1-outQuad(a)),0,0)*CFrame.new(0,0,-len/2)
			end
		end)
		tween(.2,function(a)
			for _,bd in blades do
				local t=.06*(1-a)+.01
				bd.p.Size=Vector3.new(t,t,len*(1+.15*a)) bd.p.Transparency=.05+.95*a
				bd.p.CFrame=look*CFrame.new(0,0,-len/2)
			end
		end)
		for _,bd in blades do bd.p:Destroy() end
	end)
end
-- petit chaume coupé qui reste au sol quelques secondes
local function stubble(cf,w,h,col)
	local m=Instance.new("Model") m.Name="Chaume"
	local parts={}
	for i=1,7 do
		local a=i/7*math.pi*2+math.random()*.6
		local r=math.random()*math.max(w,.4)*.3
		local hh=h*(.75+math.random()*.25)
		local stem=fxPart("Part") stem.Size=Vector3.new(.08,hh,.08) stem.Color=col:Lerp(Color3.new(0,0,0),.15)
		stem.CFrame=cf*CFrame.new(math.cos(a)*r,hh/2,math.sin(a)*r)*CFrame.Angles(math.random()*.24-.12,math.random()*6.28,math.random()*.24-.12)
		stem.Parent=m
		local tip=fxPart("Part") tip.Size=Vector3.new(.085,.02,.085) tip.Color=col:Lerp(Color3.fromRGB(255,255,210),.5) -- tranche nette
		tip.CFrame=stem.CFrame*CFrame.new(0,hh/2,0) tip.Parent=m
		table.insert(parts,stem) table.insert(parts,tip)
	end
	m.Parent=fx
	task.delay(4,function()
		local p0=m:GetPivot()
		tween(.6,function(a)
			m:PivotTo(p0*CFrame.new(0,-h*a,0))
			for _,p in parts do p.Transparency=a end
		end)
		m:Destroy()
	end)
end

-- "+1" / "+5"... en blanc qui vient vers le joueur
local function gainPopup(pos,n)
	local at=Instance.new("Attachment") at.Parent=workspace.Terrain at.WorldPosition=pos
	local g=Instance.new("BillboardGui") g.Adornee=at g.Size=UDim2.fromOffset(90*BB,44*BB) g.AlwaysOnTop=true g.LightInfluence=0 g.ResetOnSpawn=false
	local t=Instance.new("TextLabel") t.Size=UDim2.fromScale(1,1) t.BackgroundTransparency=1 t.Text="+"..n
	t.Font=Enum.Font.FredokaOne t.TextScaled=true t.TextColor3=WHITE t.Parent=g
	local st=stroke(t,2,Color3.fromRGB(20,24,20)) st.Transparency=.3
	local sc=Instance.new("UIScale") sc.Parent=t
	g.Parent=pgui
	task.spawn(function()
		tween(.15,function(a) sc.Scale=.4+.8*outQuad(a) end) -- petit "pop"
		local p0=at.WorldPosition
		tween(.55,function(a)
			local ch=lp.Character local hrp=ch and ch:FindFirstChild("HumanoidRootPart")
			local tgt=hrp and hrp.Position+Vector3.new(0,1.5,0) or p0+Vector3.new(0,2,0)
			at.WorldPosition=p0:Lerp(tgt,a*a)
			sc.Scale=1.2-.5*a
			local f=math.clamp((a-.6)/.4,0,1) t.TextTransparency=f st.Transparency=.3+.7*f
		end)
		g:Destroy() at:Destroy()
	end)
end

-- ===== coupe d'une touffe =====
local function cutVisual(id,picker,size,rarity)
	size=size or 1
	rarity=rarity or "Normal"
	local mine=picker==lp
	if not data[id] then gone[id]=true end
	data[id]=nil queued[id]=nil
	local v=visible[id] visible[id]=nil
	if hovered==id then setHover(nil) end
	if mine then
		snipT=os.clock() -- le curseur fait clic-clac
		pendingPicks+=1
	end
	local function arrived()
		if not mine then return end
		pendingPicks=math.max(0,pendingPicks-1)
		shown+=size refresh()
		if pendingPicks==0 and not depositing and shown~=realBag() then shown=realBag() refresh() end
	end
	if not v then arrived() return end
	v.hb:Destroy()
	local fake,P=v.bl,v.cf
	fake.Parent=fx
	local base=fake:GetScale()
	local _,sz=fake:GetBoundingBox()
	local h=math.max(sz.Y,.5)
	local cutH=math.clamp(h*.18,.12,.4)          -- hauteur de la coupe
	local cutPos=P.Position+Vector3.new(0,cutH,0)
	local col=leafColor(fake)
	if mine then gainPopup(cutPos+Vector3.new(0,.8,0),size) end
	-- 1) les lames se referment : "snip"
	snipSound(cutPos)
	slash(cutPos,math.max(sz.X,sz.Z))
	-- 2) il reste un petit chaume coupé au sol
	stubble(P,math.min(sz.X,sz.Z),cutH,col)
	-- 3) des petits brins coupés volent (pas de terre : on ne l'arrache pas)
	if rarity=="ArcEnCiel" then burst(cutPos,0,12,.45,"rainbow")
	elseif rarity~="Normal" then burst(cutPos,0,9,.4,K.OUTLINE[rarity])
	else burst(cutPos,0,6,.35,col) end
	-- 4) le haut de la touffe bascule et tombe, puis file dans le sac
	local hrp0=picker and picker.Character and picker.Character:FindFirstChild("HumanoidRootPart")
	local away=hrp0 and Vector3.new(P.Position.X-hrp0.Position.X,0,P.Position.Z-hrp0.Position.Z) or Vector3.zero
	if away.Magnitude<.1 then local a=math.random()*math.pi*2 away=Vector3.new(math.cos(a),0,math.sin(a)) end
	away=away.Unit
	local axis=Vector3.new(0,1,0):Cross(away).Unit
	local top=P*CFrame.new(0,cutH,0)
	fake:PivotTo(top)
	task.spawn(function()
		tween(.36,function(a)
			local e=a*a -- accélère comme une vraie chute
			fake:PivotTo(CFrame.new(top.Position+away*.4*e-Vector3.new(0,cutH*e,0))*CFrame.fromAxisAngle(axis,math.rad(84)*e)*top.Rotation)
		end)
		task.wait(.12)
		local p0=fake:GetPivot()
		tween(.32,function(a)
			local hrp=picker and picker.Character and picker.Character:FindFirstChild("HumanoidRootPart")
			local tgt=hrp and hrp.Position or p0.Position+Vector3.new(0,3,0)
			local e=a*a
			fake:PivotTo(CFrame.new(p0.Position:Lerp(tgt,e))*p0.Rotation)
			fake:ScaleTo(base*math.max(1-e,.05))
		end)
		fake:Destroy()
		arrived()
	end)
end

-- ===== pas de délai : l'herbe est coupée chez nous au moment où les lames se ferment =====
-- (sans attendre la réponse du serveur ; si le serveur refuse, la touffe revient)
local CLOSE_SCISSORS,CLOSE_SICKLE=.08,.15 -- secondes entre le clic et les lames qui se ferment
local scheduled,predicted={},{}
local function heldTool() local ch=lp.Character return ch and ch:FindFirstChildOfClass("Tool") end
local function pendingSize()
	local n=0
	for _,e in scheduled do n+=e.size or 1 end
	for _,v in predicted do n+=v.e.size or 1 end
	return n
end
requestCut=function(id)
	remotes.PickRequest:FireServer(id)
	local e=data[id] if not e then return end
	local tool=heldTool()
	local sickle=tool~=nil and not holdingRealScissors()
	local room=maxBag()-realBag()-pendingSize()
	if (e.size or 1)>room then return end -- sac plein : le serveur répondra
	local list={e} room-=(e.size or 1)
	-- touffes voisines coupées en même temps (faucille, Saisir) : les plus proches d'abord, comme le serveur
	local extra=(CFG.SCISSORS_EXTRA or 0)+(tool and tonumber(tool:GetAttribute("CoupeEnPlus")) or 0)
	if holdingRealScissors() then extra+=lp:GetAttribute("Upg_Saisir") or 0 end
	if holdingSickle() then extra+=lp:GetAttribute("Upg_FCoupe") or 0 end
	if extra>0 then
		local radius=math.max(CFG.SCISSORS_RADIUS or 4,tool and tonumber(tool:GetAttribute("RayonCoupe")) or 0)
		local near={}
		for id2,e2 in data do
			if id2~=id and not scheduled[id2] and not predicted[id2] then
				local d=(e2.p-e.p).Magnitude
				if d<=radius then table.insert(near,{e2,d}) end
			end
		end
		table.sort(near,function(a,b) return a[2]<b[2] end)
		for _,n in near do
			if #list>extra then break end
			if (n[1].size or 1)<=room then table.insert(list,n[1]) room-=(n[1].size or 1) end
		end
	end
	for _,x in list do scheduled[x.id]=x end
	task.delay(sickle and CLOSE_SICKLE or CLOSE_SCISSORS,function()
		for _,x in list do
			local st=scheduled[x.id] scheduled[x.id]=nil
			if st and data[x.id] then
				if st~="ok" then predicted[x.id]={e=x,t=os.clock()} end
				cutVisual(x.id,lp,x.size,x.r)
			end
		end
	end)
end
remotes:WaitForChild("Picked").OnClientEvent:Connect(function(id,picker,size,rarity)
	if picker==nil then -- test : zone vidée d'un coup, sans effets (pas de lag)
		data[id]=nil queued[id]=nil predicted[id]=nil scheduled[id]=nil
		if hovered==id then setHover(nil) end
		despawnVisual(id)
		return
	end
	if picker==lp then
		if predicted[id] then predicted[id]=nil return end -- déjà coupée chez nous
		if scheduled[id] then scheduled[id]="ok" return end -- elle sera coupée quand les lames se ferment
	else
		predicted[id]=nil
		if scheduled[id] then scheduled[id]=nil end
	end
	cutVisual(id,picker,size,rarity)
end)
-- le serveur n'a pas confirmé (trop loin, trop tôt...) : la touffe revient
task.spawn(function()
	while true do
		task.wait(.5)
		local now=os.clock()
		for id,v in predicted do
			if now-v.t>2.5 then
				predicted[id]=nil
				gone[id]=nil
				data[id]=v.e
				sync()
			end
		end
	end
end)

-- ===== pas assez de place =====
remotes:WaitForChild("BagFull").OnClientEvent:Connect(function(id,size,free)
	if free and free>0 then
		showToast("🎒 Il te faut "..tostring(size).." places (il t'en reste "..free..") : va au composteur ♻️")
	else
		showToast("🎒 Sac plein ! Va le vider au composteur ♻️")
	end
end)

-- ===== composteur : panneau "1 herbe = $" + vidage =====
-- Au-dessus du composteur : image d'herbe = pièce + prix d'une herbe.
-- Quand le sac n'est pas vide : 2e petit panneau "sac 12 → +$0.12" et une flèche qui rebondit.
local MPP=CFG.MONEY_PER_PLACE or 0
local HERB_IMAGE="rbxassetid://90182525256912"
local INK=Color3.fromRGB(26,22,28)
local WOOD_A,WOOD_B,WOOD_DARK=Color3.fromRGB(170,114,64),Color3.fromRGB(122,78,42),Color3.fromRGB(72,44,22)
local function money(v) if v>=1 and v==math.floor(v) then return "$"..v end return string.format("$%.2f",v) end
local function px(n) return math.floor(n*BB+.5) end
local function board(parent,h,y)
	local f=Instance.new("Frame") f.AnchorPoint=Vector2.new(.5,0) f.Position=UDim2.new(.5,0,0,px(y))
	f.Size=UDim2.fromOffset(0,px(h)) f.AutomaticSize=Enum.AutomaticSize.X f.BackgroundColor3=WHITE f.BorderSizePixel=0 f.Parent=parent
	corner(f,UDim.new(0,px(14)))
	local gr=Instance.new("UIGradient") gr.Rotation=90 gr.Parent=f -- reflet clair en haut, plus foncé en bas
	gr.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(206,150,94)),ColorSequenceKeypoint.new(.14,WOOD_A),ColorSequenceKeypoint.new(1,WOOD_B)})
	local st=stroke(f,px(4),WOOD_DARK,true)
	local pad=Instance.new("UIPadding") pad.PaddingLeft=UDim.new(0,px(9)) pad.PaddingRight=UDim.new(0,px(9)) pad.Parent=f
	local l=Instance.new("UIListLayout") l.FillDirection=Enum.FillDirection.Horizontal l.VerticalAlignment=Enum.VerticalAlignment.Center
	l.HorizontalAlignment=Enum.HorizontalAlignment.Center l.SortOrder=Enum.SortOrder.LayoutOrder l.Padding=UDim.new(0,px(6)) l.Parent=f
	-- 2 clous aux bouts (comme une planche clouée)
	for _,o in {0,99} do
		local n=Instance.new("Frame") n.Size=UDim2.fromOffset(px(7),px(7)) n.LayoutOrder=o
		n.BackgroundColor3=Color3.fromRGB(64,62,66) n.BorderSizePixel=0 n.Parent=f corner(n)
	end
	return f,st
end
local function word(parent,txt,size,order,color)
	local t=Instance.new("TextLabel") t.BackgroundTransparency=1 t.Font=Enum.Font.LuckiestGuy t.Text=txt t.TextSize=px(size)
	t.Size=UDim2.fromOffset(0,px(size+6)) t.AutomaticSize=Enum.AutomaticSize.X t.TextColor3=color or WHITE t.LayoutOrder=order t.Parent=parent
	local s=stroke(t,px(3.5),INK) s.LineJoinMode=Enum.LineJoinMode.Round
	return t
end
local function iconImg(parent,img,size,order)
	local i=Instance.new("ImageLabel") i.BackgroundTransparency=1 i.Image=img i.ScaleType=Enum.ScaleType.Fit
	i.Size=UDim2.fromOffset(px(size),px(size)) i.LayoutOrder=order i.Parent=parent
	return i
end
-- flèche (chevron) dessinée avec 2 barres
local function chevron(parent)
	local f=Instance.new("Frame") f.AnchorPoint=Vector2.new(.5,1) f.BackgroundTransparency=1 f.Size=UDim2.fromOffset(px(40),px(30)) f.Parent=parent
	for _,s in {-1,1} do
		local b=Instance.new("Frame") b.AnchorPoint=Vector2.new(.5,.5) b.Size=UDim2.fromOffset(px(28),px(10)) b.Rotation=45*-s
		b.Position=UDim2.new(.5,s*px(8.5),.5,0) b.BackgroundColor3=WHITE b.BorderSizePixel=0 b.Parent=f
		corner(b) stroke(b,px(3),INK,true)
	end
	return f
end

local hints={}
-- position du panneau : au-dessus du tas "Compost" (sinon au-dessus du modèle)
local function hintPos(c)
	local top=c:FindFirstChild("Compost",true)
	if top and top:IsA("BasePart") then return top.Position+Vector3.new(0,top.Size.Y/2+2.2,0) end
	local ok,cf,size=pcall(c.GetBoundingBox,c)
	if ok and cf and size.Magnitude>.1 then return cf.Position+Vector3.new(0,size.Y/2+.4,0) end
	return nil
end
local function makeHint(c)
	-- le panneau est accroché à un point invisible (marche même si le modèle charge en retard)
	local at=Instance.new("Attachment") at.Name="CompostHintPoint" at.Parent=workspace.Terrain
	local g=Instance.new("BillboardGui") g.Name="CompostHint" g.Adornee=at
	-- taille fixe dans le monde (en studs) : comme un vrai panneau, il ne grossit pas quand on s'éloigne
	g.Size=UDim2.fromScale(9,4.9) g.SizeOffset=Vector2.new(0,.5) -- le bas du panneau (la flèche) pointe sur le composteur
	g.AlwaysOnTop=true g.MaxDistance=120 g.LightInfluence=0 g.ResetOnSpawn=false g.Enabled=false
	local root=Instance.new("Frame") root.BackgroundTransparency=1 root.AnchorPoint=Vector2.new(.5,.5) root.Position=UDim2.fromScale(.5,.5)
	root.Size=UDim2.fromOffset(px(360),px(196)) root.Parent=g
	local rs=Instance.new("UIScale") rs.Parent=root
	-- panneau principal : [herbe] = [pièce] $0.01
	local main=board(root,72,0)
	iconImg(main,HERB_IMAGE,66,1)
	word(main,"=",40,2)
	iconImg(main,COIN,50,3)
	local val=word(main,MPP>0 and money(MPP) or "+1",42,4)
	local vg=Instance.new("UIGradient") vg.Rotation=90 vg.Color=ColorSequence.new(WHITE,Color3.fromRGB(255,228,140)) vg.Parent=val
	-- ce que contient ton sac : [sac] 12 → +$0.12
	local gain,gst=board(root,50,84)
	local gScale=Instance.new("UIScale") gScale.Parent=gain
	iconImg(gain,BAG_IMAGE,36,1)
	local nTx=word(gain,"0",28,2)
	word(gain,"→",28,3)
	local gTx=word(gain,"+$0",28,4,GOLD)
	local arrow=chevron(root) arrow.Position=UDim2.new(.5,0,1,0)
	g.Parent=pgui
	table.insert(hints,{c=c,at=at,g=g,rs=rs,gain=gain,gst=gst,gScale=gScale,nTx=nTx,gTx=gTx,arrow=arrow})
	print("[Herbe] Panneau du composteur créé :",c:GetFullName())
end
local function addHint(c)
	if not c:IsA("Model") then return end
	for _,h in hints do if h.c==c then return end end
	local ok,err=pcall(makeHint,c)
	if not ok then warn("[Herbe] Panneau du composteur : erreur ->",err) end
end
-- le serveur marque les composteurs (tag) ; on les cherche aussi nous-mêmes par leur nom
for _,c in CS:GetTagged("GrassCompost") do addHint(c) end
CS:GetInstanceAddedSignal("GrassCompost"):Connect(addHint)
local COMPOST_NAME=CFG.COMPOST_NAME or "Composteur"
for _,d in workspace:GetDescendants() do if d.Name==COMPOST_NAME then addHint(d) end end
workspace.DescendantAdded:Connect(function(d) if d.Name==COMPOST_NAME then addHint(d) end end)
task.delay(20,function() if #hints==0 then warn("[Herbe] Aucun composteur trouvé : le modèle doit s'appeler '"..COMPOST_NAME.."' dans Workspace") end end)

local hintAcc=0
Run.RenderStepped:Connect(function(dt)
	hintAcc+=dt
	local slow=hintAcc>=.2 if slow then hintAcc=0 end
	local t=os.clock()
	local m=maxBag()
	local isFull=shown>=m
	local hasBag=shown>0 and not depositing
	local hide=lp:GetAttribute("IntroEnCours")==true
	for _,h in hints do
		if slow then
			local pos=h.c.Parent and hintPos(h.c)
			if pos then h.at.WorldPosition=pos end
			h.g.Enabled=not hide and pos~=nil
			h.gain.Visible=hasBag h.arrow.Visible=hasBag
			if hasBag then
				h.nTx.Text=tostring(shown)
				h.gTx.Text=MPP>0 and "+"..money(shown*MPP) or "+"..shown.." 🌿"
				h.gst.Color=isFull and GOLD or WOOD_DARK
				h.nTx.TextColor3=isFull and GOLD or WHITE
			end
		end
		if h.g.Enabled then h.rs.Scale=h.g.AbsoluteSize.X/px(360) end
		-- animations seulement si le panneau est proche (pas de calcul pour rien)
		if hasBag and h.g.Enabled and (cam.CFrame.Position-h.at.WorldPosition).Magnitude<125 then
			h.arrow.Position=UDim2.new(.5,0,1,-px(math.abs(math.sin(t*4.5))*9))
			h.gScale.Scale=isFull and 1+.06*math.abs(math.sin(t*5)) or 1
		end
	end
end)

local function compostTarget(c)
	local s=c:FindFirstChild("Compost",true)
	if s and s:IsA("BasePart") then return s.Position+Vector3.new(0,s.Size.Y/2+.9,0) end
	local cf,size=c:GetBoundingBox()
	return cf.Position+Vector3.new(0,size.Y*.15,0)
end

remotes:WaitForChild("Deposited").OnClientEvent:Connect(function(plr,c,n,gain)
	local mine=plr==lp
	if not c or not c.Parent then if mine then depositing=false sync() end return end
	local target=compostTarget(c)
	local ch=plr.Character
	local hrp=ch and ch:FindFirstChild("HumanoidRootPart")
	local k=math.clamp(n,1,6)
	if mine then depositing=true shown=math.max(shown,n) task.spawn(armAnim,{{.1,2.5},{.14,.9},{.2,0}}) end
	local remaining=n
	for i=1,k do
		local dec=(i==k) and remaining or math.floor(n/k)
		remaining-=dec
		task.delay((i-1)*.1,function()
			local from=(hrp and hrp.Parent) and (hrp.CFrame*CFrame.new(.9,1.3,-.8)).Position or target+Vector3.new(0,6,0)
			local m=K.Build(CFrame.new(from),.38,math.random(1,1000000),true)
			m.Parent=fx
			local base=m:GetScale()
			local mid=(from+target)/2+Vector3.new(0,math.max(0,target.Y-from.Y)+3.5,0)
			local sp=math.random()*6.28
			tween(.5,function(a)
				m:PivotTo(CFrame.new(bez(from,mid,target,a))*CFrame.Angles(a*5,sp+a*7,a*2))
				if a>.75 then m:ScaleTo(base*math.max((1-a)/.25,.05)) end
			end)
			m:Destroy()
			burst(target,1,4,.55)
			if mine then shown=math.max(0,shown-dec) refresh() end
			if i==k then
				burst(target,4,8,1.1) puffs(target-Vector3.new(0,.5,0))
				sound(CFG.DEPOSIT_SOUND,target,.7)
				if mine then
					if gain and gain>0 then popupAt(target+Vector3.new(0,2.5,0),"+"..fmt(gain).."$",GOLD)
					else popupAt(target+Vector3.new(0,2.5,0),"+"..n.." 🌿",GREEN) end
					depositing=false sync()
				end
			end
		end)
	end
end)
]]></ProtectedString></Properties></Item></roblox>