adapter()
cam:GetPropertyChangedSignal("ViewportSize"):Connect(adapter)

-- messages au centre de l'écran (achat réussi, argent qui manque)
local messages = nouveau("ScreenGui", { Name = "BoutiqueMessages", ResetOnSpawn = false, DisplayOrder = 40 }, pgui)
local function son(id, vol)
	local s = nouveau("Sound", { SoundId = id, Volume = vol or 0.6 }, messages)
	s:Play()
	game:GetService("Debris"):AddItem(s, 4)
end
local function message(t, couleur, duree)
	local l = nouveau("TextLabel", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.fromScale(0.7, 0.1),
		Font = Enum.Font.LuckiestGuy, TextScaled = true, Text = t, TextColor3 = couleur,
	}, messages)
	local st = contour(l, 5)
	local sc = nouveau("UIScale", { Scale = 0 }, l)
	TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(duree, function()
		TweenService:Create(l, TweenInfo.new(0.3), { TextTransparency = 1, Position = UDim2.fromScale(0.5, 0.25) }):Play()
		TweenService:Create(st, TweenInfo.new(0.3), { Transparency = 1 }):Play()
		task.wait(0.35)
		l:Destroy()
	end)
end
local function trembler(o)
	task.spawn(function()
		local p0 = o.Position
		for i = 1, 6 do
			o.Position = p0 + UDim2.fromOffset(i % 2 == 0 and -8 or 8, 0)
			task.wait(0.04)
		end
		o.Position = p0
	end)
end

---------------------------------------------------------------- Caméra
local tourCamera = 0
local function bougerCamera(vers, duree, fin)
	tourCamera += 1
	local id = tourCamera
	local depart = cam.CFrame
	task.spawn(function()
		local t0 = os.clock()
		while tourCamera == id do
			local a = math.min((os.clock() - t0) / duree, 1)
			local e = if a < 0.5 then 4 * a * a * a else 1 - (-2 * a + 2) ^ 3 / 2 -- doux au début et à la fin
			cam.CFrame = depart:Lerp(vers, e)
			if a >= 1 then break end
			RunService.RenderStepped:Wait()
		end
		if tourCamera == id and fin then fin() end
	end)
end
-- où placer la caméra pour bien voir l'outil (un peu décalé : la fiche prend la gauche de l'écran)
local function cadrage(v)
	local centre = v.centre.Position
	local devant = v.base.CFrame.LookVector
	local ch = lp.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if hrp and (hrp.Position - centre):Dot(devant) < 0 then devant = -devant end -- du côté où se trouve le joueur
	devant = Vector3.new(devant.X, 0, devant.Z).Unit
	local largeur = math.max(v.taille.X, v.taille.Z, 1.5)
	local distance = math.max(largeur * 0.95, 3)
	local droite = (-devant):Cross(Vector3.yAxis).Unit -- la droite de l'écran
	local cible = centre - droite * largeur * 0.3
	local dir = (devant + Vector3.yAxis * v.article.hauteur).Unit
	return CFrame.lookAt(cible + dir * distance, cible)
end

---------------------------------------------------------------- Ouvrir / fermer la fiche
local courant = 1 -- outil affiché
local etat = {}
local fermeture = false

local function styleBouton(v)
	local possede = lp:GetAttribute(v.article.attribut)
	local assez = argent() + 1e-6 >= v.prix()
	if possede then
		fondPrix.Color = ColorSequence.new(Color3.fromRGB(255, 232, 120), Color3.fromRGB(240, 160, 30))
		textePrix.Text = "✓ ACHETÉE"
		textePrix.TextSize = 48
	else
		fondPrix.Color = assez and ColorSequence.new(Color3.fromRGB(150, 236, 110), Color3.fromRGB(56, 170, 62))
			or ColorSequence.new(Color3.fromRGB(150, 154, 160), Color3.fromRGB(98, 102, 108))
		textePrix.Text = argentTexte(v.prix())
		textePrix.TextSize = 70
	end
end

local function remplir(v)
	nomOutil.Text = v.article.nom
	descOutil.Text = v.article.desc
	puissance.Text = "PUISSANCE " .. tostring(v.achat:GetAttribute("Touffes") or "?")
	styleBouton(v)
	local multiple = #vitrines > 1
	gauche.Visible, droite.Visible = multiple, multiple
end

local controles
local function bloquerControles(bloquer)
	if not controles then
		pcall(function()
			controles = require(lp:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()
		end)
	end
	if controles then pcall(function() if bloquer then controles:Disable() else controles:Enable() end end) end
end

local function ouvrir(v)
	if ouvert or fermeture or not v then return end
	ouvert = true
	for i, x in vitrines do if x == v then courant = i end end
	etat.cf, etat.type, etat.fov = cam.CFrame, cam.CameraType, cam.FieldOfView
	-- on cache le reste de l'interface et on bloque le personnage
	etat.guis = {}
	for _, g in pgui:GetChildren() do
		if g:IsA("ScreenGui") and g ~= ecran and g ~= messages and g.Enabled then
			g.Enabled = false
			table.insert(etat.guis, g)
		end
	end
	pcall(function() game:GetService("ProximityPromptService").Enabled = false end)
	lp:SetAttribute("MenuOuvert", true) -- pas de coupe pendant ce temps
	bloquerControles(true)
	for _, x in vitrines do x.contour.Enabled = false end
	-- la caméra se rapproche de l'outil
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = 70
	bougerCamera(cadrage(v), REGLAGES.DUREE_CAMERA)
	-- la fiche arrive
	remplir(v)
	ecran.Enabled = true
	notes.Position = UDim2.new(0, -520, 0.48, 0)
	boutonPrix.Position = UDim2.new(0.5, 0, 1, 180)
	cadreArgent.Position = UDim2.new(1, -150, 0, -140)
	boutonX.Position = UDim2.new(1, -36, 0, -140)
	local info = TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	task.delay(0.15, function()
		TweenService:Create(notes, info, { Position = UDim2.new(0, 56, 0.48, 0) }):Play()
		TweenService:Create(boutonPrix, info, { Position = UDim2.new(0.5, 0, 1, -40) }):Play()
		TweenService:Create(cadreArgent, info, { Position = UDim2.new(1, -150, 0, 40) }):Play()
		TweenService:Create(boutonX, info, { Position = UDim2.new(1, -36, 0, 34) }):Play()
	end)
	if UIS.GamepadEnabled then GuiService.SelectedObject = boutonPrix end
end

local function fermer()
	if not ouvert or fermeture then return end
	fermeture = true
	GuiService.SelectedObject = nil
	local info = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(notes, info, { Position = UDim2.new(0, -520, 0.48, 0) }):Play()
	TweenService:Create(boutonPrix, info, { Position = UDim2.new(0.5, 0, 1, 180) }):Play()
	TweenService:Create(cadreArgent, info, { Position = UDim2.new(1, -150, 0, -140) }):Play()
	TweenService:Create(boutonX, info, { Position = UDim2.new(1, -36, 0, -140) }):Play()
	-- la caméra revient au joueur
	bougerCamera(etat.cf, 0.45, function()
		ecran.Enabled = false
		cam.CameraType = etat.type or Enum.CameraType.Custom
		cam.FieldOfView = etat.fov or 70
		for _, g in etat.guis or {} do if g.Parent then g.Enabled = true end end
		pcall(function() game:GetService("ProximityPromptService").Enabled = true end)
		lp:SetAttribute("MenuOuvert", false)
		bloquerControles(false)
		ouvert, fermeture = false, false
	end)
end

local function changer(delta)
	if not ouvert or fermeture or #vitrines < 2 then return end
	courant = (courant - 1 + delta) % #vitrines + 1
	local v = vitrines[courant]
	bougerCamera(cadrage(v), 0.5)
	-- la fiche "se tourne" vers le nouvel outil
	TweenService:Create(notes, TweenInfo.new(0.12), { Rotation = delta * 3 }):Play()
	task.delay(0.12, function()
		remplir(v)
		TweenService:Create(notes, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
	end)
end

local function acheter()
	local v = vitrines[courant]
	if not v or lp:GetAttribute(v.article.attribut) then return end
	if argent() + 1e-6 < v.prix() then
		trembler(boutonPrix)
		message("Il te manque " .. argentTexte(v.prix() - argent()), ROUGE, 1.6)
		return
	end
	v.achat:FireServer("acheter")
end

boutonPrix.Activated:Connect(acheter)
boutonX.Activated:Connect(fermer)
gauche.Activated:Connect(function() changer(-1) end)
droite.Activated:Connect(function() changer(1) end)
for _, b in { boutonPrix, gauche, droite, boutonX } do
	local s0 = b.Size
	b.MouseEnter:Connect(function() b.Size = s0 + UDim2.fromOffset(8, 6) end)
	b.MouseLeave:Connect(function() b.Size = s0 end)
end

UIS.InputBegan:Connect(function(input, gp)
	if ouvert then
		local k = input.KeyCode
		if k == Enum.KeyCode.Left or k == Enum.KeyCode.A or k == Enum.KeyCode.DPadLeft then changer(-1)
		elseif k == Enum.KeyCode.Right or k == Enum.KeyCode.D or k == Enum.KeyCode.DPadRight then changer(1)
		elseif k == Enum.KeyCode.Backspace or k == Enum.KeyCode.ButtonB then fermer() end
		return
	end
	if gp then return end
	-- clic / appui sur un outil de l'établi
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
		local pos = if t == Enum.UserInputType.Touch then input.Position else nil
		local cible
		if pos then
			local r = cam:ScreenPointToRay(pos.X, pos.Y)
			cible = (function()
				local ch = lp.Character
				local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
				local meilleur, dmin = nil, math.huge
				for _, v in vitrines do
					if hrp and (hrp.Position - v.centre.Position).Magnitude < REGLAGES.DISTANCE then
						local d = rayonBoite(r.Origin, r.Direction * 200, v.centre, v.taille + Vector3.new(0.5, 0.5, 0.5))
						if d and d < dmin then meilleur, dmin = v, d end
					end
				end
				return meilleur
			end)()
		end
		cible = cible or etat.survol
		if cible then ouvrir(cible) end
	end
end)

-- si on meurt pendant que la fiche est ouverte
lp.CharacterAdded:Connect(function() if ouvert then fermer() end end)

---------------------------------------------------------------- Chaque image : survol (contour blanc), prix, fiche
local function viser()
	if not UIS.MouseEnabled then return nil end
	local pos = if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then cam.ViewportSize / 2 else UIS:GetMouseLocation()
	local r = cam:ViewportPointToRay(pos.X, pos.Y)
	local ch = lp.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	local meilleur, dmin = nil, math.huge
	for _, v in vitrines do
		if (hrp.Position - v.centre.Position).Magnitude < REGLAGES.DISTANCE then
			local d = rayonBoite(r.Origin, r.Direction * 200, v.centre, v.taille + Vector3.new(0.4, 0.4, 0.4))
			if d and d < dmin then meilleur, dmin = v, d end
		end
	end
	return meilleur
end

RunService.RenderStepped:Connect(function()
	for _, v in vitrines do majEtiquette(v) end
	if ouvert then
		UIS.MouseBehavior = Enum.MouseBehavior.Default
		UIS.MouseIconEnabled = true
		texteArgent.Text = argentTexte(argent())
		local v = vitrines[courant]
		if v then styleBouton(v) end
		return
	end
	local s = if lp:GetAttribute("IntroEnCours") then nil else viser()
	if s ~= etat.survol then
		if etat.survol then etat.survol.contour.Enabled = false end
		etat.survol = s
		if s then s.contour.Enabled = true end
	end
end)

---------------------------------------------------------------- Chargement des outils de l'établi
local function reponse(v, quoi, manque)
	if quoi == "ok" then
		son("rbxassetid://129348077985519", 0.7)
		message("✨ " .. v.article.titre .. " ACHETÉE ! ✨", OR, 2.2)
		if ouvert and vitrines[courant] == v then
			popPrix.Scale = 1.4
			TweenService:Create(popPrix, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		end
	elseif quoi == "manque" then
		message("Il te manque " .. argentTexte(math.max(0, tonumber(manque) or 0)), ROUGE, 1.6)
		if ouvert then trembler(boutonPrix) end
	end
end

for ordre, article in ARTICLES do
	task.spawn(function()
		local achat = ReplicatedStorage:WaitForChild(article.remote, 30)
		if not achat then return end -- cet outil n'est pas installé
		local modele = workspace:FindFirstChild(article.vitrine, true)
		for _ = 1, 30 do
			if modele then break end
			task.wait(1)
			modele = workspace:FindFirstChild(article.vitrine, true)
		end
		if not modele then return end
		local base = modele.PrimaryPart or modele:WaitForChild("Base", 10)
		if not base then return end
		task.wait(0.5) -- laisse toutes les pièces arriver
		local centre, taille = mesurer(modele, base)
		local v = { article = article, achat = achat, modele = modele, base = base, centre = centre, taille = taille, ordre = ordre }
		v.prix = function() return achat:GetAttribute("Prix") or 0 end
		v.contour = nouveau("Highlight", {
			Name = "Survol", Adornee = modele, FillColor = BLANC, FillTransparency = 0.88, OutlineColor = BLANC,
			OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.Occluded, Enabled = false,
		}, modele)
		creerEtiquette(v)
		achat.OnClientEvent:Connect(function(quoi, manque) reponse(v, quoi, manque) end)
		-- E (clavier), bouton (manette / téléphone) : ouvre aussi la fiche
		local function brancher(p)
			if p:IsA("ProximityPrompt") then p.Triggered:Connect(function() ouvrir(v) end) end
		end
		for _, p in base:GetChildren() do brancher(p) end
		base.ChildAdded:Connect(brancher)
		table.insert(vitrines, v)
		table.sort(vitrines, function(a, b) return a.ordre < b.ordre end)
	end)
end

---------------------------------------------------------------- La débroussailleuse : tête qui tourne, moteur qui accélère
-- Au ralenti la tête tourne doucement. Quand on fauche ("EnCoupe" du serveur, ou tout de suite chez nous),
-- elle accélère : les fils deviennent un disque flou et l'herbe hachée + un peu de terre giclent devant.
local CollectionService = game:GetService("CollectionService")
local RALENTI, PLEIN_GAZ = 14, 75 -- vitesse de la tête (radians par seconde)
local tetes = setmetatable({}, { __mode = "k" }) -- [moteur] = { angle, vitesse, disque, fils, herbe, terre }

local function outilDe(m)
	local o = m:FindFirstAncestorOfClass("Tool")
	if o then return o end
	-- la copie affichée à la 1re personne (CiseauxVue) : c'est notre outil en main
	local ch = lp.Character
	return ch and ch:FindFirstChildOfClass("Tool")
end
local function enCoupe(o)
	if not o then return false end
	if o:GetAttribute("EnCoupe") then return true end
	local t = o:GetAttribute("CoupeLocale") -- mis par CiseauxVue dès notre clic (pas d'attente du serveur)
	return t ~= nil and os.clock() - t < 0.5
end
local function emetteur(parent, couleurs, taille, vitesse, taux)
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(couleurs[1], couleurs[2])
	e.Size = NumberSequence.new(taille, taille * 0.4)
	e.Squash = NumberSequence.new(1.6)
	e.Orientation = Enum.ParticleOrientation.VelocityParallel
	e.Lifetime = NumberRange.new(0.3, 0.55)
	e.Speed = NumberRange.new(vitesse * 0.7, vitesse)
	e.SpreadAngle = Vector2.new(70, 35)
	e.Acceleration = Vector3.new(0, -45, 0)
	e.Drag = 3
	e.RotSpeed = NumberRange.new(-300, 300)
	e.LightEmission = 0
	e.LightInfluence = 1
	e.Rate = 0
	e:SetAttribute("Taux", taux)
	e.Parent = parent
	return e
end
local function preparer(m)
	local pivot, handle = m.Part1, m.Part0
	if not (pivot and handle) then return nil end
	local modele = pivot.Parent
	-- copie de l'outil (vue 1re personne) : on enlève le disque et les projections copiés, on refait les nôtres
	for _, d in modele:GetChildren() do if d.Name == "DisqueFlou" then d:Destroy() end end
	for _, d in handle:GetChildren() do if d.Name == "Projections" then d:Destroy() end end
	local fils = {}
	local bobine
	for _, d in modele:GetChildren() do
		if d:IsA("BasePart") and d:GetAttribute("Tete") then
			if d.Name == "Fil" then table.insert(fils, d) elseif d.Name == "Bobine" then bobine = d end
		end
	end
	-- disque flou (les fils qui tournent très vite)
	local long = fils[1] and fils[1].Size.X or 1
	local disque = Instance.new("Part")
	disque.Name = "DisqueFlou"
	disque.Shape = Enum.PartType.Cylinder
	disque.Size = Vector3.new(0.03, long, long)
	disque.Color = Color3.fromRGB(245, 220, 120)
	disque.Material = Enum.Material.SmoothPlastic
	disque.Transparency = 1
	disque.CanCollide, disque.CanTouch, disque.CanQuery, disque.CastShadow = false, false, false, false
	disque.Massless = true
	disque.CFrame = (fils[1] and fils[1].CFrame or pivot.CFrame) * CFrame.Angles(0, 0, math.rad(90)) -- à plat, comme les fils
	local w = Instance.new("Weld")
	w.Part0, w.Part1 = pivot, disque
	w.C0 = pivot.CFrame:ToObjectSpace(disque.CFrame)
	w.Parent = disque
	disque.Parent = modele
	-- projections : repère fixe sur l'outil (pas sur la tête qui tourne), dirigé vers l'avant de la tête
	local at = Instance.new("Attachment")
	at.Name = "Projections"
	at.CFrame = m.C0 * CFrame.Angles(0, 0, math.rad(-90))
	at.Parent = handle
	local herbe = emetteur(at, { Color3.fromRGB(150, 220, 90), Color3.fromRGB(70, 150, 50) }, 0.3, 22, 150)
	local terre = emetteur(at, { Color3.fromRGB(122, 90, 58), Color3.fromRGB(86, 60, 36) }, 0.18, 14, 25)
	local e = { angle = math.random() * 6.28, vitesse = RALENTI, disque = disque, fils = fils, bobine = bobine, herbe = herbe, terre = terre }
	tetes[m] = e
	return e
end

RunService.RenderStepped:Connect(function(dt)
	for _, m in CollectionService:GetTagged("TeteDebroussailleuse") do
		-- seulement quand elle est en main (dans le monde), pas dans le sac
		if m:IsA("Motor6D") and m:IsDescendantOf(workspace) then
			local e = tetes[m] or preparer(m)
			if e then
				local coupe = enCoupe(outilDe(m))
				local cible = coupe and PLEIN_GAZ or RALENTI
				e.vitesse += (cible - e.vitesse) * math.min(dt * (coupe and 10 or 3), 1) -- ça monte vite, ça redescend doucement
				e.angle = (e.angle + e.vitesse * dt) % (2 * math.pi)
				m.Transform = CFrame.Angles(0, e.angle, 0)
				local k = math.clamp((e.vitesse - RALENTI) / (PLEIN_GAZ - RALENTI), 0, 1) -- 0 = ralenti, 1 = plein gaz
				local cache = e.bobine and e.bobine.LocalTransparencyModifier or 0 -- caché à la 1re personne (vraie débroussailleuse)
				e.disque.Transparency = 1 - 0.35 * k
				e.disque.LocalTransparencyModifier = cache
				for _, f in e.fils do f.LocalTransparencyModifier = math.max(cache, k > 0.5 and 1 or 0) end
				local actif = coupe and cache < 1
				e.herbe.Rate = actif and e.herbe:GetAttribute("Taux") or 0
				e.terre.Rate = actif and e.terre:GetAttribute("Taux") or 0
			end
		end
	end
end)

]]></ProtectedString></Properties></Item></roblox>