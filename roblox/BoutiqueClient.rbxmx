	BackgroundColor3 = ROUGE, Rotation = 4,
}, ecran))
coin(boutonX, UDim.new(0, 12))
contour(boutonX, 4, Color3.fromRGB(150, 24, 30), true)
local xt = nouveau("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(0, 4), Font = Enum.Font.LuckiestGuy, TextSize = 58, TextColor3 = BLANC, Text = "X" }, boutonX)
