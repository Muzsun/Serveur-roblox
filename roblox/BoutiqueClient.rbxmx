-- flèches (outil précédent / suivant)
local function fleche(txt, x)
	local b = echelle(nouveau("TextButton", {
		Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, x, 1, -48), Size = UDim2.fromOffset(130, 86),
		BackgroundColor3 = BLANC, Rotation = x < 0 and -3 or 2,
	}, ecran))
	coin(b, UDim.new(0, 20))
	contour(b, 3, Color3.fromRGB(210, 206, 196), true)
	nouveau("TextLabel", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(0, 4), Font = Enum.Font.LuckiestGuy, TextSize = 50, TextColor3 = ENCRE, Text = txt }, b)
	return b
end
local gauche, droite = fleche("<", -300), fleche(">", 300)

