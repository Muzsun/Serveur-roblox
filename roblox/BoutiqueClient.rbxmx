}, ecran))
coin(cadreArgent, UDim.new(0, 30))
nouveau("ImageLabel", { BackgroundTransparency = 1, Image = COIN, ScaleType = Enum.ScaleType.Fit, Position = UDim2.fromOffset(12, 5), Size = UDim2.fromOffset(68, 68) }, cadreArgent)
