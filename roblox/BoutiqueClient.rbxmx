contour(puissance, 6)

-- bouton du prix (cliquer = acheter)
local boutonPrix = echelle(nouveau("TextButton", {
	Name = "Prix", Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -40),
	Size = UDim2.fromOffset(300, 104), BackgroundColor3 = BLANC,
}, ecran))
coin(boutonPrix, UDim.new(0, 28))
