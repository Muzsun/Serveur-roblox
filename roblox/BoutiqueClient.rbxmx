end
nouveau("Frame", { Position = UDim2.fromOffset(64, 0), Size = UDim2.new(0, 4, 1, 0), BackgroundColor3 = Color3.fromRGB(224, 80, 106), BorderSizePixel = 0, ZIndex = 2 }, notes)
for i = 0, 4 do -- les anneaux du carnet
