pose.queueAmp, pose.queueVitesse, pose.queueTangage = 38, 11, 0
pose.couRoulis, pose.couTangage = 0, 0
sonJouer(REGLAGES.SONS.aboiement, 0.8, 1)

---------------------------------------------------------------- Titre "RETROUVE LA BALLE !"
