<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Folder" referent="RBX0"><Properties><string name="Name">InstallationBoutique</string></Properties><Item class="LocalScript" referent="RBX1"><Properties><string name="Name">BoutiqueClient</string><ProtectedString name="Source"><![CDATA[-- BoutiqueClient (LocalScript dans StarterPlayer > StarterPlayerScripts)
-- La boutique de l'établi :
--  * au-dessus de chaque outil en vente : la pièce + le prix
--  * la souris passe sur l'outil : il s'entoure de blanc
--  * clic (ou E / appui) sur l'outil : la caméra se rapproche et la fiche de l'outil s'ouvre
--    (nom, description, touffes par coup, portée), avec le bouton pour acheter (ou équiper),
--    des flèches pour passer à l'autre outil, ton argent et une croix pour fermer.
-- Et la tête de la débroussailleuse qui tourne.
if not game:GetService("RunService"):IsClient() then
	warn("[Boutique] BoutiqueClient doit être un LocalScript dans StarterPlayer > StarterPlayerScripts !")
	return
end

-- outils en vente : remote du serveur, modèle sur l'établi, attribut du joueur quand c'est acheté
local ARTICLES = {
	{
		remote = "FaucilleAchat", vitrine = "FaucilleVitrine", attribut = "Faucille", nom = "Faucille", titre = "FAUCILLE",
		outil = "Faucille", -- nom de l'outil dans le sac
		desc = "Une lame en croissant bien affûtée. Fauche plusieurs touffes d'un seul coup.",
		touffesMax = 5, -- avec toutes les améliorations
		ameliorations = 3,
		hauteur = 0.95, -- caméra : 0 = de face, 1 = bien au-dessus (la faucille est posée à plat)
	},
	{
		remote = "DebroussailleuseAchat", vitrine = "DebroussailleuseVitrine", attribut = "Debroussailleuse", nom = "Débroussailleuse", titre = "DÉBROUSSAILLEUSE",
		outil = "Debroussailleuse",
		desc = "Un moteur qui rugit et un fil qui tourne à toute vitesse. Rien ne lui résiste !",
		touffesMax = 10,
		ameliorations = 3,
		hauteur = 0.12, -- accrochée au mur : presque de face
	},
}
local REGLAGES = {
	TAILLE_PRIX = 0.75, -- hauteur du prix flottant (studs)
	DISTANCE = 22, -- on peut cliquer sur un outil jusqu'à cette distance
	DUREE_CAMERA = 0.6, -- durée du rapprochement de la caméra (secondes)
}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local COIN = "rbxassetid://103593634628600" -- l'icône des pièces
local HERBE = "rbxassetid://90182525256912" -- l'image d'une touffe d'herbe
local lp = Players.LocalPlayer
local pgui = lp:WaitForChild("PlayerGui")
-- si le script est installé 2 fois, les 2 copies se cachent l'une l'autre : on n'en garde qu'une
if pgui:FindFirstChild("Boutique") or lp:GetAttribute("BoutiqueLancee") then
	warn("[Boutique] BoutiqueClient est installé 2 fois ! Garde un seul BoutiqueClient dans StarterPlayer > StarterPlayerScripts (et plus de FaucilleClient).")
	return
end
lp:SetAttribute("BoutiqueLancee", true)
local cam = workspace.CurrentCamera

local BLANC, ENCRE = Color3.new(1, 1, 1), Color3.fromRGB(26, 22, 28)
local OR, VERT, ROUGE = Color3.fromRGB(255, 215, 70), Color3.fromRGB(110, 224, 74), Color3.fromRGB(232, 50, 58)

local function argentTexte(v) return string.format("$%.2f", v) end
local function coin(o, r) local c = Instance.new("UICorner") c.CornerRadius = r or UDim.new(1, 0) c.Parent = o return c end
local function contour(o, e, c, bord)
	local s = Instance.new("UIStroke")
	s.Thickness = e
	s.Color = c or ENCRE
	s.LineJoinMode = Enum.LineJoinMode.Round
	if bord then s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border end
	s.Parent = o
	return s
end
local function nouveau(classe, props, parent)
	local o = Instance.new(classe)
	for k, v in props do o[k] = v end
	o.Parent = parent
	return o
end

-- argent du joueur (même recherche que le reste du jeu)
local okCfg, CFG = pcall(function() return require(ReplicatedStorage:WaitForChild("GrassConfig", 10)) end)
if not okCfg or type(CFG) ~= "table" then CFG = {} end
local function argent()
	local ls = lp:FindFirstChild("leaderstats")
	if not ls then return 0 end
	local v
	if CFG.MONEY_STAT and CFG.MONEY_STAT ~= "" then v = ls:FindFirstChild(CFG.MONEY_STAT) end
	if not v then
		for _, n in { "Money", "Cash", "Argent", "Coins", "Dollars", "Pieces", "Pièces", "$" } do
			v = ls:FindFirstChild(n)
			if v then break end
		end
	end
	return v and tonumber(v.Value) or 0
end

---------------------------------------------------------------- Les outils sur l'établi
local vitrines = {} -- liste des outils trouvés : { article, achat, modele, base, centre, taille, repere, etiquette, contour }
local ouvert = false

-- boîte autour des pièces visibles de l'outil (dans le repère de l'établi)
local function mesurer(modele, base)
	local rep = base.CFrame.Rotation
	local mini, maxi = Vector3.new(math.huge, math.huge, math.huge), -Vector3.new(math.huge, math.huge, math.huge)
	for _, p in modele:GetDescendants() do
		if p:IsA("BasePart") and p.Transparency < 1 then
			local l = rep:PointToObjectSpace(p.Position)
			local r = p.Size.Magnitude / 2 * 0.6
			mini = Vector3.new(math.min(mini.X, l.X - r), math.min(mini.Y, l.Y - r), math.min(mini.Z, l.Z - r))
			maxi = Vector3.new(math.max(maxi.X, l.X + r), math.max(maxi.Y, l.Y + r), math.max(maxi.Z, l.Z + r))
		end
	end
	if mini.X == math.huge then return base.CFrame, base.Size end
	return rep * CFrame.new((mini + maxi) / 2), maxi - mini
end

-- un rayon touche-t-il la boîte ? (renvoie la distance)
local function rayonBoite(origine, direction, cf, taille)
	local o = cf:PointToObjectSpace(origine)
	local d = cf:VectorToObjectSpace(direction)
	local tmin, tmax = 0, math.huge
	for _, ax in { "X", "Y", "Z" } do
		local h = taille[ax] / 2
		if math.abs(d[ax]) < 1e-6 then
			if o[ax] < -h or o[ax] > h then return nil end
		else
			local t1, t2 = (-h - o[ax]) / d[ax], (h - o[ax]) / d[ax]
			if t1 > t2 then t1, t2 = t2, t1 end
			tmin, tmax = math.max(tmin, t1), math.min(tmax, t2)
			if tmin > tmax then return nil end
		end
	end
	return tmin
end

-- le prix flottant au-dessus de l'outil : [pièce] $7.99
local function creerEtiquette(v)
	local at = Instance.new("Attachment")
	at.Name = "Prix_" .. v.article.attribut
	at.Parent = workspace.Terrain
	local devant = v.base.CFrame.LookVector
	at.WorldPosition = v.centre.Position + Vector3.new(0, v.taille.Y / 2 + 0.55, 0) + devant * 0.35
	local g = nouveau("BillboardGui", {
		Name = "Prix_" .. v.article.attribut, Adornee = at, AlwaysOnTop = true, LightInfluence = 0, MaxDistance = 45,
		ResetOnSpawn = false, Size = UDim2.fromScale(REGLAGES.TAILLE_PRIX * 3.6, REGLAGES.TAILLE_PRIX),
	}, pgui)
	local root = nouveau("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(360, 100) }, g)
	local echelle = nouveau("UIScale", {}, root)
	nouveau("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder,
	}, root)
	local piece = nouveau("ImageLabel", { BackgroundTransparency = 1, Image = COIN, ScaleType = Enum.ScaleType.Fit, Size = UDim2.fromOffset(84, 84), LayoutOrder = 1 }, root)
	local texte = nouveau("TextLabel", {
		BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy, TextSize = 76, TextColor3 = BLANC, Text = argentTexte(v.prix()),
		Size = UDim2.fromOffset(0, 90), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = 2,
	}, root)
	contour(texte, 6)
	v.etiquette = { g = g, echelle = echelle, piece = piece, texte = texte, at = at }
end

local function majEtiquette(v)
	local e = v.etiquette
	e.g.Enabled = not ouvert and not lp:GetAttribute("IntroEnCours")
	if not e.g.Enabled then return end
	e.echelle.Scale = e.g.AbsoluteSize.Y / 100
	if lp:GetAttribute(v.article.attribut) then
		e.piece.Visible = false
		e.texte.Text = "✓"
		e.texte.TextColor3 = VERT
	else
		e.piece.Visible = true
		e.texte.Text = argentTexte(v.prix())
		e.texte.TextColor3 = BLANC
	end
end

---------------------------------------------------------------- La fiche de l'outil (vue rapprochée)
-- Même style que le menu BOOSTS : carte verte, lignes crème, textes blancs contournés, boutons en relief.
local ecran = nouveau("ScreenGui", { Name = "Boutique", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 30, Enabled = false }, pgui)
local echelles = {} -- tout est dessiné pour un écran de 1080 px de haut, puis mis à l'échelle
local function echelle(o) table.insert(echelles, nouveau("UIScale", {}, o)) return o end
local function adapter()
	local s = math.clamp(cam.ViewportSize.Y / 1080, 0.45, 1.25)
	for _, u in echelles do u.Scale = s end
end
local function degrade(o, couleurs, rotation)
	local k = {}
	for i, c in couleurs do table.insert(k, ColorSequenceKeypoint.new((i - 1) / (#couleurs - 1), c)) end
	return nouveau("UIGradient", { Rotation = rotation or 90, Color = ColorSequence.new(k) }, o)
end
local function titre(parent, texte, props)
	local l = nouveau("TextLabel", {
		BackgroundTransparency = 1, Font = Enum.Font.LuckiestGuy, TextColor3 = BLANC, Text = texte, TextScaled = false,
	}, parent)
	for k, v in props do if k ~= "epais" then l[k] = v end end
	contour(l, props.epais or 4)
	return l
end
