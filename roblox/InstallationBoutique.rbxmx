for couche = 1, 2 do
	for _, rot in { 45, -45 } do
		local b = nouveau("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Rotation = rot, BorderSizePixel = 0,
			Size = couche == 1 and UDim2.fromScale(0.62, 0.22) or UDim2.fromScale(0.52, 0.12), BackgroundColor3 = couche == 1 and ENCRE or BLANC,
		}, boutonX)
