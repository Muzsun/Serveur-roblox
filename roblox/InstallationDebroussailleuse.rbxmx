-- ton argent (en haut à droite)
local cadreArgent = echelle(nouveau("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -130, 0, 34), Size = UDim2.fromOffset(300, 74), BackgroundColor3 = Color3.fromRGB(14, 34, 20), BackgroundTransparency = 0.05 }, ecran))
coin(cadreArgent)
contour(cadreArgent, 4, ENCRE, true)
nouveau("ImageLabel", { BackgroundTransparency = 1, Image = COIN, ScaleType = Enum.ScaleType.Fit, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(18, 37), Size = UDim2.fromOffset(94, 94) }, cadreArgent)
local texteArgent = titre(cadreArgent, "$0.00", { Position = UDim2.fromOffset(70, 6), Size = UDim2.new(1, -90, 1, -6), TextSize = 46, TextXAlignment = Enum.TextXAlignment.Right, epais = 4 })
