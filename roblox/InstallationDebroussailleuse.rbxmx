-- fermer (rond rouge avec une croix)
local boutonX = echelle(nouveau("TextButton", { Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -30, 0, 28), Size = UDim2.fromOffset(86, 86) }, ecran))
coin(boutonX)
contour(boutonX, 4, ENCRE, true)
degrade(boutonX, { Color3.fromRGB(255, 150, 140), Color3.fromRGB(235, 60, 55), Color3.fromRGB(160, 24, 30) })
for couche = 1, 2 do
