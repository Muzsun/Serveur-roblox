corner(moneyPill,UDim.new(1,0)) stroke(moneyPill,3)
local coin=new("Frame",{BackgroundTransparency=1,AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.02,.5),Size=UDim2.fromScale(.3,1.35),ZIndex=6},moneyPill)
