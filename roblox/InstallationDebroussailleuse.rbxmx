	Position=UDim2.new(1,-16,.5,0),Size=UDim2.fromOffset(SIZE,SIZE+10)},boostGui)
local fitScale=new("UIScale",{},holder)
local function fit()
	local s=math.clamp(cam.ViewportSize.Y/900,.45,1)
