local card=new("Frame",{Name="Card",AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.new(1,-16,1,-16)},panel)
corner(card,UDim.new(0,28)) stroke(card,5)
