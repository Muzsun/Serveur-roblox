local rim=new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.new(1,-14,1,-14),BackgroundTransparency=1},card)
corner(rim,UDim.new(0,24)) stroke(rim,2,WHITE,.7)
-- reflet doux en haut
