adapter()
cam:GetPropertyChangedSignal("ViewportSize"):Connect(adapter)

-- messages au centre de l'écran (achat réussi, argent qui manque)
local messages = nouveau("ScreenGui", { Name = "BoutiqueMessages", ResetOnSpawn = false, DisplayOrder = 40 }, pgui)
local function son(id, vol)
	local s = nouveau("Sound", { SoundId = id, Volume = vol or 0.6 }, messages)
	s:Play()
	game:GetService("Debris"):AddItem(s, 4)
end
local function message(t, couleur, duree)
	local l = nouveau("TextLabel", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.fromScale(0.7, 0.1),
		Font = Enum.Font.LuckiestGuy, TextScaled = true, Text = t, TextColor3 = couleur,
	}, messages)
	local st = contour(l, 5)
	local sc = nouveau("UIScale", { Scale = 0 }, l)
	TweenService:Create(sc, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(duree, function()
		TweenService:Create(l, TweenInfo.new(0.3), { TextTransparency = 1, Position = UDim2.fromScale(0.5, 0.25) }):Play()
		TweenService:Create(st, TweenInfo.new(0.3), { Transparency = 1 }):Play()
		task.wait(0.35)
		l:Destroy()
	end)
end
local function trembler(o)
	task.spawn(function()
		local p0 = o.Position
		for i = 1, 6 do
			o.Position = p0 + UDim2.fromOffset(i % 2 == 0 and -8 or 8, 0)
			task.wait(0.04)
		end
		o.Position = p0
	end)
end

---------------------------------------------------------------- Caméra
local tourCamera = 0
local function bougerCamera(vers, duree, fin)
	tourCamera += 1
	local id = tourCamera
	local depart = cam.CFrame
	task.spawn(function()
		local t0 = os.clock()
		while tourCamera == id do
			local a = math.min((os.clock() - t0) / duree, 1)
			local e = if a < 0.5 then 4 * a * a * a else 1 - (-2 * a + 2) ^ 3 / 2 -- doux au début et à la fin
			cam.CFrame = depart:Lerp(vers, e)
			if a >= 1 then break end
			RunService.RenderStepped:Wait()
		end
		if tourCamera == id and fin then fin() end
	end)
end
-- où placer la caméra pour bien voir l'outil (un peu décalé : la fiche prend la gauche de l'écran)
local function cadrage(v)
	local centre = v.centre.Position
	local devant = v.base.CFrame.LookVector
	local ch = lp.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if hrp and (hrp.Position - centre):Dot(devant) < 0 then devant = -devant end -- du côté où se trouve le joueur
	devant = Vector3.new(devant.X, 0, devant.Z).Unit
	local largeur = math.max(v.taille.X, v.taille.Z, 1.5)
	local distance = math.max(largeur * 0.95, 3)
	local droite = (-devant):Cross(Vector3.yAxis).Unit -- la droite de l'écran
	local cible = centre - droite * largeur * 0.3
	local dir = (devant + Vector3.yAxis * v.article.hauteur).Unit
	return CFrame.lookAt(cible + dir * distance, cible)
end

---------------------------------------------------------------- Ouvrir / fermer la fiche
local courant = 1 -- outil affiché
local etat = {}
local fermeture = false

local function outilEnMain(v)
	local ch = lp.Character
	local t = ch and ch:FindFirstChildOfClass("Tool")
	return t ~= nil and t.Name == v.article.outil
end
local function styleBouton(v)
	if lp:GetAttribute(v.article.attribut) then
		-- déjà achetée : le bouton sert à la prendre en main
		peindre("or_")
		pieceBouton.Visible = false
		texteBouton.Text = outilEnMain(v) and "✓ EN MAIN" or "ÉQUIPER"
		texteBouton.TextSize = 54
	else
		peindre(argent() + 1e-6 >= v.prix() and "vert" or "gris")
		pieceBouton.Visible = true
		texteBouton.Text = argentTexte(v.prix())
		texteBouton.TextSize = 62
	end
end

local function remplir(v)
	local a = v.article
	nomOutil.Text = a.titre
	descOutil.Text = a.desc
	local n = tonumber(v.achat:GetAttribute("Touffes")) or 1
	valTouffes.Text = tostring(n)
	touffesMax.Text = a.touffesMax and ("jusqu'à " .. a.touffesMax .. " avec les boosts") or ""
	for _, c in rangee:GetChildren() do if c:IsA("ImageLabel") then c:Destroy() end end
	local taille = math.min(46, math.floor(300 / math.max(n, 1)))
	for i = 1, math.min(n, 12) do
		local im = nouveau("ImageLabel", { BackgroundTransparency = 1, Image = HERBE, ScaleType = Enum.ScaleType.Fit, Size = UDim2.fromOffset(taille, taille), LayoutOrder = i }, rangee)
		local sc = nouveau("UIScale", { Scale = 0 }, im)
		task.delay(0.25 + i * 0.05, function()
			TweenService:Create(sc, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		end)
	end
	local rayon = tonumber(v.achat:GetAttribute("Rayon")) or 5
	valPortee.Text = (rayon == math.floor(rayon)) and tostring(rayon) or string.format("%.1f", rayon)
	remplissage.Size = UDim2.fromScale(0, 1)
	TweenService:Create(remplissage, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.fromScale(math.clamp(rayon / 10, 0.08, 1), 1) }):Play()
	texteAmelio.Text = (a.ameliorations or 3) .. " AMÉLIORATIONS DANS BOOSTS"
	compteur.Text = courant .. " / " .. #vitrines
	nav.Visible = #vitrines > 1
	styleBouton(v)
end

local controles
local function bloquerControles(bloquer)
	if not controles then
		pcall(function()
			controles = require(lp:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()
		end)
	end
	if controles then pcall(function() if bloquer then controles:Disable() else controles:Enable() end end) end
end

-- souris libre (même si le jeu est en vue 1re personne) : réglée après les scripts de caméra, à chaque image
local function libererSouris(oui)
	pcall(function() RunService:UnbindFromRenderStep("BoutiqueSouris") end)
	if oui then
		RunService:BindToRenderStep("BoutiqueSouris", Enum.RenderPriority.Last.Value, function()
			UIS.MouseBehavior = Enum.MouseBehavior.Default
			UIS.MouseIconEnabled = true
		end)
	end
end

-- remet tout comme avant (aussi utilisé si une erreur arrive pendant l'ouverture)
local function restaurer()
	tourCamera += 1
	ecran.Enabled = false
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = etat.fov or 70
	for _, g in etat.guis or {} do if g.Parent then g.Enabled = true end end
	etat.guis = {}
	pcall(function() game:GetService("ProximityPromptService").Enabled = true end)
	lp:SetAttribute("MenuOuvert", false)
	bloquerControles(false)
	libererSouris(false)
	ouvert, fermeture = false, false
end

local function ouvrirInterne(v)
	ouvert = true
	libererSouris(true)
	for i, x in vitrines do if x == v then courant = i end end
	etat.cf, etat.type, etat.fov = cam.CFrame, cam.CameraType, cam.FieldOfView
	-- on cache le reste de l'interface et on bloque le personnage
	etat.guis = {}
	for _, g in pgui:GetChildren() do
		if g:IsA("ScreenGui") and g ~= ecran and g ~= messages and g.Enabled then
			g.Enabled = false
			table.insert(etat.guis, g)
		end
	end
	pcall(function() game:GetService("ProximityPromptService").Enabled = false end)
	lp:SetAttribute("MenuOuvert", true) -- pas de coupe pendant ce temps
	bloquerControles(true)
	for _, x in vitrines do x.contour.Enabled = false end
	-- la caméra se rapproche de l'outil
	local okC, cible = pcall(cadrage, v)
	if okC then
		cam.CameraType = Enum.CameraType.Scriptable
		cam.FieldOfView = 70
		bougerCamera(cible, REGLAGES.DUREE_CAMERA)
	else
		warn("[Boutique] Erreur de caméra : " .. tostring(cible))
	end
	-- la fiche arrive
	ecran.Enabled = true
	local okR, errR = pcall(remplir, v)
	if not okR then warn("[Boutique] Erreur en remplissant la fiche : " .. tostring(errR)) end
	voile.BackgroundTransparency = 1
	carte.Position = UDim2.new(0, -620, 0.5, 0)
	nav.Position = UDim2.new(0.66, 0, 1, 200)
	cadreArgent.Position = UDim2.new(1, -130, 0, -140)
	boutonX.Position = UDim2.new(1, -30, 0, -140)
	local info = TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	TweenService:Create(voile, TweenInfo.new(0.4), { BackgroundTransparency = 0 }):Play()
	task.delay(0.12, function()
		TweenService:Create(carte, info, { Position = UDim2.new(0, 50, 0.5, 0) }):Play()
		TweenService:Create(nav, info, { Position = UDim2.new(0.66, 0, 1, -36) }):Play()
		TweenService:Create(cadreArgent, info, { Position = UDim2.new(1, -130, 0, 34) }):Play()
		TweenService:Create(boutonX, info, { Position = UDim2.new(1, -30, 0, 28) }):Play()
	end)
	if UIS.GamepadEnabled then GuiService.SelectedObject = bouton end
end

local function ouvrir(v)
	if ouvert or fermeture or not v then return end
	local ok, err = pcall(ouvrirInterne, v)
	if not ok then
		warn("[Boutique] Erreur à l'ouverture de la fiche : " .. tostring(err))
		restaurer()
	end
end

local function fermer()
	if not ouvert or fermeture then return end
	fermeture = true
	GuiService.SelectedObject = nil
	local info = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(carte, info, { Position = UDim2.new(0, -620, 0.5, 0) }):Play()
	TweenService:Create(nav, info, { Position = UDim2.new(0.66, 0, 1, 200) }):Play()
	TweenService:Create(cadreArgent, info, { Position = UDim2.new(1, -130, 0, -140) }):Play()
	TweenService:Create(boutonX, info, { Position = UDim2.new(1, -30, 0, -140) }):Play()
	TweenService:Create(voile, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
	-- la caméra revient au joueur
	bougerCamera(etat.cf, 0.45, function()
		ecran.Enabled = false
		cam.CameraType = etat.type or Enum.CameraType.Custom
		cam.FieldOfView = etat.fov or 70
		for _, g in etat.guis or {} do if g.Parent then g.Enabled = true end end
		pcall(function() game:GetService("ProximityPromptService").Enabled = true end)
		lp:SetAttribute("MenuOuvert", false)
		bloquerControles(false)
		libererSouris(false)
		ouvert, fermeture = false, false
	end)
end

local function changer(delta)
	if not ouvert or fermeture or #vitrines < 2 then return end
	courant = (courant - 1 + delta) % #vitrines + 1
	local v = vitrines[courant]
	bougerCamera(cadrage(v), 0.5)
	-- la carte sort par la gauche et revient avec le nouvel outil
	TweenService:Create(carte, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(0, -620, 0.5, 0) }):Play()
	task.delay(0.15, function()
		remplir(v)
		TweenService:Create(carte, TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0, 50, 0.5, 0) }):Play()
	end)
end

local function acheter()
	local v = vitrines[courant]
	if not v then return end
	if lp:GetAttribute(v.article.attribut) then
		-- déjà achetée : on la prend en main et on retourne jouer
		local sac = lp:FindFirstChildOfClass("Backpack")
		local t = sac and sac:FindFirstChild(v.article.outil)
		local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		if t and h then h:EquipTool(t) end
		fermer()
		return
	end
	if argent() + 1e-6 < v.prix() then
		trembler(bouton)
		message("Il te manque " .. argentTexte(v.prix() - argent()), ROUGE, 1.6)
		return
	end
	v.achat:FireServer("acheter")
end

bouton.Activated:Connect(acheter)
boutonX.Activated:Connect(fermer)
gauche.Activated:Connect(function() changer(-1) end)
droite.Activated:Connect(function() changer(1) end)

UIS.InputBegan:Connect(function(input, gp)
	if ouvert then
		local k = input.KeyCode
		if k == Enum.KeyCode.Left or k == Enum.KeyCode.A or k == Enum.KeyCode.DPadLeft then changer(-1)
		elseif k == Enum.KeyCode.Right or k == Enum.KeyCode.D or k == Enum.KeyCode.DPadRight then changer(1)
		elseif k == Enum.KeyCode.Backspace or k == Enum.KeyCode.ButtonB or k == Enum.KeyCode.X then fermer() end
		return
	end
	if gp then return end
	-- clic / appui sur un outil de l'établi
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
		local pos = if t == Enum.UserInputType.Touch then input.Position else nil
		local cible
		if pos then
			local r = cam:ScreenPointToRay(pos.X, pos.Y)
			cible = (function()
				local ch = lp.Character
				local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
				local meilleur, dmin = nil, math.huge
				for _, v in vitrines do
					if hrp and (hrp.Position - v.centre.Position).Magnitude < REGLAGES.DISTANCE then
						local d = rayonBoite(r.Origin, r.Direction * 200, v.centre, v.taille + Vector3.new(0.5, 0.5, 0.5))
						if d and d < dmin then meilleur, dmin = v, d end
					end
				end
				return meilleur
			end)()
		end
		cible = cible or etat.survol
		if cible then ouvrir(cible) end
	end
end)

-- si on meurt pendant que la fiche est ouverte
lp.CharacterAdded:Connect(function() if ouvert then fermer() end end)

---------------------------------------------------------------- Chaque image : survol (contour blanc), prix, fiche
local function viser()
	if not UIS.MouseEnabled then return nil end
	local pos = if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then cam.ViewportSize / 2 else UIS:GetMouseLocation()
	local r = cam:ViewportPointToRay(pos.X, pos.Y)
	local ch = lp.Character
	local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	local meilleur, dmin = nil, math.huge
	for _, v in vitrines do
		if (hrp.Position - v.centre.Position).Magnitude < REGLAGES.DISTANCE then
			local d = rayonBoite(r.Origin, r.Direction * 200, v.centre, v.taille + Vector3.new(0.4, 0.4, 0.4))
			if d and d < dmin then meilleur, dmin = v, d end
		end
	end
	return meilleur
end

RunService.RenderStepped:Connect(function()
	for _, v in vitrines do majEtiquette(v) end
	if ouvert then
		UIS.MouseBehavior = Enum.MouseBehavior.Default
		UIS.MouseIconEnabled = true
		texteArgent.Text = argentTexte(argent())
		local v = vitrines[courant]
		if v then styleBouton(v) end
		return
	end
	local s = if lp:GetAttribute("IntroEnCours") then nil else viser()
	if s ~= etat.survol then
		if etat.survol then etat.survol.contour.Enabled = false end
		etat.survol = s
		if s then s.contour.Enabled = true end
	end
end)

---------------------------------------------------------------- Chargement des outils de l'établi
local function reponse(v, quoi, manque)
	if quoi == "ok" then
		son("rbxassetid://129348077985519", 0.7)
		message("✨ " .. string.upper(v.article.nom) .. " ACHETÉE ! ✨", OR, 2.2)
		if ouvert and vitrines[courant] == v then
			popBouton.Scale = 1.15
			TweenService:Create(popBouton, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
			for _, p in { popTouffes, popPortee } do
				p.Scale = 1.08
				TweenService:Create(p, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
			end
		end
	elseif quoi == "manque" then
		message("Il te manque " .. argentTexte(math.max(0, tonumber(manque) or 0)), ROUGE, 1.6)
		if ouvert then trembler(bouton) end
	end
end

for ordre, article in ARTICLES do
	task.spawn(function()
		local achat = ReplicatedStorage:WaitForChild(article.remote, 30)
		if not achat then return end -- cet outil n'est pas installé
		local modele = workspace:FindFirstChild(article.vitrine, true)
		for _ = 1, 30 do
			if modele then break end
			task.wait(1)
			modele = workspace:FindFirstChild(article.vitrine, true)
		end
		if not modele then return end
		local base = modele.PrimaryPart or modele:WaitForChild("Base", 10)
		if not base then return end
		task.wait(0.5) -- laisse toutes les pièces arriver
		local centre, taille = mesurer(modele, base)
		local v = { article = article, achat = achat, modele = modele, base = base, centre = centre, taille = taille, ordre = ordre }
		v.prix = function() return achat:GetAttribute("Prix") or 0 end
		v.contour = nouveau("Highlight", {
			Name = "Survol", Adornee = modele, FillColor = BLANC, FillTransparency = 0.88, OutlineColor = BLANC,
			OutlineTransparency = 0, DepthMode = Enum.HighlightDepthMode.Occluded, Enabled = false,
		}, modele)
		creerEtiquette(v)
		achat.OnClientEvent:Connect(function(quoi, manque) reponse(v, quoi, manque) end)
		-- E (clavier), bouton (manette / téléphone) : ouvre aussi la fiche
		local function brancher(p)
			if p:IsA("ProximityPrompt") then p.Triggered:Connect(function() ouvrir(v) end) end
		end
		for _, p in base:GetChildren() do brancher(p) end
		base.ChildAdded:Connect(brancher)
		table.insert(vitrines, v)
		table.sort(vitrines, function(a, b) return a.ordre < b.ordre end)
	end)
end

---------------------------------------------------------------- La débroussailleuse : tête qui tourne, moteur qui accélère
-- Au ralenti la tête tourne doucement. Quand on fauche ("EnCoupe" du serveur, ou tout de suite chez nous),
-- elle accélère : les fils deviennent un disque flou et l'herbe hachée + un peu de terre giclent devant.
local CollectionService = game:GetService("CollectionService")
local RALENTI, PLEIN_GAZ = 14, 75 -- vitesse de la tête (radians par seconde)
local tetes = setmetatable({}, { __mode = "k" }) -- [moteur] = { angle, vitesse, disque, fils, herbe, terre }

local function outilDe(m)
	local o = m:FindFirstAncestorOfClass("Tool")
	if o then return o end
	-- la copie affichée à la 1re personne (CiseauxVue) : c'est notre outil en main
	local ch = lp.Character
	return ch and ch:FindFirstChildOfClass("Tool")
end
local function enCoupe(o)
	if not o then return false end
	if o:GetAttribute("EnCoupe") then return true end
	local t = o:GetAttribute("CoupeLocale") -- mis par CiseauxVue dès notre clic (pas d'attente du serveur)
	return t ~= nil and os.clock() - t < 0.5
end
local function emetteur(parent, couleurs, taille, vitesse, taux)
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(couleurs[1], couleurs[2])
	e.Size = NumberSequence.new(taille, taille * 0.4)
	e.Squash = NumberSequence.new(1.6)
	e.Orientation = Enum.ParticleOrientation.VelocityParallel
	e.Lifetime = NumberRange.new(0.3, 0.55)
	e.Speed = NumberRange.new(vitesse * 0.7, vitesse)
	e.SpreadAngle = Vector2.new(70, 35)
	e.Acceleration = Vector3.new(0, -45, 0)
	e.Drag = 3
	e.RotSpeed = NumberRange.new(-300, 300)
	e.LightEmission = 0
	e.LightInfluence = 1
	e.Rate = 0
	e:SetAttribute("Taux", taux)
	e.Parent = parent
	return e
end
local function preparer(m)
	local pivot, handle = m.Part1, m.Part0
	if not (pivot and handle) then return nil end
	local modele = pivot.Parent
	-- copie de l'outil (vue 1re personne) : on enlève le disque et les projections copiés, on refait les nôtres
	for _, d in modele:GetChildren() do if d.Name == "DisqueFlou" then d:Destroy() end end
	for _, d in handle:GetChildren() do if d.Name == "Projections" then d:Destroy() end end
	local fils = {}
	local bobine
	for _, d in modele:GetChildren() do
		if d:IsA("BasePart") and d:GetAttribute("Tete") then
			if d.Name == "Fil" then table.insert(fils, d) elseif d.Name == "Bobine" then bobine = d end
		end
	end
	-- disque flou (les fils qui tournent très vite)
	local long = fils[1] and fils[1].Size.X or 1
	local disque = Instance.new("Part")
	disque.Name = "DisqueFlou"
	disque.Shape = Enum.PartType.Cylinder
	disque.Size = Vector3.new(0.03, long, long)
	disque.Color = Color3.fromRGB(245, 220, 120)
	disque.Material = Enum.Material.SmoothPlastic
	disque.Transparency = 1
	disque.CanCollide, disque.CanTouch, disque.CanQuery, disque.CastShadow = false, false, false, false
	disque.Massless = true
	disque.CFrame = (fils[1] and fils[1].CFrame or pivot.CFrame) * CFrame.Angles(0, 0, math.rad(90)) -- à plat, comme les fils
	local w = Instance.new("Weld")
	w.Part0, w.Part1 = pivot, disque
	w.C0 = pivot.CFrame:ToObjectSpace(disque.CFrame)
	w.Parent = disque
	disque.Parent = modele
	-- projections : repère fixe sur l'outil (pas sur la tête qui tourne), dirigé vers l'avant de la tête
	local at = Instance.new("Attachment")
	at.Name = "Projections"
	at.CFrame = m.C0 * CFrame.Angles(0, 0, math.rad(-90))
	at.Parent = handle
	local herbe = emetteur(at, { Color3.fromRGB(150, 220, 90), Color3.fromRGB(70, 150, 50) }, 0.3, 22, 150)
	local terre = emetteur(at, { Color3.fromRGB(122, 90, 58), Color3.fromRGB(86, 60, 36) }, 0.18, 14, 25)
	local e = { angle = math.random() * 6.28, vitesse = RALENTI, disque = disque, fils = fils, bobine = bobine, herbe = herbe, terre = terre }
	tetes[m] = e
	return e
end

RunService.RenderStepped:Connect(function(dt)
	for _, m in CollectionService:GetTagged("TeteDebroussailleuse") do
		-- seulement quand elle est en main (dans le monde), pas dans le sac
		if m:IsA("Motor6D") and m:IsDescendantOf(workspace) then
			local e = tetes[m] or preparer(m)
			if e then
				local coupe = enCoupe(outilDe(m))
				local cible = coupe and PLEIN_GAZ or RALENTI
				e.vitesse += (cible - e.vitesse) * math.min(dt * (coupe and 10 or 3), 1) -- ça monte vite, ça redescend doucement
				e.angle = (e.angle + e.vitesse * dt) % (2 * math.pi)
				m.Transform = CFrame.Angles(0, e.angle, 0)
				local k = math.clamp((e.vitesse - RALENTI) / (PLEIN_GAZ - RALENTI), 0, 1) -- 0 = ralenti, 1 = plein gaz
				local cache = e.bobine and e.bobine.LocalTransparencyModifier or 0 -- caché à la 1re personne (vraie débroussailleuse)
				e.disque.Transparency = 1 - 0.35 * k
				e.disque.LocalTransparencyModifier = cache
				for _, f in e.fils do f.LocalTransparencyModifier = math.max(cache, k > 0.5 and 1 or 0) end
				local actif = coupe and cache < 1
				e.herbe.Rate = actif and e.herbe:GetAttribute("Taux") or 0
				e.terre.Rate = actif and e.terre:GetAttribute("Taux") or 0
			end
		end
	end
end)

]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX74"><Properties><string name="Name">GrassClient</string><ProtectedString name="Source"><![CDATA[-- GrassClient (LocalScript dans StarterPlayerScripts)
-- ANTI-LAG : n'affiche que les touffes proches du joueur, construites petit à petit.
if not game:GetService("RunService"):IsClient() then
	warn("[Herbe] GrassClient doit être un LocalScript dans StarterPlayer > StarterPlayerScripts (pas un Script) !")
	return
end
print("[Herbe] GrassClient démarré")
local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local CS=game:GetService("CollectionService")
local UIS=game:GetService("UserInputService")
local lp=Players.LocalPlayer
local CFG=require(RS:WaitForChild("GrassConfig"))
local K=require(RS:WaitForChild("GrassKit"))
local remotes=RS:WaitForChild("GrassRemotes")
local cam=workspace.CurrentCamera
local pgui=lp:WaitForChild("PlayerGui")

-- ===== plateformes =====
-- TOUCH = téléphone / tablette (pas de clavier) ; manette = PlayStation / Xbox (ou manette sur PC)
local TOUCH=UIS.TouchEnabled and not UIS.KeyboardEnabled
local PADS={[Enum.UserInputType.Gamepad1]=true,[Enum.UserInputType.Gamepad2]=true,[Enum.UserInputType.Gamepad3]=true,[Enum.UserInputType.Gamepad4]=true}
local function usingGamepad() return PADS[UIS:GetLastInputType()]==true end
local function screenCenter() local v=cam.ViewportSize return Vector2.new(v.X/2,v.Y/2) end
local BB=TOUCH and .7 or 1 -- taille des bulles dans le monde (plus petites sur téléphone)
local function safeInsets(g) pcall(function() g.ScreenInsets=Enum.ScreenInsets.CoreUISafeInsets end) end

local BAG_IMAGE="rbxassetid://124953051791395"
local RENDER=CFG.RENDER_DIST or 120
local WHITE,RED=Color3.new(1,1,1),Color3.fromRGB(255,90,75)
local GREEN,GOLD=Color3.fromRGB(150,245,90),Color3.fromRGB(255,215,70)
local RARITY_TEXT={Or="✨ HERBE EN OR !",Diamant="💎 HERBE DIAMANT !",ArcEnCiel="🌈 HERBE ARC-EN-CIEL !"}
local fx=Instance.new("Folder") fx.Name="GrassFX" fx.Parent=workspace
local vis=Instance.new("Folder") vis.Name="GrassVisuals" vis.Parent=workspace
local hitF=Instance.new("Folder") hitF.Name="GrassHit" hitF.Parent=workspace

-- ===== outils =====
local function tween(d,f)
	local t0=os.clock()
	while true do
		local a=math.min((os.clock()-t0)/d,1)
		f(a)
		if a>=1 then return end
		Run.RenderStepped:Wait()
	end
end
local function outQuad(a) return 1-(1-a)^2 end
local function bez(a,b,c,t) return (1-t)^2*a+2*(1-t)*t*b+t*t*c end
local function stroke(o,th,col,border)
	local s=Instance.new("UIStroke") s.Thickness=th s.Color=col
	if border then s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border end
	s.Parent=o return s
end
local function corner(o,r) local c=Instance.new("UICorner") c.CornerRadius=r or UDim.new(1,0) c.Parent=o end
local function fxPart(cls,shape)
	local p=Instance.new(cls) if shape then p.Shape=shape end
	p.Material=Enum.Material.SmoothPlastic p.Anchored=true
	p.CanCollide=false p.CanQuery=false p.CanTouch=false p.CastShadow=false
	return p
end
local function sound(id,pos,vol)
	if not id or id=="" then return end
	local at=Instance.new("Attachment") at.Parent=workspace.Terrain at.WorldPosition=pos
	local s=Instance.new("Sound") s.SoundId=id s.Volume=vol or .6 s.Parent=at
	s:Play() game:GetService("Debris"):AddItem(at,4)
end
local function fmt(g) if g==math.floor(g) then return tostring(g) end return string.format("%.2f",g) end

-- ===== interface du sac (en bas à gauche, sans animation) =====
local gui=Instance.new("ScreenGui") gui.Name="GrassBagGui" gui.ResetOnSpawn=false safeInsets(gui)
gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling gui.Parent=pgui

local root=Instance.new("Frame") root.Name="Sac" root.AnchorPoint=Vector2.new(0,1)
root.Position=UDim2.new(0,16,1,-16)
root.Size=UDim2.fromOffset(150,172) root.BackgroundTransparency=1 root.Parent=gui
local uiScale=Instance.new("UIScale") uiScale.Parent=root
-- plus petit, et encore réduit sur téléphone / tablette
local function rescale()
	local s=math.clamp(cam.ViewportSize.Y/950,.4,1)
	if TOUCH then s=math.max(s*.8,.45) end
	uiScale.Scale=s
end
rescale() cam:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

local function bagImage(parent,color,transp)
	local i=Instance.new("ImageLabel") i.BackgroundTransparency=1 i.Image=BAG_IMAGE i.ScaleType=Enum.ScaleType.Fit
	i.Size=UDim2.fromOffset(140,140) i.ImageColor3=color or WHITE i.ImageTransparency=transp or 0 i.Parent=parent
	return i
end
local icon=Instance.new("Frame") icon.Name="Image" icon.AnchorPoint=Vector2.new(.5,0) icon.Position=UDim2.new(.5,0,0,0)
icon.Size=UDim2.fromOffset(140,140) icon.BackgroundTransparency=1 icon.Parent=root
local shadow=bagImage(icon,Color3.new(0,0,0),.6) shadow.Position=UDim2.fromOffset(4,6)
bagImage(icon,Color3.fromRGB(110,110,110),0)
local clip=Instance.new("Frame") clip.AnchorPoint=Vector2.new(0,1) clip.Position=UDim2.fromScale(0,1)
clip.Size=UDim2.fromScale(1,0) clip.BackgroundTransparency=1 clip.ClipsDescendants=true clip.Parent=icon
local full=bagImage(clip) full.AnchorPoint=Vector2.new(0,1) full.Position=UDim2.fromScale(0,1)

local count=Instance.new("TextLabel") count.Name="Compteur" count.AnchorPoint=Vector2.new(.5,.5) count.Position=UDim2.new(.5,0,0,92)
count.Size=UDim2.fromOffset(120,44) count.BackgroundTransparency=1 count.Font=Enum.Font.FredokaOne count.TextScaled=true
count.TextColor3=WHITE count.Text="0/"..CFG.BAG_CAPACITY count.ZIndex=3 count.Parent=root
local cs=stroke(count,4,Color3.fromRGB(15,15,15)) cs.LineJoinMode=Enum.LineJoinMode.Round

local toast=Instance.new("TextLabel") toast.AnchorPoint=Vector2.new(.5,1) toast.Position=UDim2.new(.5,0,1,-150)
toast.Size=UDim2.fromOffset(520,46) toast.BackgroundColor3=Color3.fromRGB(44,22,18) toast.BackgroundTransparency=.1
toast.Font=Enum.Font.FredokaOne toast.TextScaled=true toast.TextColor3=WHITE toast.Visible=false toast.Parent=gui
corner(toast,UDim.new(0,14)) stroke(toast,2.5,RED,true)
local pad=Instance.new("UIPadding") pad.PaddingLeft=UDim.new(0,16) pad.PaddingRight=UDim.new(0,16)
pad.PaddingTop=UDim.new(0,7) pad.PaddingBottom=UDim.new(0,7) pad.Parent=toast
local toastId=0
local function showToast(text)
	toastId+=1 local id=toastId
	toast.Text=text toast.Visible=true
	task.delay(2,function() if toastId==id then toast.Visible=false end end)
end

-- ===== texte de mutation (or / diamant / arc-en-ciel) =====
local STY={
	Or={a=Color3.fromRGB(255,248,170),b=Color3.fromRGB(255,165,30),st=Color3.fromRGB(95,50,0)},
	Diamant={a=Color3.fromRGB(240,255,255),b=Color3.fromRGB(80,190,255),st=Color3.fromRGB(10,45,95)},
	ArcEnCiel={st=Color3.fromRGB(45,20,70)},
}
local RAINBOW=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(255,90,90)),ColorSequenceKeypoint.new(.2,Color3.fromRGB(255,190,60)),
	ColorSequenceKeypoint.new(.4,Color3.fromRGB(250,250,90)),ColorSequenceKeypoint.new(.6,Color3.fromRGB(90,240,120)),
	ColorSequenceKeypoint.new(.8,Color3.fromRGB(90,170,255)),ColorSequenceKeypoint.new(1,Color3.fromRGB(210,110,255))})
local banner=Instance.new("Frame") banner.AnchorPoint=Vector2.new(.5,.5) banner.Position=UDim2.new(.5,0,0,120)
banner.Size=UDim2.fromOffset(620,110) banner.BackgroundTransparency=1 banner.Visible=false banner.Parent=gui
local bScale=Instance.new("UIScale") bScale.Parent=banner
local bTitle=Instance.new("TextLabel") bTitle.BackgroundTransparency=1 bTitle.Size=UDim2.fromScale(1,.66)
bTitle.Font=Enum.Font.FredokaOne bTitle.TextScaled=true bTitle.TextColor3=WHITE bTitle.Parent=banner
local bStroke=stroke(bTitle,5,Color3.new(0,0,0)) bStroke.LineJoinMode=Enum.LineJoinMode.Round
local bGrad=Instance.new("UIGradient") bGrad.Rotation=90 bGrad.Parent=bTitle
local bSub=Instance.new("TextLabel") bSub.BackgroundTransparency=1 bSub.Position=UDim2.fromScale(0,.64) bSub.Size=UDim2.fromScale(1,.34)
bSub.Font=Enum.Font.FredokaOne bSub.TextScaled=true bSub.TextColor3=WHITE bSub.Parent=banner
local sStroke=stroke(bSub,3.5,Color3.new(0,0,0)) sStroke.LineJoinMode=Enum.LineJoinMode.Round
local fitScale=1
local function fit() fitScale=math.clamp(cam.ViewportSize.X/1400,.4,1) end
fit() cam:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
do local sc=Instance.new("UIScale") sc.Parent=toast
	local function f2() sc.Scale=math.clamp(cam.ViewportSize.X/1400,.4,1) end f2() cam:GetPropertyChangedSignal("ViewportSize"):Connect(f2) end
local bannerId=0
local function showBanner(rarity,size)
	bannerId+=1 local id=bannerId
	local s=STY[rarity] or STY.Or
	bTitle.Text=RARITY_TEXT[rarity] or rarity
	bSub.Text="+"..size.." 🎒"
	bStroke.Color=s.st sStroke.Color=s.st
	bGrad.Rotation=rarity=="ArcEnCiel" and 0 or 90
	bGrad.Color=rarity=="ArcEnCiel" and RAINBOW or ColorSequence.new(s.a,s.b)
	for _,o in {bTitle,bSub} do o.TextTransparency=0 end bStroke.Transparency=0 sStroke.Transparency=0
	banner.Visible=true
	task.spawn(function()
		-- apparition "pop"
		tween(.28,function(a)
			if bannerId~=id then return end
			local e=a<.6 and (a/.6)*1.18 or 1.18-.18*((a-.6)/.4)
			bScale.Scale=fitScale*e
		end)
		-- l'arc-en-ciel défile, les autres brillent un peu
		local t0=os.clock()
		while bannerId==id and os.clock()-t0<1.5 do
			if rarity=="ArcEnCiel" then bGrad.Offset=Vector2.new(math.sin((os.clock()-t0)*3)*.3,0)
			else bScale.Scale=fitScale*(1+math.sin((os.clock()-t0)*6)*.02) end
			Run.RenderStepped:Wait()
		end
		-- disparition en fondu
		tween(.3,function(a)
			if bannerId~=id then return end
			bTitle.TextTransparency=a bSub.TextTransparency=a bStroke.Transparency=a sStroke.Transparency=a
			bScale.Scale=fitScale*(1-.15*a)
		end)
		if bannerId==id then banner.Visible=false end
	end)
end

local shown,pendingPicks,depositing=0,0,false
local function maxBag() return lp:GetAttribute("BagMax") or CFG.BAG_CAPACITY end
local function realBag() return lp:GetAttribute("Bag") or 0 end
local function refresh()
	local m=maxBag()
	shown=math.clamp(shown,0,m)
	count.Text=shown.."/"..m
	clip.Size=UDim2.fromScale(1,m>0 and shown/m or 0)
	count.TextColor3=shown>=m and RED or WHITE
end
local function sync() if pendingPicks==0 and not depositing then shown=realBag() refresh() end end
lp:GetAttributeChangedSignal("Bag"):Connect(sync)
lp:GetAttributeChangedSignal("BagMax"):Connect(refresh)
shown=realBag() refresh()

-- ===== argent (en bas à droite) =====
local COIN="rbxassetid://103593634628600"
-- (placé juste au-dessus du sac, en bas à gauche)
local mRoot=Instance.new("Frame") mRoot.Name="Argent" mRoot.AnchorPoint=Vector2.new(0,1)
mRoot.Size=UDim2.fromOffset(230,70) mRoot.BackgroundTransparency=1 mRoot.Parent=gui
local mScale=Instance.new("UIScale") mScale.Parent=mRoot
local function mFit()
	local s=math.clamp(cam.ViewportSize.Y/950,.45,1) if TOUCH then s=math.clamp(s,.45,.6) end mScale.Scale=s
	if TOUCH then
		-- téléphone / tablette : en haut à gauche (le joystick est en bas à gauche)
		mRoot.AnchorPoint=Vector2.new(0,0) mRoot.Position=UDim2.fromOffset(10,6)
		root.AnchorPoint=Vector2.new(0,0) root.Position=UDim2.fromOffset(10,6+70*s+2)
	else
		root.AnchorPoint=Vector2.new(0,1) root.Position=UDim2.new(0,16,1,-16)
		mRoot.AnchorPoint=Vector2.new(0,1) mRoot.Position=UDim2.new(0,16,1,-(16+172*uiScale.Scale+4))
	end
end
mFit() cam:GetPropertyChangedSignal("ViewportSize"):Connect(mFit) uiScale:GetPropertyChangedSignal("Scale"):Connect(mFit)
local mIcon=Instance.new("ImageLabel") mIcon.BackgroundTransparency=1 mIcon.Image=COIN mIcon.ScaleType=Enum.ScaleType.Fit
mIcon.AnchorPoint=Vector2.new(0,.5) mIcon.Position=UDim2.fromScale(0,.5) mIcon.Size=UDim2.fromOffset(70,70) mIcon.ZIndex=3 mIcon.Parent=mRoot
local mPop=Instance.new("UIScale") mPop.Parent=mIcon
local mText=Instance.new("TextLabel") mText.BackgroundTransparency=1 mText.AnchorPoint=Vector2.new(0,.5)
mText.Position=UDim2.new(0,76,.5,0) mText.Size=UDim2.fromOffset(160,54) mText.Font=Enum.Font.LuckiestGuy
mText.TextScaled=true mText.TextXAlignment=Enum.TextXAlignment.Left mText.Text="$0.00" mText.TextColor3=WHITE mText.ZIndex=3 mText.Parent=mRoot
local mst=stroke(mText,4,Color3.fromRGB(26,22,28)) mst.LineJoinMode=Enum.LineJoinMode.Round
local mg=Instance.new("UIGradient") mg.Rotation=90 mg.Color=ColorSequence.new(WHITE,Color3.fromRGB(255,228,140)) mg.Parent=mText
local mTextPop=Instance.new("UIScale") mTextPop.Parent=mText
task.spawn(function()
	local ls=lp:WaitForChild("leaderstats",20) if not ls then return end
	local mv
	for _=1,40 do
		if CFG.MONEY_STAT and CFG.MONEY_STAT~="" then mv=ls:FindFirstChild(CFG.MONEY_STAT) end
		if not mv then for _,n in {"Money","Cash","Argent","Coins","Dollars","$"} do mv=ls:FindFirstChild(n) if mv then break end end end
		if mv then break end task.wait(.25)
	end
	if not mv then return end
	local last=tonumber(mv.Value) or 0
	mText.Text=string.format("$%.2f",last)
	mv.Changed:Connect(function()
		local v=tonumber(mv.Value) or 0
		mText.Text=string.format("$%.2f",v)
		if v>last then
			mPop.Scale=1.35 game:GetService("TweenService"):Create(mPop,TweenInfo.new(.35,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Scale=1}):Play()
			mTextPop.Scale=1.2 game:GetService("TweenService"):Create(mTextPop,TweenInfo.new(.3,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Scale=1}):Play()
		end
		last=v
	end)
end)

-- ===== touffes affichées seulement près du joueur =====
local data={}      -- toutes les touffes de la partie (juste des infos)
local visible={}   -- [id] = {bl=modèle, hb=zone de clic, cf=position}
local queued={}
local queue={}
local gone={}      -- touffes déjà ramassées avant d'avoir reçu la liste
local rainbow={}

local function spawnVisual(e)
	local cf=CFrame.new(e.p)*CFrame.Angles(0,e.yaw,0)
	local bl=K.Build(cf,e.s,e.seed,true,e.r)
	bl.Name="Touffe" bl.Parent=vis
	local _,sz=bl:GetBoundingBox()
	local hb=Instance.new("Part") hb.Name="Hit" hb.Size=Vector3.new(sz.X+.4,math.max(sz.Y,1),sz.Z+.4)
	hb.CFrame=cf*CFrame.new(0,hb.Size.Y/2,0) hb.Transparency=1 hb.Anchored=true
	hb.CanCollide=false hb.CanTouch=false hb.CanQuery=true hb.CastShadow=false
	hb:SetAttribute("Id",e.id) hb.Parent=hitF
	local st=K.STYLE[e.r]
	if st and st.spark then
		local pe=Instance.new("ParticleEmitter")
		pe.Color=ColorSequence.new(st.spark)
		pe.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0),NumberSequenceKeypoint.new(.2,.35*e.s),NumberSequenceKeypoint.new(1,0)})
		pe.Lifetime=NumberRange.new(.8,1.2) pe.Rate=st.rate pe.Speed=NumberRange.new(.3,1)
		pe.SpreadAngle=Vector2.new(180,180) pe.LightEmission=1 pe.LightInfluence=0 pe.Parent=hb
	end
	if e.r=="ArcEnCiel" then rainbow[bl]=bl end
	visible[e.id]={bl=bl,hb=hb,cf=cf}
end
local function despawnVisual(id)
	local v=visible[id]
	if v then v.bl:Destroy() v.hb:Destroy() visible[id]=nil end
end

-- récupère la liste des touffes au démarrage
task.spawn(function()
	local list=remotes:WaitForChild("GetGrass"):InvokeServer()
	for _,a in list do
		local id=a[1]
		if not gone[id] then
			data[id]={id=id,p=Vector3.new(a[2],a[3],a[4]),yaw=a[5],s=a[6],r=a[7],seed=a[8],size=a[9]}
		end
	end
end)

-- une zone est terminée : l'herbe pousse dans la suivante
task.spawn(function()
	local newGrass=remotes:WaitForChild("NewGrass",60)
	if not newGrass then return end
	newGrass.OnClientEvent:Connect(function(list)
		for _,a in list do
			local id=a[1]
			if not gone[id] then
				data[id]={id=id,p=Vector3.new(a[2],a[3],a[4]),yaw=a[5],s=a[6],r=a[7],seed=a[8],size=a[9]}
			end
		end
		showToast("🌱 Zone terminée ! L'herbe a poussé dans la zone suivante")
	end)
end)

-- TEST (seulement dans Studio) : touche K = finir la zone en cours d'un coup
if Run:IsStudio() then
	UIS.InputBegan:Connect(function(input,gp)
		if gp or input.KeyCode~=Enum.KeyCode.K then return end
		local r=remotes:FindFirstChild("TestFinirZone")
		if r then r:FireServer() showToast("🧪 TEST : zone terminée !") end
	end)
end

-- toutes les 0.3 s : on affiche ce qui est proche, on retire ce qui est loin
task.spawn(function()
	while true do
		local ch=lp.Character
		local hrp=ch and ch:FindFirstChild("HumanoidRootPart")
		local c=hrp and hrp.Position or cam.CFrame.Position
		for id,e in data do
			local d=(e.p-c).Magnitude
			if d<RENDER then
				if not visible[id] and not queued[id] then queued[id]=true table.insert(queue,id) end
			elseif d>RENDER+20 and visible[id] then
				despawnVisual(id)
			end
		end
		task.wait(.3)
	end
end)
-- on construit max 8 touffes par image (pas de freeze)
Run.Heartbeat:Connect(function()
	local n=0
	while #queue>0 and n<8 do
		local id=table.remove(queue)
		queued[id]=nil
		local e=data[id]
		if e and not visible[id] then spawnVisual(e) n+=1 end
	end
end)

-- couleurs arc-en-ciel qui défilent
local acc=0
Run.Heartbeat:Connect(function(dt)
	acc+=dt if acc<1/20 then return end acc=0
	local tt=os.clock()*.25
	for key,bl in rainbow do
		if not key.Parent then rainbow[key]=nil else
			for _,p in bl:GetChildren() do
				local h=p:GetAttribute("Hue")
				if h then p.Color=K.RainbowColor((h+tt)%1,p:GetAttribute("Tone")) end
			end
		end
	end
end)

-- ===== survol + clic (sans ClickDetector) =====
local hl=Instance.new("Highlight")
hl.FillColor=WHITE hl.OutlineColor=WHITE hl.FillTransparency=.88 hl.OutlineTransparency=0
hl.DepthMode=Enum.HighlightDepthMode.Occluded hl.Enabled=false hl.Parent=fx
local hovered
local rp=RaycastParams.new() rp.FilterType=Enum.RaycastFilterType.Exclude
local function idFromRay(ray)
	local ex={fx,vis}
	if lp.Character then table.insert(ex,lp.Character) end
	rp.FilterDescendantsInstances=ex
	local hit=workspace:Raycast(ray.Origin,ray.Direction*250,rp)
	if hit and hit.Instance.Parent==hitF then return hit.Instance:GetAttribute("Id") end
end
-- on ne coupe l'herbe qu'avec les ciseaux en main (et pas pendant que le menu des améliorations est ouvert)
local function holdingScissors()
	if lp:GetAttribute("MenuOuvert") then return false end
	local ch=lp.Character
	local tool=ch and ch:FindFirstChildOfClass("Tool")
	return tool~=nil and (CS:HasTag(tool,"OutilCiseaux") or CS:HasTag(tool,"OutilFaucille") or tool.Name=="Ciseaux" or tool:GetAttribute("CoupeEnPlus")~=nil)
end
-- chaque outil a ses améliorations : ciseaux (Maintenir, Dextérité, Saisir) / faucille (FMaintenir, FRapidite, FCoupe)
local function holdingRealScissors()
	local ch=lp.Character
	local tool=ch and ch:FindFirstChildOfClass("Tool")
	return tool~=nil and (CS:HasTag(tool,"OutilCiseaux") or tool.Name=="Ciseaux")
end
-- préfixe des améliorations de l'outil en main : F = faucille, D = débroussailleuse (nil = ciseaux)
local function toolPrefix()
	local ch=lp.Character
	local tool=ch and ch:FindFirstChildOfClass("Tool")
	if not tool then return nil end
	return tool:GetAttribute("Prefixe") or ((CS:HasTag(tool,"OutilFaucille") or tool.Name=="Faucille") and "F") or nil
end
local function holdingSickle() return toolPrefix()~=nil end
local function speedLevel()
	if holdingRealScissors() then return lp:GetAttribute("Upg_Dexterite") or 0 end
	local pre=toolPrefix()
	if pre then return lp:GetAttribute("Upg_"..pre.."Rapidite") or 0 end
	return 0
end
local function canHold()
	if holdingRealScissors() then return (lp:GetAttribute("Upg_Maintenir") or 0)>=1 end
	local pre=toolPrefix()
	if pre then return (lp:GetAttribute("Upg_"..pre.."Maintenir") or 0)>=1 end
	return false
end
local function setHover(id)
	hovered=id
	local v=id and visible[id]
	local e=id and data[id]
	if not (v and e) then hl.Enabled=false hl.Adornee=nil return end
	local col=(realBag()+e.size>maxBag()) and RED or (K.OUTLINE[e.r] or WHITE)
	hl.OutlineColor=col hl.FillColor=col hl.Adornee=v.bl hl.Enabled=true
end
-- ===== curseur en forme de ciseaux (quand on les tient) =====
local curGui=Instance.new("ScreenGui") curGui.Name="CurseurCiseaux" curGui.ResetOnSpawn=false
curGui.IgnoreGuiInset=true curGui.DisplayOrder=100 curGui.Parent=pgui
local cursor=Instance.new("Frame") cursor.Name="Ciseaux" cursor.AnchorPoint=Vector2.new(.5,.5)
cursor.Size=UDim2.fromOffset(44,44) cursor.BackgroundTransparency=1 cursor.Visible=false cursor.Parent=curGui
local TAILLE_CURSEUR=0.7  -- taille du curseur ciseaux (0.8 = plus petit, 1.2 = plus grand)
local cScale=Instance.new("UIScale") cScale.Scale=TAILLE_CURSEUR cScale.Parent=cursor
local OPEN=27           -- ouverture des lames (degrés)
local branches,tinted={},{}
local snipT=-math.huge
local function drawScissors(col,offset,transp)
	local layer=Instance.new("Frame") layer.BackgroundTransparency=1 layer.Size=UDim2.fromScale(1,1)
	layer.Position=UDim2.fromOffset(offset,offset) layer.Parent=cursor
	for _,s in {1,-1} do
		-- une branche = une lame en haut + un anneau en bas, qui tourne autour de la vis
		local h=Instance.new("Frame") h.BackgroundTransparency=1 h.AnchorPoint=Vector2.new(.5,.5)
		h.Position=UDim2.fromScale(.5,.5) h.Size=UDim2.fromOffset(16,50) h.Rotation=s*OPEN h.Parent=layer
		local blade=Instance.new("Frame") blade.BorderSizePixel=0 blade.BackgroundColor3=col blade.BackgroundTransparency=transp
		blade.AnchorPoint=Vector2.new(.5,1) blade.Position=UDim2.new(.5,0,.5,0) blade.Size=UDim2.fromOffset(5,22) blade.Parent=h
		corner(blade)
		local shank=Instance.new("Frame") shank.BorderSizePixel=0 shank.BackgroundColor3=col shank.BackgroundTransparency=transp
		shank.AnchorPoint=Vector2.new(.5,0) shank.Position=UDim2.new(.5,0,.5,-1) shank.Size=UDim2.fromOffset(3,12) shank.Parent=h
		local ring=Instance.new("Frame") ring.BackgroundTransparency=1 ring.AnchorPoint=Vector2.new(.5,1)
		ring.Position=UDim2.fromScale(.5,1) ring.Size=UDim2.fromOffset(12,12) ring.Parent=h
		corner(ring)
		local rs=stroke(ring,3,col) rs.Transparency=transp
		table.insert(branches,{h=h,s=s})
		if offset==0 then table.insert(tinted,blade) table.insert(tinted,shank) table.insert(tinted,rs) end
	end
end
drawScissors(Color3.new(0,0,0),2,.55) -- ombre douce
drawScissors(WHITE,0,0)
local cursorShown,savedMouseIcon=false,true
local function updateCursor(m,pad)
	-- visible seulement quand on vise de l'herbe (et un court instant après la coupe pour le clic-clac)
	local e=hovered and visible[hovered] and data[hovered]
	local show=(UIS.MouseEnabled or pad) and holdingScissors() and (e~=nil or os.clock()-snipT<.2)
	if show~=cursorShown then
		cursorShown=show cursor.Visible=show
		if show then savedMouseIcon=UIS.MouseIconEnabled UIS.MouseIconEnabled=false
		else UIS.MouseIconEnabled=savedMouseIcon end
	end
	if not show then return end
	cursor.Position=UDim2.fromOffset(m.X,m.Y)
	-- toujours blanc (rouge seulement si le sac est trop plein pour cette touffe)
	local col=(e and realBag()+e.size>maxBag()) and RED or WHITE
	for _,o in tinted do if o:IsA("UIStroke") then o.Color=col else o.BackgroundColor3=col end end
	-- clic-clac des lames
	local t=(os.clock()-snipT)/.16
	local ang=(t>=0 and t<1) and OPEN*(1-.85*math.sin(t*math.pi)) or OPEN
	for _,b in branches do b.h.Rotation=b.s*ang end
end
Run.RenderStepped:Connect(function()
	-- manette : on vise au centre de l'écran ; souris : là où est la souris
	local pad=usingGamepad()
	local m=pad and screenCenter() or UIS:GetMouseLocation()
	if UIS.MouseEnabled or pad then
		local id=holdingScissors() and idFromRay(cam:ViewportPointToRay(m.X,m.Y)) or nil
		if id~=hovered then setHover(id) end
	elseif hovered then setHover(nil) end
	updateCursor(m,pad)
end)
-- clic avec les ciseaux = coupe l'herbe visée ; amélioration "Maintenir" = rester appuyé coupe en continu là où tu vises
local holding,holdInput=false,nil
local lastHint=0
local requestCut -- (défini plus bas) : demande la coupe + coupe tout de suite chez nous quand les lames se ferment
local lastCut=-math.huge
UIS.InputBegan:Connect(function(input,gp)
	local t=input.UserInputType
	local pad=input.KeyCode==Enum.KeyCode.ButtonR2 -- gâchette droite (PlayStation R2 / Xbox RT)
	if (gp and not pad) or UIS:GetFocusedTextBox() or lp:GetAttribute("MenuOuvert") then return end
	if t==Enum.UserInputType.MouseButton1 or t==Enum.UserInputType.Touch or pad then
		holding=true holdInput=input
		local ray
		if pad then local c=screenCenter() ray=cam:ViewportPointToRay(c.X,c.Y)
		else ray=cam:ScreenPointToRay(input.Position.X,input.Position.Y) end
		local id=idFromRay(ray)
		if id then
			if holdingScissors() then
				-- pas de spam : on ne peut recouper qu'une fois le délai passé (même délai que le serveur)
				local dex=speedLevel()
				local cd=math.max(.2,(CFG.PICK_COOLDOWN or .9)*(1-(CFG.DEX_PAR_NIVEAU or .08)*dex))
				if os.clock()-lastCut>=cd then lastCut=os.clock() snipT=os.clock() requestCut(id) end
			elseif os.clock()-lastHint>2 then lastHint=os.clock() showToast("✂️ Prends tes ciseaux pour couper l'herbe !") end
		end
	end
end)
UIS.InputEnded:Connect(function(input)
	if input==holdInput or input.UserInputType==Enum.UserInputType.MouseButton1 or input.KeyCode==Enum.KeyCode.ButtonR2 then holding=false holdInput=nil end
end)
task.spawn(function()
	while true do
		local dex=speedLevel()
		local cd=math.max(.2,(CFG.PICK_COOLDOWN or .9)*(1-(CFG.DEX_PAR_NIVEAU or .08)*dex))
		task.wait(cd+.05)
		if holding and canHold() and holdingScissors() then
			local hi,ray=holdInput,nil
			if hi and hi.KeyCode==Enum.KeyCode.ButtonR2 then local c=screenCenter() ray=cam:ViewportPointToRay(c.X,c.Y)
			elseif hi and hi.UserInputType==Enum.UserInputType.Touch then ray=cam:ScreenPointToRay(hi.Position.X,hi.Position.Y)
			else local m=UIS:GetMouseLocation() ray=cam:ViewportPointToRay(m.X,m.Y) end
			local id=idFromRay(ray)
			if id then lastCut=os.clock() requestCut(id) end
		end
	end
end)

-- ===== effets dans le monde =====
local DIRT={Color3.fromRGB(104,74,46),Color3.fromRGB(86,60,36),Color3.fromRGB(122,90,58)}
local function burst(pos,nDirt,nGrass,power,col)
	local bits={}
	for i=1,nDirt+nGrass do
		local g=i>nDirt
		local p=fxPart(g and "WedgePart" or "Part")
		local sz=math.random(10,20)/100
		p.Size=g and Vector3.new(.05,.35,.14) or Vector3.new(sz,sz,sz)
		if g then
			if col=="rainbow" then p.Color=Color3.fromHSV(math.random(),.7,1)
			elseif col then p.Color=col
			else p.Color=Color3.fromRGB(110+math.random(0,40),185+math.random(0,40),45) end
		else p.Color=DIRT[math.random(1,3)] end
		p.CFrame=CFrame.new(pos) p.Parent=fx
		local a=math.random()*math.pi*2
		local s=math.random(20,60)/10*power
		bits[i]={p=p,v=Vector3.new(math.cos(a)*s,math.random(60,110)/10*power,math.sin(a)*s),
			r=Vector3.new(math.random(-15,15),math.random(-15,15),math.random(-15,15)),s=p.Size}
	end
	task.spawn(function()
		tween(.65,function(a)
			local t=a*.65
			for _,b in bits do
				b.p.CFrame=CFrame.new(pos+b.v*t+Vector3.new(0,-26*t*t,0))*CFrame.Angles(b.r.X*t,b.r.Y*t,b.r.Z*t)
				if a>.55 then b.p.Size=b.s*math.max(1-(a-.55)/.45,.01) end
			end
		end)
		for _,b in bits do b.p:Destroy() end
	end)
end

local function puffs(pos)
	for i=1,6 do
		local a=i/6*math.pi*2+math.random()*.5
		local p=fxPart("Part",Enum.PartType.Ball)
		p.Size=Vector3.new(.4,.4,.4) p.Color=Color3.fromRGB(196,170,130) p.Transparency=.3
		p.CFrame=CFrame.new(pos) p.Parent=fx
		local dir=Vector3.new(math.cos(a),.35,math.sin(a))
		task.spawn(function()
			tween(.55,function(t)
				local e=outQuad(t)
				p.CFrame=CFrame.new(pos+dir*1.4*e+Vector3.new(0,.2,0))
				local s=.4+1.1*e p.Size=Vector3.new(s,s,s) p.Transparency=.3+.7*t
			end)
			p:Destroy()
		end)
	end
end

local function popupAt(pos,text,color)
	local at=Instance.new("Attachment") at.Parent=workspace.Terrain at.WorldPosition=pos
	local g=Instance.new("BillboardGui") g.Adornee=at g.Size=UDim2.fromOffset(180*BB,90*BB) g.AlwaysOnTop=true g.LightInfluence=0 g.ResetOnSpawn=false
	local t=Instance.new("TextLabel") t.Size=UDim2.fromScale(1,1) t.BackgroundTransparency=1
	t.Text=text t.Font=Enum.Font.FredokaOne t.TextScaled=true t.TextColor3=color t.Parent=g
	local st=stroke(t,3,Color3.fromRGB(20,40,12))
	g.Parent=pgui
	task.spawn(function()
		tween(1,function(a)
			g.StudsOffset=Vector3.new(0,a*2.4,0)
			local f=math.clamp((a-.55)/.45,0,1) t.TextTransparency=f st.Transparency=f
		end)
		g:Destroy() at:Destroy()
	end)
end

-- ===== bras du joueur (lancer dans le composteur) =====
local armOrig=setmetatable({},{__mode="k"})
local armId=0
local function armAnim(steps)
	local ch=lp.Character if not ch then return end
	local m,r15
	local ua=ch:FindFirstChild("RightUpperArm")
	if ua and ua:FindFirstChild("RightShoulder") then m=ua.RightShoulder r15=true
	elseif ch:FindFirstChild("Torso") and ch.Torso:FindFirstChild("Right Shoulder") then m=ch.Torso["Right Shoulder"] end
	if not m or not m:IsA("Motor6D") then return end
	armOrig[m]=armOrig[m] or m.C0
	local c0=armOrig[m]
	armId+=1 local id=armId
	local cur=0
	local function set(x)
		if armId~=id then return end
		cur=x
		pcall(function() m.C0=c0*(r15 and CFrame.Angles(x,0,0) or CFrame.Angles(0,0,x)) end)
	end
	for _,s in steps do
		local from=cur
		tween(s[1],function(a) set(from+(s[2]-from)*outQuad(a)) end)
	end
	if armId==id then pcall(function() m.C0=c0 end) end
end

-- ===== coupe aux ciseaux : effets =====
local SNIP_SOUND="rbxassetid://135446324303740" -- son de l'herbe coupée (remplacé par PICK_SOUND si tu en mets un)
local function snipSound(pos)
	local id=(CFG.PICK_SOUND and CFG.PICK_SOUND~="") and CFG.PICK_SOUND or SNIP_SOUND
	local at=Instance.new("Attachment") at.Parent=workspace.Terrain at.WorldPosition=pos
	local s=Instance.new("Sound") s.SoundId=id s.Volume=.6 s.PlaybackSpeed=.95+math.random()*.1 s.RollOffMaxDistance=60 s.Parent=at
	s:Play() game:GetService("Debris"):AddItem(at,3)
end
local function leafColor(m)
	for _,p in m:GetDescendants() do if p:IsA("BasePart") then return p.Color end end
	return Color3.fromRGB(110,190,50)
end
-- deux lames blanches qui se referment sur la touffe
local function slash(center,w)
	local right=Vector3.new(cam.CFrame.RightVector.X,0,cam.CFrame.RightVector.Z)
	if right.Magnitude<.01 then right=Vector3.new(1,0,0) end
	right=right.Unit
	local len=math.max(w,.8)*1.25
	local pivot=center-right*len/2
	local look=CFrame.lookAt(pivot,pivot+right)
	local blades={}
	for s=-1,1,2 do
		local b=fxPart("Part") b.Material=Enum.Material.Neon b.Color=Color3.new(1,1,1) b.Transparency=.05
		b.Size=Vector3.new(.06,.06,len) b.Parent=fx
		table.insert(blades,{p=b,s=s})
	end
	task.spawn(function()
		tween(.08,function(a)
			for _,bd in blades do
				bd.p.CFrame=look*CFrame.Angles(bd.s*math.rad(30)*(1-outQuad(a)),0,0)*CFrame.new(0,0,-len/2)
			end
		end)
		tween(.2,function(a)
			for _,bd in blades do
				local t=.06*(1-a)+.01
				bd.p.Size=Vector3.new(t,t,len*(1+.15*a)) bd.p.Transparency=.05+.95*a
				bd.p.CFrame=look*CFrame.new(0,0,-len/2)
			end
		end)
		for _,bd in blades do bd.p:Destroy() end
	end)
end
-- petit chaume coupé qui reste au sol quelques secondes
-- ===== débroussailleuse : l'herbe est broyée et projetée (pas coupée net) =====
local function holdsTrimmer(plr)
	local ch=plr and plr.Character
	local t=ch and ch:FindFirstChildOfClass("Tool")
	return t~=nil and (CS:HasTag(t,"OutilDebroussailleuse") or t.Name=="Debroussailleuse")
end
-- brins hachés projetés dans le sens de rotation de la tête (+ un peu de terre)
local function shred(pos,col,dir,n,rarityCol)
	local side=dir:Cross(Vector3.new(0,1,0)).Unit
	local bits={}
	for i=1,n do
		local dirt=i<=math.floor(n/6)
		local p=fxPart("Part")
		if dirt then
			local d=math.random(8,15)/100 p.Size=Vector3.new(d,d,d) p.Color=DIRT[math.random(1,3)]
		else
			p.Size=Vector3.new(.05,.05,math.random(14,32)/100)
			if rarityCol=="rainbow" then p.Color=Color3.fromHSV(math.random(),.7,1)
			elseif rarityCol then p.Color=rarityCol
			else p.Color=col:Lerp(Color3.fromRGB(150+math.random(0,60),220,90),math.random()*.5) end
		end
		p.CFrame=CFrame.new(pos+Vector3.new((math.random()-.5)*.3,(math.random()-.2)*.25,(math.random()-.5)*.3)) p.Parent=fx
		-- projetés sur le côté (rotation du fil) et vers l'avant, assez bas
		local v=side*math.random(50,120)/10+dir*math.random(10,50)/10+Vector3.new((math.random()-.5)*3,math.random(20,55)/10,(math.random()-.5)*3)
		bits[i]={p=p,v=v,r=Vector3.new(math.random(-25,25),math.random(-25,25),math.random(-25,25)),s=p.Size}
	end
	task.spawn(function()
		tween(.55,function(a)
			local t=a*.55
			for _,b in bits do
				b.p.CFrame=CFrame.new(pos+b.v*t*(1-.35*a)+Vector3.new(0,-24*t*t,0))*CFrame.Angles(b.r.X*t,b.r.Y*t,b.r.Z*t)
				if a>.5 then b.p.Size=b.s*math.max(1-(a-.5)/.5,.01) end
			end
		end)
		for _,b in bits do b.p:Destroy() end
	end)
end
-- petit nuage vert (poussière d'herbe hachée)
local function greenDust(pos,col)
	for i=1,4 do
		local a=i/4*math.pi*2+math.random()*.6
		local p=fxPart("Part",Enum.PartType.Ball)
		p.Size=Vector3.new(.3,.3,.3) p.Color=col:Lerp(Color3.fromRGB(200,230,150),.5) p.Transparency=.45
		p.CFrame=CFrame.new(pos) p.Parent=fx
		local dir=Vector3.new(math.cos(a),.5,math.sin(a))
		task.spawn(function()
			tween(.45,function(t)
				local e=outQuad(t)
				p.CFrame=CFrame.new(pos+dir*.9*e)
				local s=.3+.9*e p.Size=Vector3.new(s,s,s) p.Transparency=.45+.55*t
			end)
			p:Destroy()
		end)
	end
end
local lastTrim=0
local function trimSound(pos)
	if os.clock()-lastTrim<.09 then return end -- 6 à 10 touffes d'un coup : un seul bruit
	lastTrim=os.clock()
	local id=(CFG.PICK_SOUND and CFG.PICK_SOUND~="") and CFG.PICK_SOUND or SNIP_SOUND
	local at=Instance.new("Attachment") at.Parent=workspace.Terrain at.WorldPosition=pos
	local s=Instance.new("Sound") s.SoundId=id s.Volume=.45 s.PlaybackSpeed=1.35+math.random()*.2 s.RollOffMaxDistance=60 s.Parent=at
	s:Play() game:GetService("Debris"):AddItem(at,3)
end

local function stubble(cf,w,h,col)
	local m=Instance.new("Model") m.Name="Chaume"
	local parts={}
	for i=1,7 do
		local a=i/7*math.pi*2+math.random()*.6
		local r=math.random()*math.max(w,.4)*.3
		local hh=h*(.75+math.random()*.25)
		local stem=fxPart("Part") stem.Size=Vector3.new(.08,hh,.08) stem.Color=col:Lerp(Color3.new(0,0,0),.15)
		stem.CFrame=cf*CFrame.new(math.cos(a)*r,hh/2,math.sin(a)*r)*CFrame.Angles(math.random()*.24-.12,math.random()*6.28,math.random()*.24-.12)
		stem.Parent=m
		local tip=fxPart("Part") tip.Size=Vector3.new(.085,.02,.085) tip.Color=col:Lerp(Color3.fromRGB(255,255,210),.5) -- tranche nette
		tip.CFrame=stem.CFrame*CFrame.new(0,hh/2,0) tip.Parent=m
		table.insert(parts,stem) table.insert(parts,tip)
	end
	m.Parent=fx
	task.delay(4,function()
		local p0=m:GetPivot()
		tween(.6,function(a)
			m:PivotTo(p0*CFrame.new(0,-h*a,0))
			for _,p in parts do p.Transparency=a end
		end)
		m:Destroy()
	end)
end

-- "+1" / "+5"... en blanc qui vient vers le joueur
local function gainPopup(pos,n)
	local at=Instance.new("Attachment") at.Parent=workspace.Terrain at.WorldPosition=pos
	local g=Instance.new("BillboardGui") g.Adornee=at g.Size=UDim2.fromOffset(90*BB,44*BB) g.AlwaysOnTop=true g.LightInfluence=0 g.ResetOnSpawn=false
	local t=Instance.new("TextLabel") t.Size=UDim2.fromScale(1,1) t.BackgroundTransparency=1 t.Text="+"..n
	t.Font=Enum.Font.FredokaOne t.TextScaled=true t.TextColor3=WHITE t.Parent=g
	local st=stroke(t,2,Color3.fromRGB(20,24,20)) st.Transparency=.3
	local sc=Instance.new("UIScale") sc.Parent=t
	g.Parent=pgui
	task.spawn(function()
		tween(.15,function(a) sc.Scale=.4+.8*outQuad(a) end) -- petit "pop"
		local p0=at.WorldPosition
		tween(.55,function(a)
			local ch=lp.Character local hrp=ch and ch:FindFirstChild("HumanoidRootPart")
			local tgt=hrp and hrp.Position+Vector3.new(0,1.5,0) or p0+Vector3.new(0,2,0)
			at.WorldPosition=p0:Lerp(tgt,a*a)
			sc.Scale=1.2-.5*a
			local f=math.clamp((a-.6)/.4,0,1) t.TextTransparency=f st.Transparency=.3+.7*f
		end)
		g:Destroy() at:Destroy()
	end)
end

-- ===== coupe d'une touffe =====
local function cutVisual(id,picker,size,rarity)
	size=size or 1
	rarity=rarity or "Normal"
	local mine=picker==lp
	if not data[id] then gone[id]=true end
	data[id]=nil queued[id]=nil
	local v=visible[id] visible[id]=nil
	if hovered==id then setHover(nil) end
	if mine then
		snipT=os.clock() -- le curseur fait clic-clac
		pendingPicks+=1
	end
	local function arrived()
		if not mine then return end
		pendingPicks=math.max(0,pendingPicks-1)
		shown+=size refresh()
		if pendingPicks==0 and not depositing and shown~=realBag() then shown=realBag() refresh() end
	end
	if not v then arrived() return end
	v.hb:Destroy()
	local fake,P=v.bl,v.cf
	fake.Parent=fx
	local base=fake:GetScale()
	local _,sz=fake:GetBoundingBox()
	local h=math.max(sz.Y,.5)
	local cutH=math.clamp(h*.18,.12,.4)          -- hauteur de la coupe
	local cutPos=P.Position+Vector3.new(0,cutH,0)
	local col=leafColor(fake)
	if mine then gainPopup(cutPos+Vector3.new(0,.8,0),size) end
	if holdsTrimmer(picker) then
		-- DÉBROUSSAILLEUSE : le fil hache la touffe, les brins giclent sur le côté, il reste un chaume ras
		local hrp1=picker.Character and picker.Character:FindFirstChild("HumanoidRootPart")
		local dir=hrp1 and Vector3.new(P.Position.X-hrp1.Position.X,0,P.Position.Z-hrp1.Position.Z) or Vector3.zero
		if dir.Magnitude<.1 then local a=math.random()*math.pi*2 dir=Vector3.new(math.cos(a),0,math.sin(a)) end
		dir=dir.Unit
		local low=P.Position+Vector3.new(0,cutH*.5,0)
		trimSound(low)
		stubble(P,math.min(sz.X,sz.Z),cutH*.6,col)
		local rc=(rarity=="ArcEnCiel" and "rainbow") or (rarity~="Normal" and K.OUTLINE[rarity]) or nil
		shred(low+Vector3.new(0,h*.25,0),col,dir,rarity=="Normal" and 16 or 22,rc)
		greenDust(low+Vector3.new(0,.2,0),col)
		-- la touffe est déchiquetée : elle tremble, tourne et rétrécit en volant en morceaux
		local side=dir:Cross(Vector3.new(0,1,0)).Unit
		local top=P*CFrame.new(0,cutH*.6,0)
		fake:PivotTo(top)
		task.spawn(function()
			local spin=math.random()*6.28
			tween(.16,function(a)
				local j=Vector3.new((math.random()-.5)*.12,0,(math.random()-.5)*.12)
				fake:PivotTo(CFrame.new(top.Position+side*.9*a+Vector3.new(0,.25*a,0)+j)*CFrame.Angles(0,spin+a*9,a*1.2)*top.Rotation)
				fake:ScaleTo(base*math.max(1-a,.05))
			end)
			fake:Destroy()
			arrived()
		end)
		return
	end
	-- 1) les lames se referment : "snip"
	snipSound(cutPos)
	slash(cutPos,math.max(sz.X,sz.Z))
	-- 2) il reste un petit chaume coupé au sol
	stubble(P,math.min(sz.X,sz.Z),cutH,col)
	-- 3) des petits brins coupés volent (pas de terre : on ne l'arrache pas)
	if rarity=="ArcEnCiel" then burst(cutPos,0,12,.45,"rainbow")
	elseif rarity~="Normal" then burst(cutPos,0,9,.4,K.OUTLINE[rarity])
	else burst(cutPos,0,6,.35,col) end
	-- 4) le haut de la touffe bascule et tombe, puis file dans le sac
	local hrp0=picker and picker.Character and picker.Character:FindFirstChild("HumanoidRootPart")
	local away=hrp0 and Vector3.new(P.Position.X-hrp0.Position.X,0,P.Position.Z-hrp0.Position.Z) or Vector3.zero
	if away.Magnitude<.1 then local a=math.random()*math.pi*2 away=Vector3.new(math.cos(a),0,math.sin(a)) end
	away=away.Unit
	local axis=Vector3.new(0,1,0):Cross(away).Unit
	local top=P*CFrame.new(0,cutH,0)
	fake:PivotTo(top)
	task.spawn(function()
		tween(.36,function(a)
			local e=a*a -- accélère comme une vraie chute
			fake:PivotTo(CFrame.new(top.Position+away*.4*e-Vector3.new(0,cutH*e,0))*CFrame.fromAxisAngle(axis,math.rad(84)*e)*top.Rotation)
		end)
		task.wait(.12)
		local p0=fake:GetPivot()
		tween(.32,function(a)
			local hrp=picker and picker.Character and picker.Character:FindFirstChild("HumanoidRootPart")
			local tgt=hrp and hrp.Position or p0.Position+Vector3.new(0,3,0)
			local e=a*a
			fake:PivotTo(CFrame.new(p0.Position:Lerp(tgt,e))*p0.Rotation)
			fake:ScaleTo(base*math.max(1-e,.05))
		end)
		fake:Destroy()
		arrived()
	end)
end

-- ===== pas de délai : l'herbe est coupée chez nous au moment où les lames se ferment =====
-- (sans attendre la réponse du serveur ; si le serveur refuse, la touffe revient)
local CLOSE_SCISSORS,CLOSE_SICKLE,CLOSE_TRIMMER=.08,.15,.2 -- secondes entre le clic et le moment où l'outil touche l'herbe
local scheduled,predicted={},{}
local function heldTool() local ch=lp.Character return ch and ch:FindFirstChildOfClass("Tool") end
local function pendingSize()
	local n=0
	for _,e in scheduled do n+=e.size or 1 end
	for _,v in predicted do n+=v.e.size or 1 end
	return n
end
requestCut=function(id)
	remotes.PickRequest:FireServer(id)
	local e=data[id] if not e then return end
	local tool=heldTool()
	local sickle=tool~=nil and not holdingRealScissors()
	local room=maxBag()-realBag()-pendingSize()
	if (e.size or 1)>room then return end -- sac plein : le serveur répondra
	local list={e} room-=(e.size or 1)
	-- touffes voisines coupées en même temps (faucille, Saisir) : les plus proches d'abord, comme le serveur
	local extra=(CFG.SCISSORS_EXTRA or 0)+(tool and tonumber(tool:GetAttribute("CoupeEnPlus")) or 0)
	if holdingRealScissors() then extra+=lp:GetAttribute("Upg_Saisir") or 0 end
	local pre=toolPrefix()
	if pre then extra+=(lp:GetAttribute("Upg_"..pre.."Coupe") or 0)*(tool and tonumber(tool:GetAttribute("CoupeParNiveau")) or 1) end
	if extra>0 then
		local radius=math.max(CFG.SCISSORS_RADIUS or 4,tool and tonumber(tool:GetAttribute("RayonCoupe")) or 0)
		local near={}
		for id2,e2 in data do
			if id2~=id and not scheduled[id2] and not predicted[id2] then
				local d=(e2.p-e.p).Magnitude
				if d<=radius then table.insert(near,{e2,d}) end
			end
		end
		table.sort(near,function(a,b) return a[2]<b[2] end)
		for _,n in near do
			if #list>extra then break end
			if (n[1].size or 1)<=room then table.insert(list,n[1]) room-=(n[1].size or 1) end
		end
	end
	for _,x in list do scheduled[x.id]=x end
	local closeDelay=CLOSE_SCISSORS
	if sickle then closeDelay=(toolPrefix()=="D") and CLOSE_TRIMMER or CLOSE_SICKLE end
	task.delay(closeDelay,function()
		for _,x in list do
			local st=scheduled[x.id] scheduled[x.id]=nil
			if st and data[x.id] then
				if st~="ok" then predicted[x.id]={e=x,t=os.clock()} end
				cutVisual(x.id,lp,x.size,x.r)
			end
		end
	end)
end
remotes:WaitForChild("Picked").OnClientEvent:Connect(function(id,picker,size,rarity)
	if picker==nil then -- test : zone vidée d'un coup, sans effets (pas de lag)
		data[id]=nil queued[id]=nil predicted[id]=nil scheduled[id]=nil
		if hovered==id then setHover(nil) end
		despawnVisual(id)
		return
	end
	if picker==lp then
		if predicted[id] then predicted[id]=nil return end -- déjà coupée chez nous
		if scheduled[id] then scheduled[id]="ok" return end -- elle sera coupée quand les lames se ferment
	else
		predicted[id]=nil
		if scheduled[id] then scheduled[id]=nil end
	end
	cutVisual(id,picker,size,rarity)
end)
-- le serveur n'a pas confirmé (trop loin, trop tôt...) : la touffe revient
task.spawn(function()
	while true do
		task.wait(.5)
		local now=os.clock()
		for id,v in predicted do
			if now-v.t>2.5 then
				predicted[id]=nil
				gone[id]=nil
				data[id]=v.e
				sync()
			end
		end
	end
end)

-- ===== pas assez de place =====
remotes:WaitForChild("BagFull").OnClientEvent:Connect(function(id,size,free)
	if free and free>0 then
		showToast("🎒 Il te faut "..tostring(size).." places (il t'en reste "..free..") : va au composteur ♻️")
	else
		showToast("🎒 Sac plein ! Va le vider au composteur ♻️")
	end
end)

-- ===== composteur : panneau "1 herbe = $" + vidage =====
-- Au-dessus du composteur : image d'herbe = pièce + prix d'une herbe.
-- Quand le sac n'est pas vide : 2e petit panneau "sac 12 → +$0.12" et une flèche qui rebondit.
local MPP=CFG.MONEY_PER_PLACE or 0
local HERB_IMAGE="rbxassetid://90182525256912"
local INK=Color3.fromRGB(26,22,28)
local WOOD_A,WOOD_B,WOOD_DARK=Color3.fromRGB(170,114,64),Color3.fromRGB(122,78,42),Color3.fromRGB(72,44,22)
local function money(v) if v>=1 and v==math.floor(v) then return "$"..v end return string.format("$%.2f",v) end
local function px(n) return math.floor(n*BB+.5) end
local function board(parent,h,y)
	local f=Instance.new("Frame") f.AnchorPoint=Vector2.new(.5,0) f.Position=UDim2.new(.5,0,0,px(y))
	f.Size=UDim2.fromOffset(0,px(h)) f.AutomaticSize=Enum.AutomaticSize.X f.BackgroundColor3=WHITE f.BorderSizePixel=0 f.Parent=parent
	corner(f,UDim.new(0,px(14)))
	local gr=Instance.new("UIGradient") gr.Rotation=90 gr.Parent=f -- reflet clair en haut, plus foncé en bas
	gr.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(206,150,94)),ColorSequenceKeypoint.new(.14,WOOD_A),ColorSequenceKeypoint.new(1,WOOD_B)})
	local st=stroke(f,px(4),WOOD_DARK,true)
	local pad=Instance.new("UIPadding") pad.PaddingLeft=UDim.new(0,px(9)) pad.PaddingRight=UDim.new(0,px(9)) pad.Parent=f
	local l=Instance.new("UIListLayout") l.FillDirection=Enum.FillDirection.Horizontal l.VerticalAlignment=Enum.VerticalAlignment.Center
	l.HorizontalAlignment=Enum.HorizontalAlignment.Center l.SortOrder=Enum.SortOrder.LayoutOrder l.Padding=UDim.new(0,px(6)) l.Parent=f
	-- 2 clous aux bouts (comme une planche clouée)
	for _,o in {0,99} do
		local n=Instance.new("Frame") n.Size=UDim2.fromOffset(px(7),px(7)) n.LayoutOrder=o
		n.BackgroundColor3=Color3.fromRGB(64,62,66) n.BorderSizePixel=0 n.Parent=f corner(n)
	end
	return f,st
end
local function word(parent,txt,size,order,color)
	local t=Instance.new("TextLabel") t.BackgroundTransparency=1 t.Font=Enum.Font.LuckiestGuy t.Text=txt t.TextSize=px(size)
	t.Size=UDim2.fromOffset(0,px(size+6)) t.AutomaticSize=Enum.AutomaticSize.X t.TextColor3=color or WHITE t.LayoutOrder=order t.Parent=parent
	local s=stroke(t,px(3.5),INK) s.LineJoinMode=Enum.LineJoinMode.Round
	return t
end
local function iconImg(parent,img,size,order)
	local i=Instance.new("ImageLabel") i.BackgroundTransparency=1 i.Image=img i.ScaleType=Enum.ScaleType.Fit
	i.Size=UDim2.fromOffset(px(size),px(size)) i.LayoutOrder=order i.Parent=parent
	return i
end
-- flèche (chevron) dessinée avec 2 barres
local function chevron(parent)
	local f=Instance.new("Frame") f.AnchorPoint=Vector2.new(.5,1) f.BackgroundTransparency=1 f.Size=UDim2.fromOffset(px(40),px(30)) f.Parent=parent
	for _,s in {-1,1} do
		local b=Instance.new("Frame") b.AnchorPoint=Vector2.new(.5,.5) b.Size=UDim2.fromOffset(px(28),px(10)) b.Rotation=45*-s
		b.Position=UDim2.new(.5,s*px(8.5),.5,0) b.BackgroundColor3=WHITE b.BorderSizePixel=0 b.Parent=f
		corner(b) stroke(b,px(3),INK,true)
	end
	return f
end

local hints={}
-- position du panneau : au-dessus du tas "Compost" (sinon au-dessus du modèle)
local function hintPos(c)
	local top=c:FindFirstChild("Compost",true)
	if top and top:IsA("BasePart") then return top.Position+Vector3.new(0,top.Size.Y/2+2.2,0) end
	local ok,cf,size=pcall(c.GetBoundingBox,c)
	if ok and cf and size.Magnitude>.1 then return cf.Position+Vector3.new(0,size.Y/2+.4,0) end
	return nil
end
local function makeHint(c)
	-- le panneau est accroché à un point invisible (marche même si le modèle charge en retard)
	local at=Instance.new("Attachment") at.Name="CompostHintPoint" at.Parent=workspace.Terrain
	local g=Instance.new("BillboardGui") g.Name="CompostHint" g.Adornee=at
	-- taille fixe dans le monde (en studs) : comme un vrai panneau, il ne grossit pas quand on s'éloigne
	g.Size=UDim2.fromScale(9,4.9) g.SizeOffset=Vector2.new(0,.5) -- le bas du panneau (la flèche) pointe sur le composteur
	g.AlwaysOnTop=true g.MaxDistance=120 g.LightInfluence=0 g.ResetOnSpawn=false g.Enabled=false
	local root=Instance.new("Frame") root.BackgroundTransparency=1 root.AnchorPoint=Vector2.new(.5,.5) root.Position=UDim2.fromScale(.5,.5)
	root.Size=UDim2.fromOffset(px(360),px(196)) root.Parent=g
	local rs=Instance.new("UIScale") rs.Parent=root
	-- panneau principal : [herbe] = [pièce] $0.01
	local main=board(root,72,0)
	iconImg(main,HERB_IMAGE,66,1)
	word(main,"=",40,2)
	iconImg(main,COIN,50,3)
	local val=word(main,MPP>0 and money(MPP) or "+1",42,4)
	local vg=Instance.new("UIGradient") vg.Rotation=90 vg.Color=ColorSequence.new(WHITE,Color3.fromRGB(255,228,140)) vg.Parent=val
	-- ce que contient ton sac : [sac] 12 → +$0.12
	local gain,gst=board(root,50,84)
	local gScale=Instance.new("UIScale") gScale.Parent=gain
	iconImg(gain,BAG_IMAGE,36,1)
	local nTx=word(gain,"0",28,2)
	word(gain,"→",28,3)
	local gTx=word(gain,"+$0",28,4,GOLD)
	local arrow=chevron(root) arrow.Position=UDim2.new(.5,0,1,0)
	g.Parent=pgui
	table.insert(hints,{c=c,at=at,g=g,rs=rs,gain=gain,gst=gst,gScale=gScale,nTx=nTx,gTx=gTx,arrow=arrow})
	print("[Herbe] Panneau du composteur créé :",c:GetFullName())
end
local function addHint(c)
	if not c:IsA("Model") then return end
	for _,h in hints do if h.c==c then return end end
	local ok,err=pcall(makeHint,c)
	if not ok then warn("[Herbe] Panneau du composteur : erreur ->",err) end
end
-- le serveur marque les composteurs (tag) ; on les cherche aussi nous-mêmes par leur nom
for _,c in CS:GetTagged("GrassCompost") do addHint(c) end
CS:GetInstanceAddedSignal("GrassCompost"):Connect(addHint)
local COMPOST_NAME=CFG.COMPOST_NAME or "Composteur"
for _,d in workspace:GetDescendants() do if d.Name==COMPOST_NAME then addHint(d) end end
workspace.DescendantAdded:Connect(function(d) if d.Name==COMPOST_NAME then addHint(d) end end)
task.delay(20,function() if #hints==0 then warn("[Herbe] Aucun composteur trouvé : le modèle doit s'appeler '"..COMPOST_NAME.."' dans Workspace") end end)

local hintAcc=0
Run.RenderStepped:Connect(function(dt)
	hintAcc+=dt
	local slow=hintAcc>=.2 if slow then hintAcc=0 end
	local t=os.clock()
	local m=maxBag()
	local isFull=shown>=m
	local hasBag=shown>0 and not depositing
	local hide=lp:GetAttribute("IntroEnCours")==true
	for _,h in hints do
		if slow then
			local pos=h.c.Parent and hintPos(h.c)
			if pos then h.at.WorldPosition=pos end
			h.g.Enabled=not hide and pos~=nil
			h.gain.Visible=hasBag h.arrow.Visible=hasBag
			if hasBag then
				h.nTx.Text=tostring(shown)
				h.gTx.Text=MPP>0 and "+"..money(shown*MPP) or "+"..shown.." 🌿"
				h.gst.Color=isFull and GOLD or WOOD_DARK
				h.nTx.TextColor3=isFull and GOLD or WHITE
			end
		end
		if h.g.Enabled then h.rs.Scale=h.g.AbsoluteSize.X/px(360) end
		-- animations seulement si le panneau est proche (pas de calcul pour rien)
		if hasBag and h.g.Enabled and (cam.CFrame.Position-h.at.WorldPosition).Magnitude<125 then
			h.arrow.Position=UDim2.new(.5,0,1,-px(math.abs(math.sin(t*4.5))*9))
			h.gScale.Scale=isFull and 1+.06*math.abs(math.sin(t*5)) or 1
		end
	end
end)

local function compostTarget(c)
	local s=c:FindFirstChild("Compost",true)
	if s and s:IsA("BasePart") then return s.Position+Vector3.new(0,s.Size.Y/2+.9,0) end
	local cf,size=c:GetBoundingBox()
	return cf.Position+Vector3.new(0,size.Y*.15,0)
end

remotes:WaitForChild("Deposited").OnClientEvent:Connect(function(plr,c,n,gain)
	local mine=plr==lp
	if not c or not c.Parent then if mine then depositing=false sync() end return end
	local target=compostTarget(c)
	local ch=plr.Character
	local hrp=ch and ch:FindFirstChild("HumanoidRootPart")
	local k=math.clamp(n,1,6)
	if mine then depositing=true shown=math.max(shown,n) task.spawn(armAnim,{{.1,2.5},{.14,.9},{.2,0}}) end
	local remaining=n
	for i=1,k do
		local dec=(i==k) and remaining or math.floor(n/k)
		remaining-=dec
		task.delay((i-1)*.1,function()
			local from=(hrp and hrp.Parent) and (hrp.CFrame*CFrame.new(.9,1.3,-.8)).Position or target+Vector3.new(0,6,0)
			local m=K.Build(CFrame.new(from),.38,math.random(1,1000000),true)
			m.Parent=fx
			local base=m:GetScale()
			local mid=(from+target)/2+Vector3.new(0,math.max(0,target.Y-from.Y)+3.5,0)
			local sp=math.random()*6.28
			tween(.5,function(a)
				m:PivotTo(CFrame.new(bez(from,mid,target,a))*CFrame.Angles(a*5,sp+a*7,a*2))
				if a>.75 then m:ScaleTo(base*math.max((1-a)/.25,.05)) end
			end)
			m:Destroy()
			burst(target,1,4,.55)
			if mine then shown=math.max(0,shown-dec) refresh() end
			if i==k then
				burst(target,4,8,1.1) puffs(target-Vector3.new(0,.5,0))
				sound(CFG.DEPOSIT_SOUND,target,.7)
				if mine then
					if gain and gain>0 then popupAt(target+Vector3.new(0,2.5,0),"+"..fmt(gain).."$",GOLD)
					else popupAt(target+Vector3.new(0,2.5,0),"+"..n.." 🌿",GREEN) end
					depositing=false sync()
				end
			end
		end)
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX75"><Properties><string name="Name">CiseauxVue</string><ProtectedString name="Source"><![CDATA[-- CiseauxVue (LocalScript dans StarterPlayer > StarterPlayerScripts)
-- Vue à la 1re personne : l'outil en main (ciseaux, faucille ou débroussailleuse) suit la caméra (en bas à droite de l'écran),
-- se balance quand on tourne ou marche, les ciseaux font "clic-clac" et la faucille donne un coup à chaque coupe.
-- Vue de loin : on voit les ciseaux dans la main du personnage, comme les autres joueurs.
if not game:GetService("RunService"):IsClient() then
	warn("[Ciseaux] CiseauxVue doit être un LocalScript dans StarterPlayer > StarterPlayerScripts !")
	return
end
print("[Ciseaux] CiseauxVue démarré")

local REGLAGES = {
	POSITION = Vector3.new(1.05, -0.7, -2.9), -- place de la vis par rapport à la caméra (droite, bas, devant)
	DIRECTION = Vector3.new(-0.42, 0.7, -0.58), -- vers où pointent les lames (gauche, haut, devant)
	FACE = Vector3.new(0.2, 0.3, 1), -- le côté plat des ciseaux regarde vers la caméra
	BALANCEMENT = 1, -- 0 = les ciseaux ne bougent pas quand on tourne / marche
	FAUCILLE = {
		POSITION = Vector3.new(0.75, -1.3, -2.7), -- place du poing par rapport à la caméra (droite, bas, devant)
		MANCHE = Vector3.new(0.2, 0.85, -0.35), -- vers où pointe le manche (droite, haut, devant)
		FACE = Vector3.new(-0.15, 0, 1), -- le plat de la lame : (-0.15, 0, 1) = croissant vers la droite, (0.15, 0, -1) = vers la gauche
	},
	DEBROUSSAILLEUSE = {
		POSITION = Vector3.new(1.2, -1.25, -0.3), -- place de la poignée arrière par rapport à la caméra
		TUBE = Vector3.new(-0.27, -0.1, -0.96), -- vers où pointe le tube (gauche, bas, devant)
	},
}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local joueur = Players.LocalPlayer
local camera = workspace.CurrentCamera

local SON_CISEAUX = "rbxassetid://9114794521" -- bruit des ciseaux (clic-clac)
local FERMETURE = math.rad(11)
local DUREE_COUPE = 0.32
local DUREE_SORTIE = 0.25

-- Repère des ciseaux devant la caméra
local axeLames = REGLAGES.DIRECTION.Unit
local axeFace = (REGLAGES.FACE - axeLames * axeLames:Dot(REGLAGES.FACE)).Unit
local REPERE = CFrame.fromMatrix(REGLAGES.POSITION, axeLames, axeFace, axeLames:Cross(axeFace))
-- Repère de la faucille : X = plat de la lame, Y = le manche (comme dans FaucilleServer)
local RF = REGLAGES.FAUCILLE
local axeManche = RF.MANCHE.Unit
local axePlat = (RF.FACE - axeManche * axeManche:Dot(RF.FACE)).Unit
local REPERE_FAUCILLE = CFrame.fromMatrix(RF.POSITION, axePlat, axeManche, axePlat:Cross(axeManche))
local DUREE_COUP_FAUCILLE = 0.42
-- Repère de la débroussailleuse : X = le tube, Y = le haut (comme dans DebroussailleuseServer)
local RD = REGLAGES.DEBROUSSAILLEUSE
local axeTube = RD.TUBE.Unit
local axeHaut = (Vector3.yAxis - axeTube * axeTube:Dot(Vector3.yAxis)).Unit
local REPERE_DEBROU = CFrame.fromMatrix(RD.POSITION, axeTube, axeHaut, axeTube:Cross(axeHaut))
local DUREE_COUP_DEBROU = 0.5

local function estCiseaux(objet)
	return objet:IsA("Tool") and (CollectionService:HasTag(objet, "OutilCiseaux") or objet.Name == "Ciseaux")
end
local function estFaucille(objet)
	return objet:IsA("Tool") and (CollectionService:HasTag(objet, "OutilFaucille") or objet.Name == "Faucille")
end
local function estDebrou(objet)
	return objet:IsA("Tool") and (CollectionService:HasTag(objet, "OutilDebroussailleuse") or objet.Name == "Debroussailleuse")
end
local function estOutilVue(objet) return estCiseaux(objet) or estFaucille(objet) or estDebrou(objet) end

---------------------------------------------------------------- État

local outil = nil -- les ciseaux tenus en main
local vue = nil -- copie locale affichée devant la caméra
local vueHandle, vueDecalage, vueMoteurs = nil, nil, {}
local faucille = false -- l'outil en main est la faucille (ou la débroussailleuse : pas de clic-clac)
local debrou = false -- l'outil en main est la débroussailleuse
local vueTrainee = nil
local outilCache = false
local debutCoupe, debutClac, debutSortie = -math.huge, -math.huge, -math.huge
local balancement = CFrame.identity
local derniereRotation = camera.CFrame.Rotation
local pas, amplitudePas = 0, 0

local function cacherOutil(cacher)
	if not outil or outilCache == cacher then return end
	outilCache = cacher
	for _, p in outil:GetDescendants() do
		if p:IsA("BasePart") then p.LocalTransparencyModifier = if cacher then 1 else 0 end
	end
end

local function detruireVue()
	if vue then vue:Destroy() end
	vue, vueHandle, vueDecalage, vueMoteurs, vueTrainee = nil, nil, nil, {}, nil
end

local function creerVue()
	detruireVue()
	local copie = outil:Clone()
	local modele = Instance.new("Model")
	modele.Name = "CiseauxVue"
	for _, enfant in copie:GetChildren() do enfant.Parent = modele end
	copie:Destroy()
	vueHandle = modele:FindFirstChild("Handle")
	-- point de repère : la vis des ciseaux, ou le poing (Handle) de la faucille
	local fente = if faucille then vueHandle else modele:FindFirstChild("Fente", true)
	if vueHandle and faucille then
		-- la tête de la débroussailleuse reste sur son moteur (BoutiqueClient la fait tourner)
		for _, d in modele:GetDescendants() do
			if d:IsA("Motor6D") and d.Name == "TeteMoteur" then d.Transform = CFrame.identity end
		end
	end
	if not vueHandle or not fente then modele:Destroy() return end
	vueTrainee = modele:FindFirstChild("Trainee", true)
	for _, d in modele:GetDescendants() do
		if d:IsA("BasePart") then
			d.CastShadow = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.LocalTransparencyModifier = 0
		elseif d:IsA("Motor6D") and d:GetAttribute("C0Origine") then
			d.C0 = d:GetAttribute("C0Origine")
			table.insert(vueMoteurs, d)
		end
	end
	vueHandle.Anchored = true
	vueDecalage = fente.CFrame:ToObjectSpace(vueHandle.CFrame) -- poignée par rapport à la vis
	vue = modele
	vue.Parent = camera
	debutSortie = os.clock()
end

local son = Instance.new("Sound")
son.Name = "BruitCiseaux"
son.SoundId = SON_CISEAUX
son.Parent = game:GetService("SoundService")
local function bruitCiseaux(volume)
	son.Volume = volume
	son.PlaybackSpeed = 0.95 + math.random() * 0.1
	son.TimePosition = 0
	son:Play()
end


-- délai entre 2 coupes (le même que pour couper une herbe, réduit par la Dextérité)
local okCfg, CFG_HERBE = pcall(function() return require(game:GetService("ReplicatedStorage"):WaitForChild("GrassConfig", 10)) end)
if not okCfg or type(CFG_HERBE) ~= "table" then CFG_HERBE = {} end
local function delaiCoupe(qui)
	local nom = if debrou then "Upg_DRapidite" elseif faucille then "Upg_FRapidite" else "Upg_Dexterite"
	local dex = qui and qui:GetAttribute(nom) or 0 -- faucille / débroussailleuse : Rapidité, ciseaux : Dextérité
	return math.max(0.2, (CFG_HERBE.PICK_COOLDOWN or 0.9) * (1 - (CFG_HERBE.DEX_PAR_NIVEAU or 0.08) * dex))
end
local function coupe()
	local maintenant = os.clock()
	-- pas de spam : on attend que le délai pour couper une herbe soit passé
	if maintenant - debutCoupe < math.max(DUREE_COUPE * 0.8, delaiCoupe(joueur) * 0.85) then return end
	debutCoupe, debutClac = maintenant, maintenant
	if not faucille then bruitCiseaux(0.7) end -- la faucille a son propre "swoosh" (FaucilleServer)
	-- débroussailleuse : le moteur accélère tout de suite chez nous (BoutiqueClient)
	if debrou and outil then outil:SetAttribute("CoupeLocale", maintenant) end
end

---------------------------------------------------------------- Ciseaux en main ou pas

local branches = setmetatable({}, { __mode = "k" })
local function surOutil(nouvel)
	if outil == nouvel then return end
	cacherOutil(false)
	detruireVue()
	outil, outilCache = nouvel, false
	debrou = outil ~= nil and estDebrou(outil)
	faucille = outil ~= nil and (estFaucille(outil) or debrou)
	if outil then
		debutClac = os.clock()
		if not faucille then bruitCiseaux(0.4) end -- petit clic-clac quand on sort les ciseaux
		if not branches[outil] then
			branches[outil] = true
			outil.Activated:Connect(function()
				if outil == nouvel then coupe() end
			end)
		end
	end
end

local function surPersonnage(perso)
	surOutil(nil)
	for _, enfant in perso:GetChildren() do
		if estOutilVue(enfant) then surOutil(enfant) end
	end
	perso.ChildAdded:Connect(function(enfant)
		if estOutilVue(enfant) then surOutil(enfant) end
	end)
	perso.ChildRemoved:Connect(function(enfant)
		if enfant == outil then surOutil(nil) end
	end)
end

if joueur.Character then surPersonnage(joueur.Character) end
joueur.CharacterAdded:Connect(surPersonnage)

-- Chaque touffe coupée par nous (aussi en restant appuyé) fait un coup de ciseaux
task.spawn(function()
	local remotes = ReplicatedStorage:WaitForChild("GrassRemotes", 30)
	local picked = remotes and remotes:WaitForChild("Picked", 30)
	if picked then
		picked.OnClientEvent:Connect(function(_, qui)
			if qui == joueur and outil then coupe() end
		end)
	end
end)

---------------------------------------------------------------- Chaque image

local function adoucir(a) return 1 - (1 - a) ^ 2 end

RunService:BindToRenderStep("CiseauxVue", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local perso = joueur.Character
	local tete = perso and perso:FindFirstChild("Head")
	local humain = perso and perso:FindFirstChildOfClass("Humanoid")
	local premierePersonne = tete ~= nil and (camera.CFrame.Position - tete.Position).Magnitude < 1.5

	if not (outil and outil.Parent == perso and premierePersonne and humain and humain.Health > 0) then
		cacherOutil(false)
		detruireVue()
		derniereRotation = camera.CFrame.Rotation
		return
	end
	if not vue then creerVue() end
	if not vue then return end
	cacherOutil(true)

	local maintenant = os.clock()
	local force = REGLAGES.BALANCEMENT

	-- balancement : les ciseaux traînent un peu derrière la caméra quand on tourne
	local rotation = camera.CFrame.Rotation
	local rx, ry = derniereRotation:ToObjectSpace(rotation):ToEulerAnglesYXZ()
	derniereRotation = rotation
	local cible = CFrame.Angles(math.clamp(-rx * 3, -0.15, 0.15) * force, math.clamp(-ry * 3, -0.2, 0.2) * force, 0)
	balancement = balancement:Lerp(cible, math.min(dt * 12, 1))

	-- petit mouvement de marche
	local marche = humain.MoveDirection.Magnitude > 0.1 and humain.FloorMaterial ~= Enum.Material.Air
	amplitudePas += ((if marche then 1 else 0) - amplitudePas) * math.min(dt * 8, 1)
	pas += dt * humain.WalkSpeed * 0.55
	local balade = CFrame.new(math.sin(pas) * 0.05 * amplitudePas * force, -math.abs(math.cos(pas)) * 0.06 * amplitudePas * force, 0)

	-- sortie des ciseaux : ils montent du bas de l'écran
	local s = 1 - adoucir(math.clamp((maintenant - debutSortie) / DUREE_SORTIE, 0, 1))
	-- coup de ciseaux : on plonge vers l'herbe puis on revient
	local c = math.clamp((maintenant - debutCoupe) / DUREE_COUPE, 0, 1)
	local k = if c < 1 then math.sin(c * math.pi) else 0
	local decalage = Vector3.new(-0.15 * k, -1.2 * s - 0.25 * k, -0.3 * k)
	local inclinaison = CFrame.Angles(-0.5 * s - 0.45 * k, 0, 0.12 * k) -- tourne autour de la vis

	if debrou then
		-- débroussailleuse : on arme à droite, on fauche en arc vers la gauche (tête au ras de l'herbe), on revient
		local d = math.clamp((maintenant - debutCoupe) / DUREE_COUP_DEBROU, 0, 1)
		local lacet, plonge = 0, 0
		if d < 1 then
			if d < 0.22 then
				local a = adoucir(d / 0.22)
				lacet, plonge = -0.38 * a, 0.2 * a
			elseif d < 0.72 then
				local a = (d - 0.22) / 0.5
				a = a * a * (3 - 2 * a) -- régulier au milieu du coup
				lacet, plonge = -0.38 + 0.8 * a, 0.2 + 0.8 * math.sin(a * math.pi)
			else
				local a = adoucir((d - 0.72) / 0.28)
				lacet, plonge = 0.42 * (1 - a), 0.2 * (1 - a)
			end
		end
		-- vibrations du moteur : légères au ralenti, fortes pendant la coupe
		local vib = (if d < 1 then 0.03 else 0.008) * force
		local tremble = Vector3.new((math.random() - 0.5) * vib, (math.random() - 0.5) * vib, (math.random() - 0.5) * vib)
		local poing = camera.CFrame * balade * balancement
			* CFrame.new(REPERE_DEBROU.Position + tremble + Vector3.new(0.12 * lacet, -1.2 * s - 0.18 * plonge, -0.1 * plonge))
			* CFrame.Angles(-0.5 * s - 0.1 * plonge, lacet, -0.12 * lacet) * REPERE_DEBROU.Rotation
		vueHandle.CFrame = poing * vueDecalage
		return
	end
	if faucille then
		-- coup de faucille : on arme vers la droite, on balaie vers le bas à gauche, puis on revient
		local d = math.clamp((maintenant - debutCoupe) / DUREE_COUP_FAUCILLE, 0, 1)
		local pos, rot = Vector3.zero, Vector3.zero -- rot = (tangage, lacet, roulis)
		local ARME_P, ARME_R = Vector3.new(0.35, 0.25, 0.1), Vector3.new(0.25, -0.35, -0.35)
		local FRAPPE_P, FRAPPE_R = Vector3.new(-1.45, -0.55, -0.35), Vector3.new(-0.55, 0.55, 0.95)
		if d < 1 then
			if d < 0.22 then
				local a = adoucir(d / 0.22)
				pos, rot = ARME_P * a, ARME_R * a
			elseif d < 0.5 then
				local a = ((d - 0.22) / 0.28) ^ 1.6 -- de plus en plus vite
				pos, rot = ARME_P:Lerp(FRAPPE_P, a), ARME_R:Lerp(FRAPPE_R, a)
			else
				local a = adoucir((d - 0.5) / 0.5)
				pos, rot = FRAPPE_P:Lerp(Vector3.zero, a), FRAPPE_R:Lerp(Vector3.zero, a)
			end
		end
		if vueTrainee then vueTrainee.Enabled = d > 0.2 and d < 0.55 end
		local poing = camera.CFrame * balade * balancement
			* CFrame.new(REPERE_FAUCILLE.Position + pos + Vector3.new(0, -1.2 * s, 0))
			* CFrame.Angles(rot.X - 0.5 * s, rot.Y, rot.Z) * REPERE_FAUCILLE.Rotation
		vueHandle.CFrame = poing * vueDecalage
		return
	end
	local fente = camera.CFrame * balade * balancement * CFrame.new(REPERE.Position + decalage) * inclinaison * REPERE.Rotation
	vueHandle.CFrame = fente * vueDecalage

	-- lames : deux "clic-clac" pendant la coupe et quand on sort les ciseaux
	local t = (maintenant - debutClac) / DUREE_COUPE
	local fermeture = if t >= 0 and t < 1 then (1 - math.cos(t * 4 * math.pi)) / 2 else 0
	for _, moteur in vueMoteurs do
		moteur.C0 = moteur:GetAttribute("C0Origine") * CFrame.Angles(0, FERMETURE * fermeture * moteur:GetAttribute("Sens"), 0)
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX76"><Properties><string name="Name">InventoryUI</string><ProtectedString name="Source"><![CDATA[-- InventoryUI (LocalScript dans StarterGui)
-- Menu des améliorations des outils : bouton BOOSTS (ou touche TAB) -> panneau au centre.
if not game:GetService("RunService"):IsClient() then
	warn("[Améliorations] InventoryUI doit être un LocalScript dans StarterGui !")
	return
end

local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local TS=game:GetService("TweenService")
local UIS=game:GetService("UserInputService")
local Lighting=game:GetService("Lighting")
local StarterGui=game:GetService("StarterGui")
local GuiService=game:GetService("GuiService")
local player=Players.LocalPlayer
local cam=workspace.CurrentCamera

-- plateformes : téléphone / tablette (pas de clavier) et manette (PlayStation / Xbox)
local TOUCH=UIS.TouchEnabled and not UIS.KeyboardEnabled
local PADS={[Enum.UserInputType.Gamepad1]=true,[Enum.UserInputType.Gamepad2]=true,[Enum.UserInputType.Gamepad3]=true,[Enum.UserInputType.Gamepad4]=true}
local function usingGamepad() return PADS[UIS:GetLastInputType()]==true end

-- ================= À COMPLÉTER =================
local BAG_ICON="rbxassetid://113918337226531"
local TAB_ICON="rbxassetid://91367185656178"
local COIN_ICON="rbxassetid://103593634628600"      -- image de la pièce (vide = pièce dessinée)
local CLICK_SOUND="rbxassetid://129348077985519"
local MONEY_STAT=""     -- nom de ta monnaie dans leaderstats ("" = auto : Money, Cash, Argent...)
-- Outils et leurs améliorations. Le niveau est l'attribut du joueur "Upg_<id>".
-- Le prix et le niveau max viennent de GrassServer (UPGRADES) ; ceux d'ici servent si le serveur ne répond pas.
local OUTILS={
	{name="Ciseaux",icon="rbxassetid://98821470151953",color=Color3.fromRGB(255,120,110),items={
		{id="Maintenir",name="Maintenir",icon="rbxassetid://71762308286130",price=1.10,max=1,
			desc="Reste appuyé sur le clic pour couper en continu là où tu vises."},
		{id="Dexterite",name="Dextérité",icon="rbxassetid://78716197209384",price=0.60,max=5,
			desc="Tes ciseaux coupent un peu plus vite : -8 % d'attente par niveau."},
		{id="Saisir",name="Saisir",icon="rbxassetid://120921144181867",price=0.85,max=2,
			desc="Chaque coup coupe aussi une touffe voisine de plus par niveau."},
	}},
	-- requires = il faut posséder l'outil (attribut du joueur) pour acheter ses améliorations
	{name="Faucille",icon="rbxassetid://138905055767473",color=Color3.fromRGB(120,190,255),requires="Faucille",items={
		{id="FMaintenir",name="Maintenir",icon="rbxassetid://71762308286130",price=3.50,max=1,
			desc="Reste appuyé sur le clic pour faucher en continu."},
		{id="FRapidite",name="Rapidité",icon="rbxassetid://78716197209384",price=2.00,max=5,
			desc="Ta faucille frappe plus vite : -8 % d'attente par niveau."},
		{id="FCoupe",name="Coupe supplémentaire",icon="rbxassetid://120921144181867",price=3.00,max=2,
			desc="+1 touffe par coup de faucille : 3, puis 4, puis 5 touffes."},
	}},
	{name="Débroussailleuse",icon="",color=Color3.fromRGB(150,220,110),requires="Debroussailleuse",items={
		{id="DMaintenir",name="Maintenir",icon="rbxassetid://71762308286130",price=8.00,max=1,
			desc="Reste appuyé sur le clic pour faucher en continu."},
		{id="DRapidite",name="Rapidité",icon="rbxassetid://78716197209384",price=5.00,max=5,
			desc="Ta débroussailleuse fauche plus vite : -8 % d'attente par niveau."},
		{id="DCoupe",name="Coupe supplémentaire",icon="rbxassetid://120921144181867",price=8.00,max=2,
			desc="+2 touffes par coup : 6, puis 8, puis 10 touffes."},
	}},
}
-- ===============================================

local INK=Color3.fromRGB(20,30,22)
local WHITE=Color3.new(1,1,1)
local CREAM=Color3.fromRGB(252,249,240)
local CREAM2=Color3.fromRGB(236,230,212)
local GRAY_TEXT=Color3.fromRGB(104,98,86)
local EMPTY_PIP=Color3.fromRGB(222,214,196)

local function new(cls,props,parent)
	local o=Instance.new(cls)
	for k,v in props do o[k]=v end
	if parent then o.Parent=parent end
	return o
end
local function corner(p,r) return new("UICorner",{CornerRadius=r or UDim.new(0,14)},p) end
local function stroke(p,th,col,tr,text)
	local s=new("UIStroke",{Thickness=th,Color=col or INK,Transparency=tr or 0,LineJoinMode=Enum.LineJoinMode.Round})
	if not text then s.ApplyStrokeMode=Enum.ApplyStrokeMode.Border end
	s.Parent=p return s
end
local function seq(colors)
	local k={} for i,c in ipairs(colors) do k[i]=ColorSequenceKeypoint.new((i-1)/(#colors-1),c) end
	return ColorSequence.new(k)
end
local function gradient(p,colors,rot)
	p.BackgroundColor3=WHITE
	return new("UIGradient",{Rotation=rot or 90,Color=seq(colors)},p)
end
local function lbl(parent,t,pos,size,o)
	o=o or {}
	local l=new("TextLabel",{BackgroundTransparency=1,Text=t,Font=o.font or Enum.Font.FredokaOne,TextScaled=true,
		TextWrapped=o.wrap or false,Position=pos,Size=size,TextColor3=o.color or INK,
		TextXAlignment=o.align or Enum.TextXAlignment.Left,TextTransparency=o.transp or 0,
		AnchorPoint=o.anchor or Vector2.zero,ZIndex=o.z or 3},parent)
	if o.stroke then stroke(l,o.stroke,o.strokeColor or INK,0,true) end
	if o.grad then l.TextColor3=WHITE new("UIGradient",{Rotation=90,Color=seq(o.grad)},l) end
	if l.Font==Enum.Font.LuckiestGuy then new("UIPadding",{PaddingTop=UDim.new(.1,0)},l) end
	return l
end
local function lighter(c,a) return c:Lerp(WHITE,a or .45) end

local gui=new("ScreenGui",{Name="InventoryUI",ResetOnSpawn=false,IgnoreGuiInset=true,ZIndexBehavior=Enum.ZIndexBehavior.Sibling,DisplayOrder=10},player:WaitForChild("PlayerGui"))
local clickSound=new("Sound",{SoundId=CLICK_SOUND,Volume=1},gui)
local function playClick() clickSound.TimePosition=0 clickSound:Play() end

-- cadenas dessiné
local function padlock(parent,z)
	local dark=Color3.fromRGB(34,40,36)
	local sh=new("Frame",{AnchorPoint=Vector2.new(.5,0),Position=UDim2.fromScale(.5,.16),Size=UDim2.fromScale(.4,.46),BackgroundTransparency=1,ZIndex=z},parent)
	corner(sh,UDim.new(1,0)) stroke(sh,4,dark)
	local body=new("Frame",{AnchorPoint=Vector2.new(.5,1),Position=UDim2.fromScale(.5,.84),Size=UDim2.fromScale(.6,.42),BackgroundColor3=dark,ZIndex=z+1},parent)
	corner(body,UDim.new(.22,0))
	local hole=new("Frame",{AnchorPoint=Vector2.new(.5,.5),Position=UDim2.fromScale(.5,.5),Size=UDim2.fromScale(.16,.38),BackgroundColor3=Color3.fromRGB(120,230,130),ZIndex=z+2},body)
	corner(hole,UDim.new(1,0))
end

-- ================= PRIX / NIVEAUX / ARGENT =================
local buyRemote=RS:FindFirstChild("BuyUpgrade")
local moneyValue
local function money() return moneyValue and tonumber(moneyValue.Value) or 0 end
local function level(it) return player:GetAttribute("Upg_"..it.id) or 0 end
-- prix du prochain niveau : envoyé par GrassServer pour chaque niveau (sinon prix de base × Growth^niveau)
local function price(it)
	local exact=buyRemote and buyRemote:GetAttribute("Price_"..it.id.."_"..(level(it)+1))
	if exact then return exact end
	local base=(buyRemote and buyRemote:GetAttribute("Price_"..it.id)) or it.price
	local growth=(buyRemote and buyRemote:GetAttribute("Growth")) or 1.5
	return math.floor(base*growth^level(it)*100+.5)/100
end
local function owned(outil) return not outil.requires or player:GetAttribute(outil.requires)==true end
local function maxLevel(it) return (buyRemote and buyRemote:GetAttribute("Max_"..it.id)) or it.max end
local function fmt(v) return string.format("%.2f$",v) end

